---
import "../styles/global.css";
import { navLinks } from "../data/nav";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "TNPSC Combined Civil Services Examination II — Group II & IIA syllabus and exam scheme, unit by unit." } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · TNPSC Group II / IIA Syllabus</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2214%22 fill=%22%231b4b43%22/><text x=%2250%22 y=%2266%22 font-size=%2254%22 text-anchor=%22middle%22 fill=%22%23f3e6cd%22 font-family=%22Georgia,serif%22>த</text></svg>" />
  </head>
  <body>
    <div class="shell">
      <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
      <header class="topbar">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">த</span>
          <span class="brand-text">
            <strong>TNPSC Group II / IIA</strong>
            <span>Syllabus &amp; Exam Scheme</span>
          </span>
        </a>
        <label for="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </label>
      </header>

      <nav class="sidebar" aria-label="Section navigation">
        <div class="sidebar-inner">
          <p class="eyebrow side-eyebrow">Combined Civil Services Exam &mdash; II</p>
          <ul>
            {navLinks.map((link) => (
              <li>
                <a href={link.href} class={path === link.href ? "active" : ""}>
                  <span class="link-en">{link.label}</span>
                  <span class="link-ta">{link.tamil}</span>
                  {link.meta && <span class="link-meta">{link.meta}</span>}
                </a>
              </li>
            ))}
          </ul>
          <div class="sidebar-foot">
            <p>Source: TNPSC official notifications &amp; syllabi (Codes 495 &middot; 583 &middot; 469).</p>
            <p>Verify against <a href="https://www.tnpsc.gov.in" target="_blank" rel="noopener">tnpsc.gov.in</a> before exam day.</p>
          </div>
        </div>
      </nav>

      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 268px 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "topbar topbar"
      "sidebar content";
    min-height: 100vh;
  }

  .topbar {
    grid-area: topbar;
    display: none;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    padding: 22px 24px 18px;
  }
  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--gold-soft);
    font-family: var(--font-tamil);
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.25; }
  .brand-text strong { font-family: var(--font-display); font-size: 0.98rem; font-weight: 600; }
  .brand-text span:last-child { font-size: 0.74rem; color: var(--ink-faint); }

  .sidebar {
    grid-area: sidebar;
    border-right: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  .sidebar-inner { display: flex; flex-direction: column; height: 100%; }
  .side-eyebrow { padding: 24px 24px 10px; }

  .sidebar ul { list-style: none; margin: 0; padding: 0 12px; flex: 1; }
  .sidebar li + li { margin-top: 2px; }
  .sidebar a {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
    color: var(--ink-soft);
    padding: 10px 12px;
    border-radius: var(--radius);
    border-left: 2px solid transparent;
  }
  .sidebar a:hover { background: var(--accent-soft); color: var(--ink); }
  .sidebar a.active {
    background: var(--accent-soft);
    color: var(--accent);
    border-left-color: var(--gold);
  }
  .link-en { font-weight: 600; font-size: 0.9rem; }
  .link-ta { font-family: var(--font-tamil); font-size: 0.78rem; color: var(--ink-faint); }
  a.active .link-ta { color: var(--accent-dim); }
  .link-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--gold);
    letter-spacing: 0.06em;
  }

  .sidebar-foot {
    padding: 16px 24px 24px;
    border-top: 1px solid var(--line);
    font-size: 0.74rem;
    color: var(--ink-faint);
    line-height: 1.5;
  }
  .sidebar-foot a { color: var(--accent-dim); text-decoration: underline; }
  .sidebar-foot p + p { margin-top: 6px; }

  .content { grid-area: content; min-width: 0; padding: 48px 0 96px; }

  .nav-toggle-input { display: none; }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    cursor: pointer;
  }
  .nav-toggle span { width: 20px; height: 2px; background: var(--ink); display: block; }

  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
      grid-template-areas:
        "topbar"
        "content";
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .brand { padding: 12px 16px; }
    .nav-toggle { display: flex; }
    .sidebar {
      position: fixed;
      inset: 60px 0 0 0;
      height: calc(100vh - 60px);
      width: 100%;
      transform: translateX(-100%);
      transition: transform 0.22s ease;
      z-index: 19;
    }
    .nav-toggle-input:checked ~ .sidebar { transform: translateX(0); }
    .content { padding: 28px 0 72px; }
  }
</style>
