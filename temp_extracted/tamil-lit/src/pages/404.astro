---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found">
<section class="not-found">
  <div class="nf-bg">
    <svg class="nf-mandala" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g transform="translate(250,250)">
        <circle r="240" fill="none" stroke="rgba(201,152,58,0.04)" stroke-width="1"/>
        <circle r="190" fill="none" stroke="rgba(201,152,58,0.06)" stroke-width="0.5"/>
        <circle r="140" fill="none" stroke="rgba(201,152,58,0.08)" stroke-width="1"/>
        <circle r="90"  fill="none" stroke="rgba(201,152,58,0.1)"  stroke-width="0.5"/>
        <circle r="40"  fill="none" stroke="rgba(201,152,58,0.12)" stroke-width="1"/>
        {[0,45,90,135,180,225,270,315].map(a => (
          <line x1="0" y1="45" x2="0" y2="235"
            stroke="rgba(201,152,58,0.05)"
            stroke-width="0.5"
            transform={`rotate(${a})`}
          />
        ))}
        <circle r="6" fill="rgba(201,152,58,0.25)"/>
      </g>
    </svg>
  </div>

  <div class="nf-content">
    <p class="nf-code">404</p>
    <div class="nf-poem">
      <p class="nf-tamil">கற்றதனால் ஆய பயனென்கொல்</p>
      <p class="nf-translation">What is the use of all learning...</p>
    </div>
    <h1 class="nf-title">This page wandered into the wasteland</h1>
    <p class="nf-body">
      Like a poem lost from its anthology, this page cannot be found.<br/>
      The paalai tinai — the landscape of separation and wandering — claims it.
    </p>
    <div class="nf-actions">
      <a href="/" class="btn btn--primary">Return Home</a>
      <a href="/sangam" class="btn btn--ghost">Begin with Sangam</a>
    </div>
    <div class="nf-links">
      <a href="/sangam">Sangam Era</a>
      <a href="/epics">The Epics</a>
      <a href="/poets">The Poets</a>
      <a href="/kurals">Thirukkural</a>
    </div>
  </div>
</section>
</Layout>

<style>
.not-found {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 6rem 2rem;
}

.nf-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 70% at 50% 50%, rgba(92,15,15,0.2) 0%, transparent 70%);
}

.nf-mandala {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 70vmin; height: 70vmin;
  animation: rotate-slow 90s linear infinite;
  pointer-events: none;
  opacity: 0.7;
}

.nf-content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 640px;
}

.nf-code {
  font-family: var(--font-display);
  font-size: clamp(5rem, 18vw, 10rem);
  font-weight: 300;
  color: rgba(201,152,58,0.12);
  line-height: 1;
  margin-bottom: 0;
  letter-spacing: -0.05em;
  animation: fadeIn 1s ease both;
}

.nf-poem {
  margin-bottom: 2rem;
  animation: fadeUp 0.8s var(--ease-out) 0.1s both;
}

.nf-tamil {
  font-family: var(--font-tamil);
  font-size: 1.2rem;
  color: var(--gold-light);
  margin-bottom: 0.25rem;
}

.nf-translation {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--text-faint);
}

.nf-title {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 4vw, 2.5rem);
  font-weight: 400;
  color: var(--parchment);
  margin-bottom: 1rem;
  animation: fadeUp 0.8s var(--ease-out) 0.2s both;
}

.nf-body {
  font-family: var(--font-body);
  font-style: italic;
  font-size: 1rem;
  color: var(--text-muted);
  line-height: 1.75;
  margin-bottom: 2.5rem;
  animation: fadeUp 0.8s var(--ease-out) 0.3s both;
}

.nf-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 3rem;
  animation: fadeUp 0.8s var(--ease-out) 0.4s both;
}

.nf-links {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
  animation: fadeUp 0.8s var(--ease-out) 0.5s both;
}

.nf-links a {
  font-family: var(--font-display);
  font-size: 0.9rem;
  letter-spacing: 0.08em;
  color: var(--text-faint);
  text-decoration: none;
  transition: color 0.25s;
}

.nf-links a:hover { color: var(--gold); }
</style>
