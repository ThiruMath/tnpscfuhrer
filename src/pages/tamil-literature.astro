---
import Layout from '../layouts/Layout.astro';
import { poets } from '../data/poets.js';
import { works } from '../data/works.js';
---

<Layout title="Tamil Literature" active="Tamil Literature" description="Explore over 2,000 years of Tamil literary heritage.">

  <!-- ─── Page Header ─── -->
  <div class="mb-4">
    <h1 class="mb-1">Tamil Literature <span class="text-muted" style="font-family: var(--font-tamil); font-weight: normal; margin-left: 0.5rem;">தமிழ் இலக்கியம்</span></h1>
    <p class="text-muted" style="max-width: 800px;">The oldest classical literature tradition still spoken today — from Sangam love poems to Thirukkural's timeless wisdom.</p>
  </div>

  <!-- ─── Dashboard Stats Grid ─── -->
  <div class="grid grid-4 mb-4">
    <div class="stat-card" style="border-top: 4px solid var(--accent);">
      <div class="stat-label">Heritage</div>
      <div class="stat-value text-mono" style="color: var(--accent);">2,000+</div>
      <div class="stat-footer">Years of Literature</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Thirukkural</div>
      <div class="stat-value text-mono">1,330</div>
      <div class="stat-footer">Couplets</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Sangam Poems</div>
      <div class="stat-value text-mono">473</div>
      <div class="stat-footer">Preserved</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Epics</div>
      <div class="stat-value text-mono">5</div>
      <div class="stat-footer">Great epics</div>
    </div>
  </div>

  <!-- ─── Kural Spotlight (Solid Accent Card) ─── -->
  <div class="card card-solid mb-4" style="position: relative; overflow: hidden; padding: 3rem;">
    <!-- Decorative background -->
    <div style="position: absolute; right: -50px; bottom: -50px; opacity: 0.1; font-size: 15rem; font-family: var(--font-tamil); line-height: 1;">அ</div>
    
    <div style="position: relative; z-index: 1; max-width: 800px;">
      <div style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; opacity: 0.9;">The Universal Wisdom</div>
      <p style="font-family: var(--font-tamil); font-size: 1.5rem; line-height: 1.8; margin-bottom: 1rem;">
        அகர முதல எழுத்தெல்லாம் ஆதி<br/>பகவன் முதற்றே உலகு.
      </p>
      <p style="font-size: 1.1rem; font-style: italic; margin-bottom: 1.5rem; opacity: 0.9;">
        "As 'A' is the first of all letters,<br/>so is the Eternal the first in the world."
      </p>
      <div style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 2rem;">— Kural 1, Thiruvalluvar</div>
      <a href="/kurals" class="btn btn-outline" style="background: white; color: var(--accent); border: none;">Read All 1,330 Kurals ↗</a>
    </div>
  </div>

  <!-- ─── The Living Script ─── -->
  <div class="mb-4">
    <h2 class="mb-2">The Living Script</h2>
    <div class="grid grid-4">
      {[
        { tamil: 'அ', roman: 'a', meaning: 'The First Letter' },
        { tamil: 'அகம்', roman: 'akam', meaning: 'Interior / Love' },
        { tamil: 'புறம்', roman: 'puram', meaning: 'Exterior / War' },
        { tamil: 'கவிதை', roman: 'kavithai', meaning: 'Poetry' },
        { tamil: 'இலக்கியம்', roman: 'ilakkiyam', meaning: 'Literature' },
        { tamil: 'அன்பு', roman: 'anbu', meaning: 'Love' },
        { tamil: 'வாழ்க்கை', roman: 'vāḻkkai', meaning: 'Life' },
        { tamil: 'ஒளி', roman: 'oḷi', meaning: 'Light' },
      ].map(item => (
        <div class="card" style="text-align: center; padding: 1.5rem;">
          <div style="font-family: var(--font-tamil); font-size: 2.5rem; color: var(--accent); margin-bottom: 0.5rem; line-height: 1;">{item.tamil}</div>
          <div style="font-family: var(--font-display); font-weight: 500; font-size: 0.9rem; margin-bottom: 0.25rem;">{item.roman}</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);">{item.meaning}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- ─── Eras & Timeline ─── -->
  <div class="grid grid-2 mb-6">
    <div class="stack">
      <h2 class="mb-2">Through the Ages</h2>
      <div class="card">
        <div class="lit-timeline">
          {[
            {
              era: '300 BCE – 300 CE',
              name: 'Sangam Age',
              tamil: 'சங்க காலம்',
              desc: 'The golden age of Tamil poetry. Love, war, and nature described in vivid, emotional verse by hundreds of named poets.',
              href: '/sangam',
              works: ['Akananuru', 'Purananuru', 'Natrinai', 'Kurunthokai'],
            },
            {
              era: '200 CE – 600 CE',
              name: 'Post-Sangam Period',
              tamil: 'பிற்சங்க காலம்',
              desc: 'The era of great epics and didactic literature. Thirukkural, Silappadikaram, and Manimekalai emerge as eternal masterpieces.',
              href: '/epics',
              works: ['Thirukkural', 'Silappadikaram', 'Manimekalai'],
            },
            {
              era: '600 CE – 900 CE',
              name: 'Bhakti Era',
              tamil: 'பக்தி காலம்',
              desc: 'Nayanmars and Alvars compose devotional hymns of extraordinary beauty. The Thevarams and Divya Prabandhams still ring in temples.',
              href: '/bhakti',
              works: ['Thiruvasagam', 'Thiruppavai'],
            },
            {
              era: '900 CE – 1200 CE',
              name: 'Medieval Period',
              tamil: 'இடைக்கால காலம்',
              desc: 'The Chola empire patronises literature. Kamban\'s Ramavataram reimagines the Ramayana in a distinctly Tamil voice.',
              href: '/poets',
              works: ['Kambaramayanam', 'Periyapuranam'],
            },
          ].map((era, i) => (
            <div class="lit-timeline-item">
              <div class="lit-timeline-marker"></div>
              <div class="lit-timeline-content">
                <div class="lit-era-label">{era.era}</div>
                <h3 style="margin-bottom: 0.25rem;">{era.name} <span class="text-muted" style="font-family: var(--font-tamil); font-size: 0.9rem; margin-left: 0.5rem; font-weight:normal;">{era.tamil}</span></h3>
                <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 1rem;">{era.desc}</p>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
                  {era.works.map(w => (
                    <span class="badge" style="background: var(--surface-raised); border: 1px solid var(--border); color: var(--text-secondary);">{w}</span>
                  ))}
                </div>
                <a href={era.href} class="text-accent" style="font-size: 0.85rem; font-weight: 600; text-decoration: none;">Explore this era ↗</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="stack">
      <h2 class="mb-2">The Great Poets</h2>
      <div class="grid grid-2">
        {[
          { name: 'Thiruvalluvar', tamil: 'திருவள்ளுவர்', period: '~300 BCE', known: 'Thirukkural', slug: 'thiruvalluvar' },
          { name: 'Ilango Adigal', tamil: 'இளங்கோ அடிகள்', period: '~2nd century CE', known: 'Silappadikaram', slug: 'ilango-adigal' },
          { name: 'Avvaiyar', tamil: 'ஔவையார்', period: 'Sangam era', known: 'Wisdom poems', slug: 'avvaiyar-sangam' },
          { name: 'Kambar', tamil: 'கம்பர்', period: '12th century CE', known: 'Kambaramayanam', slug: 'kambar' },
          { name: 'Manikkavadocar', tamil: 'மாணிக்கவாசகர்', period: '9th century CE', known: 'Thiruvasagam', slug: 'manikkavacakar' },
          { name: 'Nammalvar', tamil: 'நம்மாழ்வார்', period: '9th century CE', known: 'Thiruvaymoli', slug: 'nammalvar' },
        ].map(poet => (
          <a href={`/poets/${poet.slug}`} class="card card-interactive" style="display: flex; flex-direction: column; text-decoration: none;">
            <div style="margin-bottom: 0.5rem;">
              <h3 style="font-size: 1.1rem;">{poet.name}</h3>
              <div style="font-family: var(--font-tamil); font-size: 0.9rem; color: var(--accent);">{poet.tamil}</div>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">{poet.period}</div>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border);">{poet.known}</div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── Interactive Directory ─── -->
  <div class="mb-4">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
      <h2>Classical Tamil Library Portal</h2>
      
      <div class="portal-tabs flex gap-2">
        <button class="btn btn-accent active" id="tab-works" data-target="works">
          Major Works <span class="badge badge-neutral" style="margin-left: 0.5rem;">{works.length}</span>
        </button>
        <button class="btn btn-outline" id="tab-poets" data-target="poets">
          Famous Authors <span class="badge badge-neutral" style="margin-left: 0.5rem;">{poets.length}</span>
        </button>
      </div>
    </div>
    
    <div class="search-wrap mb-3">
      <input type="text" id="lit-search" placeholder="Search by name, author, period, key themes..." class="form-input" style="width: 100%; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface); font-family: var(--font-sans);" />
    </div>

    <!-- Works Grid -->
    <div class="grid grid-3 portal-grid active" id="grid-works">
      {works.map((work) => (
        <div class="card portal-card card-interactive" data-search={`${work.title} ${work.tamil} ${work.author} ${work.era_label} ${work.overview} ${work.form}`.toLowerCase()}>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <div>
              <h3 style="font-size: 1.2rem;">{work.title}</h3>
              <div style="font-family: var(--font-tamil); font-size: 0.9rem; color: var(--accent);">{work.tamil}</div>
            </div>
            <span class="badge badge-accent">{work.era_label}</span>
          </div>
          
          <div style="display: flex; gap: 0.75rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem;">
            <span>✍ {work.author}</span>
            <span>•</span>
            <span>{work.verses}</span>
          </div>
          
          <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            {work.overview.slice(0, 120)}...
          </p>
          
          <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border);">
            <a href={`/works/${work.slug}`} class="text-accent" style="font-size: 0.85rem; font-weight: 600;">Read Full Study ↗</a>
          </div>
        </div>
      ))}
    </div>

    <!-- Poets Grid -->
    <div class="grid grid-3 portal-grid" id="grid-poets">
      {poets.map((poet) => (
        <div class="card portal-card card-interactive" data-search={`${poet.name} ${poet.tamil} ${poet.known_for} ${poet.era_label} ${poet.identity} ${poet.religion}`.toLowerCase()}>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <div>
              <h3 style="font-size: 1.2rem;">{poet.name}</h3>
              <div style="font-family: var(--font-tamil); font-size: 0.9rem; color: var(--accent);">{poet.tamil}</div>
            </div>
            <span class="badge badge-accent">{poet.era_label}</span>
          </div>
          
          <div style="display: flex; gap: 0.75rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem;">
            <span>📅 {poet.dates}</span>
            <span>•</span>
            <span>{poet.religion.split('—')[0].trim()}</span>
          </div>
          
          <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            {poet.identity.slice(0, 120)}...
          </p>
          
          <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border);">
            <a href={`/poets/${poet.slug}`} class="text-accent" style="font-size: 0.85rem; font-weight: 600;">Read Scholar Profile ↗</a>
          </div>
        </div>
      ))}
    </div>
  </div>

</Layout>

<script>
  const searchInput = document.getElementById('lit-search') as HTMLInputElement;
  const tabWorksBtn = document.getElementById('tab-works');
  const tabPoetsBtn = document.getElementById('tab-poets');
  const gridWorks = document.getElementById('grid-works');
  const gridPoets = document.getElementById('grid-poets');

  let activeTab = 'works';

  function switchTab(tab: string) {
    activeTab = tab;
    if (tab === 'works') {
      tabWorksBtn?.classList.add('active');
      tabWorksBtn?.classList.add('btn-accent');
      tabWorksBtn?.classList.remove('btn-outline');
      
      tabPoetsBtn?.classList.remove('active');
      tabPoetsBtn?.classList.remove('btn-accent');
      tabPoetsBtn?.classList.add('btn-outline');
      
      gridWorks?.classList.add('active');
      gridPoets?.classList.remove('active');
    } else {
      tabWorksBtn?.classList.remove('active');
      tabWorksBtn?.classList.remove('btn-accent');
      tabWorksBtn?.classList.add('btn-outline');
      
      tabPoetsBtn?.classList.add('active');
      tabPoetsBtn?.classList.add('btn-accent');
      tabPoetsBtn?.classList.remove('btn-outline');
      
      gridWorks?.classList.remove('active');
      gridPoets?.classList.add('active');
    }
    filterItems();
  }

  function filterItems() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    const activeGrid = activeTab === 'works' ? gridWorks : gridPoets;
    const inactiveGrid = activeTab === 'works' ? gridPoets : gridWorks;

    if (inactiveGrid) {
      inactiveGrid.querySelectorAll('.portal-card').forEach(card => {
        (card as HTMLElement).style.display = 'none';
      });
    }

    if (activeGrid) {
      activeGrid.querySelectorAll('.portal-card').forEach(card => {
        const searchText = (card as HTMLElement).dataset.search || '';
        if (query === '' || searchText.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }
  }

  // Initialize tabs correctly based on active class
  if (tabWorksBtn && tabPoetsBtn) {
    tabWorksBtn.classList.add('btn-accent');
    tabWorksBtn.classList.remove('btn-outline');
  }

  tabWorksBtn?.addEventListener('click', () => switchTab('works'));
  tabPoetsBtn?.addEventListener('click', () => switchTab('poets'));
  searchInput?.addEventListener('input', filterItems);
</script>

<style>
  /* ─── Custom Timeline Styles ─── */
  .lit-timeline {
    position: relative;
    padding-left: 2rem;
  }
  .lit-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }
  .lit-timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }
  .lit-timeline-item:last-child {
    margin-bottom: 0;
  }
  .lit-timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0.25rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-6px);
    border: 3px solid var(--surface);
  }
  .lit-era-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  /* ─── Portal Grid ─── */
  .portal-grid {
    display: none;
  }
  .portal-grid.active {
    display: grid;
  }
  .portal-card {
    transition: all var(--duration-normal) var(--ease-out);
  }
  .portal-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
</style>
