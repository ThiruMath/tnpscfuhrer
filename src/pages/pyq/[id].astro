---
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  return [
    { params: { id: 'tnpsc-2026-GRP2A' } },
    { params: { id: 'tnpsc-2025-GRP4' } }
  ];
}

const { id } = Astro.params;

let quizMeta = { exam: "TNPSC Group", year: 2026, paper_code: "", total_questions: 0 };
let questions: any[] = [];

try {
  // Use absolute path to correctly read during build and dev
  const filePath = path.join(process.cwd(), 'public', 'data', 'pyq', `${id}.json`);
  const rawData = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  quizMeta = rawData.meta;
  questions = rawData.questions;
} catch (e) {
  console.error(e);
}

const topicCounts: Record<string, number> = {};
for (const q of questions) {
  topicCounts[q.topic] = (topicCounts[q.topic] || 0) + 1;
}
---

<Layout title={`${quizMeta.exam} PYQ Quiz | TNPSC Fuhrer`} description={`Practice ${quizMeta.exam} questions with instant feedback.`} active="PYQ Quiz">

  <script define:vars={{ questions, quizMeta }}>
    window.__QUIZ_DATA__ = questions;
    window.__QUIZ_META__ = quizMeta;
  </script>

  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <div class="pyq-wrap">

    <!-- ── START SCREEN ──────────────────────────────────────────────────── -->
    <div id="start-screen" class="screen active">
      <div class="start-hero">
        <div class="start-hero-bg"></div>
        <div class="start-hero-content">
          <div class="start-icon-ring">
            <span class="start-icon-emoji">📋</span>
          </div>
          <h1 class="start-title">{quizMeta.exam}</h1>
          <p class="start-year-badge">{quizMeta.year}</p>
          <p class="start-sub">{quizMeta.paper_code} — Previous Year Questions</p>
        </div>
      </div>

      <div class="start-card">
        <div class="start-stats">
          <div class="sstat">
            <span class="sstat-icon">📝</span>
            <span class="sval" id="s-total">{questions.length}</span>
            <span class="slab">Questions</span>
          </div>
          <div class="sstat">
            <span class="sstat-icon">⏱️</span>
            <span class="sval">150</span>
            <span class="slab">Minutes</span>
          </div>
          <div class="sstat">
            <span class="sstat-icon">📅</span>
            <span class="sval">{quizMeta.year}</span>
            <span class="slab">Year</span>
          </div>
        </div>

        <!-- Topic chips -->
        <div class="topic-section">
          <p class="topic-label">📚 Topics covered</p>
          <div class="topic-chips">
            {Object.entries(topicCounts).sort((a,b)=>b[1]-a[1]).map(([t,c])=>(
              <span class="tchip">{t} <strong>{c}</strong></span>
            ))}
          </div>
        </div>

        <!-- Filters -->
        <div class="filters">
          <div class="fgroup">
            <label for="filter-topic">🏷️ Topic</label>
            <select id="filter-topic">
              <option value="all">All Topics</option>
              {Object.keys(topicCounts).sort().map(t=>(<option value={t}>{t}</option>))}
            </select>
          </div>
          <div class="fgroup">
            <label for="filter-part">📄 Part</label>
            <select id="filter-part">
              <option value="all">Both Parts</option>
              <option value="A">Part A (Q 1–100)</option>
              <option value="B">Part B (Q 101–200)</option>
            </select>
          </div>
        </div>

        <button id="start-btn" class="start-btn">
          <span class="start-btn-text">Start Quiz</span>
          <span class="start-btn-arrow">→</span>
        </button>
        <p class="disclaimer">⚠️ Answers extracted via OCR — some may be unavailable. For practice only.</p>
      </div>
    </div>

    <!-- ── QUIZ SCREEN ───────────────────────────────────────────────────── -->
    <div id="quiz-screen" class="screen">

      <!-- Sticky Top bar -->
      <div class="quiz-topbar">
        <span class="quiz-title" id="quiz-title">{quizMeta.exam} {quizMeta.year}</span>
        <div class="topbar-right">
          <button class="dark-toggle" id="dark-toggle" title="Toggle dark mode">🌙</button>
          <span class="score-badge wrong" id="badge-wrong"><span class="bicon">✕</span><span id="count-wrong">0</span></span>
          <span class="score-badge correct" id="badge-correct"><span class="bicon">✓</span><span id="count-correct">0</span></span>
        </div>
      </div>

      <!-- Quiz Subbar for Flashcard & Bookmark filters -->
      <div class="quiz-subbar">
        <div class="subbar-left">
          <label class="fc-toggle-label">
            <input type="checkbox" id="fc-toggle" />
            <span class="fc-toggle-slider"></span>
            <span class="fc-toggle-text">⚡ Flashcard Mode</span>
          </label>
        </div>
        <div class="subbar-right">
          <button class="subbar-btn" id="filter-flagged-btn" title="Practice bookmarked questions">
            ⭐ Bookmarked (<span id="flagged-count">0</span>)
          </button>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="progress-track">
        <div class="progress-header">
          <span id="progress-text">Question 1 of 0</span>
          <div class="progress-bar-container">
            <div id="progress-bar"></div>
          </div>
        </div>
        <div class="progress-dashes" id="progress-dashes"></div>
      </div>

      <!-- Question card — 2-panel layout -->
      <div class="question-card" id="question-card">
        
        <div class="q-col-question">
          <div class="q-meta-row">
            <span class="q-part" id="q-part">Part A</span>
            <span class="q-topic" id="q-topic">History</span>
            <button class="flag-btn" id="flag-btn" title="Bookmark Question">
              <span class="flag-star">☆</span> <span class="flag-label">Bookmark</span>
            </button>
            <span class="q-timer" id="q-timer">150:00</span>
          </div>
          <h2 class="q-text" id="q-text">Loading…</h2>
        </div>

        <div class="q-col-options">
          <div class="options-list" id="options-list"></div>
        </div>

        <div class="q-col-reason" id="q-reason-col" style="display: none;">
          <div class="reason-header">
            <span class="reason-icon">💡</span>
            <h3 class="reason-title">Explanation</h3>
          </div>
          <div id="reason-content" class="reason-content"></div>
        </div>

      </div>

      <!-- Bottom nav -->
      <div class="quiz-nav">
        <button class="nav-back" id="prev-btn">← Back</button>
        <div class="nav-center">
          <button class="skip-btn" id="mark-btn">Skip →</button>
        </div>
        <button class="nav-next" id="next-btn">Next →</button>
      </div>

    </div>

    <!-- ── RESULTS SCREEN ────────────────────────────────────────────────── -->
    <div id="results-screen" class="screen">
      <canvas id="confetti-canvas"></canvas>
      <div class="results-card">
        <div class="score-circle-wrap">
          <svg class="score-svg" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="52" fill="none" stroke="#e5e7eb" stroke-width="10"/>
            <circle id="score-arc" cx="60" cy="60" r="52" fill="none" stroke="#1a73e8" stroke-width="10"
              stroke-dasharray="327" stroke-dashoffset="327" stroke-linecap="round"
              transform="rotate(-90 60 60)"/>
          </svg>
          <div class="score-inner-text">
            <span class="score-big" id="r-pct">0%</span>
          </div>
        </div>

        <h2 class="r-title">Quiz Complete!</h2>
        <p class="r-sub" id="r-sub">Here's your result</p>

        <div class="r-stats">
          <div class="rstat correct"><span class="rval" id="r-correct">0</span><span class="rlab">Correct</span></div>
          <div class="rstat wrong"><span class="rval" id="r-wrong">0</span><span class="rlab">Wrong</span></div>
          <div class="rstat skipped"><span class="rval" id="r-skipped">0</span><span class="rlab">Skipped</span></div>
          <div class="rstat disputed"><span class="rval" id="r-disputed">0</span><span class="rlab">No Key</span></div>
        </div>

        <!-- Topic-wise breakdown -->
        <div class="topic-breakdown" id="topic-breakdown"></div>

        <!-- Review tabs -->
        <div class="rtabs">
          <button class="rtab active" data-filter="all">All</button>
          <button class="rtab" data-filter="wrong">Wrong</button>
          <button class="rtab" data-filter="correct">Correct</button>
          <button class="rtab" data-filter="skipped">Skipped</button>
        </div>

        <div class="review-list" id="review-list"></div>

        <div class="r-actions">
          <button id="retake-btn" class="nav-next">Retake</button>
          <button id="home-btn" class="nav-back">Home</button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  // ─── State ──────────────────────────────────────────────────────────────────
  let allQ: any[] = (window as any).__QUIZ_DATA__ || [];
  let qs: any[] = [];
  let selected: Record<number, number> = {};
  let answered: Record<number, boolean> = {}; // whether we've locked in
  let cur = 0;
  let correctCount = 0, wrongCount = 0;
  let timerSecs = 150 * 60;
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let reviewFilter = 'all';

  // Gamification & Revision Toggles
  let flaggedIds = new Set<string>();
  let flashcardMode = false;
  let filterFlaggedOnly = false;
  const examId = (window as any).__QUIZ_META__?.paper_code || 'quiz';

  const $ = (id: string) => document.getElementById(id)!;

  // ─── Bookmarking / Flagging Logic ───────────────────────────────────────────
  function loadFlagged() {
    flaggedIds.clear();
    const stored = localStorage.getItem('flagged-questions-' + examId);
    if (stored) {
      try {
        const arr = JSON.parse(stored);
        arr.forEach((id: string) => flaggedIds.add(id));
      } catch(e) {}
    }
    updateFlaggedUI();
  }

  function saveFlagged() {
    localStorage.setItem('flagged-questions-' + examId, JSON.stringify(Array.from(flaggedIds)));
    updateFlaggedUI();
  }

  function updateFlaggedUI() {
    const elCount = $('flagged-count');
    if (elCount) elCount.textContent = flaggedIds.size.toString();
    
    const q = qs[cur];
    const flagBtn = $('flag-btn');
    if (q && flagBtn) {
      const isFlagged = flaggedIds.has(q.id);
      const star = flagBtn.querySelector('.flag-star');
      if (star) star.textContent = isFlagged ? '★' : '☆';
      flagBtn.classList.toggle('active', isFlagged);
    }
  }

  // ─── Screen switch ───────────────────────────────────────────────────────────
  function show(id: string) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    $(id).classList.add('active');
  }

  // ─── Timer ──────────────────────────────────────────────────────────────────
  function fmtTime(s: number) {
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return `${m}:${sec.toString().padStart(2,'0')}`;
  }

  function startTimer() {
    timerInterval = setInterval(() => {
      timerSecs--;
      const el = $('q-timer');
      el.textContent = fmtTime(timerSecs);
      if (timerSecs <= 300) el.classList.add('urgent');
      if (timerSecs <= 0) { clearInterval(timerInterval!); submitQuiz(); }
    }, 1000);
  }

  // ─── Progress dashes ────────────────────────────────────────────────────────
  function buildDashes() {
    const container = $('progress-dashes');
    container.innerHTML = '';
    const total = qs.length;
    const dashCount = Math.min(total, 40);
    for (let i = 0; i < dashCount; i++) {
      const qIdx = Math.round((i / dashCount) * total);
      const d = document.createElement('div');
      d.className = 'pdash';
      d.dataset.qi = qIdx.toString();
      container.appendChild(d);
    }
    updateDashes();
  }

  function updateDashes() {
    const dashes = document.querySelectorAll('.pdash');
    const total = qs.length;
    const dashCount = dashes.length;
    dashes.forEach((d, i) => {
      const qIdx = Math.round((i / dashCount) * total);
      const q = qs[qIdx];
      d.className = 'pdash';
      if (qIdx === cur) d.classList.add('active');
      else if (answered[q?.id]) {
        const ua = selected[q.id];
        if (q.answer === -1) d.classList.add('disputed');
        else if (ua === q.answer) d.classList.add('correct');
        else d.classList.add('wrong');
      }
    });
    if (total > 0) {
      $('progress-text').textContent = `Question ${cur + 1} of ${total}`;
      $('progress-bar').style.width = `${((cur + 1) / total) * 100}%`;
    } else {
      $('progress-text').textContent = `No questions`;
      $('progress-bar').style.width = `0%`;
    }
  }

  // ─── Render Question ────────────────────────────────────────────────────────
  function renderQuestion() {
    const q = qs[cur];
    if (!q) return;

    $('q-part').textContent = `Part ${q.part}`;
    $('q-topic').textContent = q.topic;
    $('q-text').textContent = q.question;

    updateFlaggedUI();

    const ol = $('options-list');
    ol.innerHTML = '';
    const labels = ['A','B','C','D','E','F'];
    const isAnswered = answered[q.id];
    const userAns = selected[q.id];
    const correctAns = q.answer;

    if (flashcardMode) {
      if (!isAnswered) {
        ol.innerHTML = `
          <div class="flashcard-face-down">
            <p>🤔 Think of the answer. Ready to check?</p>
            <button class="flip-btn" id="flip-btn">Reveal Option & Explanation</button>
          </div>
        `;
        $('flip-btn').addEventListener('click', () => revealFlashcard(q));
      } else {
        const correctOptText = q.options[correctAns] || '';
        const wasCorrect = userAns === correctAns;
        ol.innerHTML = `
          <div class="flashcard-face-up">
            <div class="fc-correct-answer">
              <span class="fc-correct-label">Correct Option: ${labels[correctAns] || ''}</span>
              <p class="fc-correct-text">${correctOptText}</p>
            </div>
            <div class="fc-eval-status">
              <span>Self-Evaluation:</span>
              <span class="status-badge ${wasCorrect ? 'correct' : 'wrong'}">
                ${wasCorrect ? '✓ Mastered' : '✕ Needs Review'}
              </span>
            </div>
          </div>
        `;
      }
    } else {
      (q.options || []).forEach((opt: string, idx: number) => {
        const btn = document.createElement('button');
        btn.className = 'opt-btn';

        let state = '';
        if (isAnswered) {
          if (idx === correctAns) state = 'correct';
          else if (idx === userAns && correctAns !== -1) state = 'wrong';
          if (idx === userAns) btn.classList.add('user-pick');
        } else if (userAns === idx) {
          state = 'pending';
        }
        if (state) btn.classList.add(state);

        // Inner HTML
        let inner = `<span class="opt-lbl">${labels[idx] || ''}</span><span class="opt-txt">${opt}</span>`;
        if (isAnswered && idx === correctAns && correctAns !== -1) {
          inner += `<div class="opt-feedback correct-fb">
                      <span class="fb-check">✓</span><span class="fb-label">That's right!</span>
                    </div>`;
        } else if (isAnswered && idx === userAns && idx !== correctAns && correctAns !== -1) {
          inner += `<div class="opt-feedback wrong-fb">
                      <span class="fb-x">✕</span><span class="fb-label">Not quite</span>
                    </div>`;
        }

        btn.innerHTML = inner;
        if (!isAnswered && !answered[q.id]) {
          btn.addEventListener('click', () => selectOption(idx));
        } else {
          btn.disabled = true;
        }
        ol.appendChild(btn);
      });
    }

    const reasonCol = $('q-reason-col');
    const reasonContent = $('reason-content');

    if (isAnswered) {
      reasonCol.style.display = 'block';
      let html = '';
      if (q.answer === -1) {
         html += '<div class="disputed-note">⚠️ This question is before the Expert Committee — no official answer key available.</div>';
      }
      if (q.explanation) {
         html += `<div class="reason-text">${q.explanation.replace(/\\n/g, '<br/>')}</div>`;
      } else if (q.answer !== -1) {
         html += `<div class="reason-text">No additional explanation provided.</div>`;
      }
      reasonContent.innerHTML = html;
    } else {
      reasonCol.style.display = 'none';
      reasonContent.innerHTML = '';
    }

    // Prev/Next
    const prevBtn = $('prev-btn') as HTMLButtonElement;
    const nextBtn = $('next-btn') as HTMLButtonElement;
    prevBtn.disabled = cur === 0;
    
    nextBtn.textContent = cur === qs.length - 1 ? 'Submit' : 'Next →';
    nextBtn.classList.toggle('submit-mode', cur === qs.length - 1);

    updateDashes();
  }

  function revealFlashcard(q: any) {
    const ol = $('options-list');
    const correctAns = q.answer;
    const labels = ['A','B','C','D','E','F'];
    const correctOptText = q.options[correctAns] || 'No option';

    ol.innerHTML = `
      <div class="flashcard-face-up">
        <div class="fc-correct-answer">
          <span class="fc-correct-label">Correct Option: ${labels[correctAns] || ''}</span>
          <p class="fc-correct-text">${correctOptText}</p>
        </div>
        <div class="fc-self-eval">
          <p>Were you correct?</p>
          <div class="fc-eval-buttons">
            <button class="fc-eval-btn wrong" id="fc-needs-review">✕ Needs Review</button>
            <button class="fc-eval-btn correct" id="fc-mastered">✓ Mastered</button>
          </div>
        </div>
      </div>
    `;

    // Also reveal explanation column
    const reasonCol = $('q-reason-col');
    const reasonContent = $('reason-content');
    reasonCol.style.display = 'block';
    let html = '';
    if (q.answer === -1) {
       html += '<div class="disputed-note">⚠️ This question is before the Expert Committee — no official answer key available.</div>';
    }
    if (q.explanation) {
       html += `<div class="reason-text">${q.explanation.replace(/\\n/g, '<br/>')}</div>`;
    } else if (q.answer !== -1) {
       html += `<div class="reason-text">No additional explanation provided.</div>`;
    }
    reasonContent.innerHTML = html;

    $('fc-needs-review').addEventListener('click', () => {
      // Simulate wrong selection
      selectOption(correctAns === 0 ? 1 : 0);
    });
    $('fc-mastered').addEventListener('click', () => {
      // Simulate correct selection
      selectOption(correctAns);
    });
  }

  function selectOption(idx: number) {
    const q = qs[cur];
    if (answered[q.id]) return;

    selected[q.id] = idx;
    answered[q.id] = true;

    // Update scores
    if (q.answer !== -1) {
      if (idx === q.answer) {
        correctCount++;
        $('count-correct').textContent = correctCount.toString();
      } else {
        wrongCount++;
        $('count-wrong').textContent = wrongCount.toString();
      }
    }

    renderQuestion();
    // Auto-advance removed. User must click Next.
  }

  // ─── Results ─────────────────────────────────────────────────────────────────
  function submitQuiz() {
    if (timerInterval) clearInterval(timerInterval);

    let correct = 0, wrong = 0, skipped = 0, disputed = 0;
    const answerableQs = qs.filter(q => q.answer !== -1);

    for (const q of qs) {
      if (q.answer === -1) { disputed++; continue; }
      if (!answered[q.id]) { skipped++; continue; }
      if (selected[q.id] === q.answer) correct++;
      else wrong++;
    }

    const pct = answerableQs.length > 0 ? Math.round((correct / answerableQs.length) * 100) : 0;

    $('r-pct').textContent = `${pct}%`;
    $('r-correct').textContent = correct.toString();
    $('r-wrong').textContent = wrong.toString();
    $('r-skipped').textContent = skipped.toString();
    $('r-disputed').textContent = disputed.toString();
    $('r-sub').textContent = pct >= 80 ? '🌟 Excellent work!' : pct >= 60 ? '👍 Good job!' : pct >= 40 ? '📚 Keep studying!' : '💪 Don\'t give up!';

    const arc = $('score-arc');
    const circumference = 327;
    setTimeout(() => {
      arc.style.transition = 'stroke-dashoffset 1.2s ease';
      arc.setAttribute('stroke-dashoffset', (circumference - pct / 100 * circumference).toString());
      arc.style.stroke = pct >= 60 ? '#34a853' : pct >= 40 ? '#fbbc04' : '#ea4335';
    }, 300);

    // Build topic-wise breakdown
    buildTopicBreakdown(correct, wrong, skipped, disputed);

    // Confetti for scores >= 80%
    if (pct >= 80) {
      launchConfetti();
    }

    renderReview();
    show('results-screen');
  }

  function renderReview() {
    const container = $('review-list');
    container.innerHTML = '';
    const labels = ['A','B','C','D','E','F'];

    qs.forEach((q, i) => {
      const ua = selected[q.id];
      const ca = q.answer;
      const isDisputed = ca === -1;
      const isCorrect = !isDisputed && ua === ca;
      const isWrong = !isDisputed && ua !== undefined && ua !== ca;
      const isSkipped = !isDisputed && ua === undefined;

      if (reviewFilter === 'correct' && !isCorrect) return;
      if (reviewFilter === 'wrong' && !isWrong) return;
      if (reviewFilter === 'skipped' && !isSkipped) return;

      const card = document.createElement('div');
      card.className = `rcard ${isDisputed ? 'r-disputed' : isCorrect ? 'r-correct' : isWrong ? 'r-wrong' : 'r-skipped'}`;

      let optHTML = '';
      (q.options || []).forEach((opt: string, idx: number) => {
        let cls = 'ropt';
        if (!isDisputed && idx === ca) cls += ' ropt-correct';
        else if (idx === ua && ua !== ca) cls += ' ropt-wrong';
        else if (idx === ua) cls += ' ropt-pick';
        optHTML += `<div class="${cls}"><strong>${labels[idx]}.</strong> ${opt}${!isDisputed && idx === ca ? ' ✓' : ''}</div>`;
      });

      card.innerHTML = `
        <div class="rcard-header">
          <span class="rcard-num">Q${i+1}</span>
          <span class="rcard-topic">${q.topic}</span>
          <span class="rcard-status">${isDisputed ? '⚠️ No Key' : isCorrect ? '✓ Correct' : isWrong ? '✕ Wrong' : '— Skipped'}</span>
        </div>
        <p class="rcard-q">${q.question}</p>
        ${isDisputed ? '<p class="rdisputed-note">Expert Committee question — no official answer.</p>' : `<div class="rcard-opts">${optHTML}</div>`}
      `;
      container.appendChild(card);
    });

    if (!container.children.length) {
      container.innerHTML = '<p class="rempty">Nothing here.</p>';
    }
  }

  // ─── Start Quiz ──────────────────────────────────────────────────────────────
  function startQuiz() {
    const topic = ($('filter-topic') as HTMLSelectElement).value;
    const part = ($('filter-part') as HTMLSelectElement).value;

    qs = allQ.filter(q => {
      if (topic !== 'all' && q.topic !== topic) return false;
      if (part !== 'all' && q.part !== part) return false;
      return true;
    });

    if (!qs.length) { alert('No questions match your filter!'); return; }

    selected = {}; answered = {};
    correctCount = 0; wrongCount = 0;
    cur = 0; timerSecs = 150 * 60;
    $('count-correct').textContent = '0';
    $('count-wrong').textContent = '0';
    $('q-timer').textContent = '150:00';
    $('q-timer').classList.remove('urgent');

    buildDashes();
    renderQuestion();
    show('quiz-screen');
    startTimer();
  }

  // ─── Events ──────────────────────────────────────────────────────────────────
  $('start-btn').addEventListener('click', startQuiz);

  $('prev-btn').addEventListener('click', () => {
    if (cur > 0) { cur--; renderQuestion(); }
  });

  $('next-btn').addEventListener('click', () => {
    if (cur === qs.length - 1) {
      if (confirm('Submit the quiz?')) submitQuiz();
    } else {
      cur++;
      renderQuestion();
    }
  });

  $('mark-btn').addEventListener('click', () => {
    // Skip — mark as skipped and move on
    const q = qs[cur];
    if (!answered[q.id]) {
      answered[q.id] = true; // answered with no selection = skipped
    }
    if (cur < qs.length - 1) { cur++; renderQuestion(); }
  });

  $('retake-btn').addEventListener('click', () => show('start-screen'));
  $('home-btn').addEventListener('click', () => { window.location.href = '/'; });

  // Bookmark / Flag click event
  $('flag-btn').addEventListener('click', () => {
    const q = qs[cur];
    if (!q) return;
    if (flaggedIds.has(q.id)) {
      flaggedIds.delete(q.id);
    } else {
      flaggedIds.add(q.id);
    }
    saveFlagged();
  });

  // Flashcard Mode toggle change event
  $('fc-toggle').addEventListener('change', (e) => {
    flashcardMode = (e.target as HTMLInputElement).checked;
    renderQuestion();
  });

  // Filter bookmarked questions only toggle
  $('filter-flagged-btn').addEventListener('click', () => {
    filterFlaggedOnly = !filterFlaggedOnly;
    const btn = $('filter-flagged-btn');
    if (filterFlaggedOnly) {
      btn.classList.add('active');
      const flaggedQs = allQ.filter(q => flaggedIds.has(q.id));
      if (!flaggedQs.length) {
        alert('You have no bookmarked questions to practice!');
        filterFlaggedOnly = false;
        btn.classList.remove('active');
        return;
      }
      qs = flaggedQs;
    } else {
      btn.classList.remove('active');
      const topic = ($('filter-topic') as HTMLSelectElement).value;
      const part = ($('filter-part') as HTMLSelectElement).value;
      qs = allQ.filter(q => {
        if (topic !== 'all' && q.topic !== topic) return false;
        if (part !== 'all' && q.part !== part) return false;
        return true;
      });
    }
    cur = 0;
    selected = {}; answered = {};
    correctCount = 0; wrongCount = 0;
    $('count-correct').textContent = '0';
    $('count-wrong').textContent = '0';
    buildDashes();
    renderQuestion();
  });

  document.querySelectorAll('.rtab').forEach(tab => {
    tab.addEventListener('click', e => {
      document.querySelectorAll('.rtab').forEach(t => t.classList.remove('active'));
      (e.currentTarget as HTMLElement).classList.add('active');
      reviewFilter = (e.currentTarget as HTMLElement).dataset.filter || 'all';
      renderReview();
    });
  });

  // ─── Dark Mode Toggle ──────────────────────────────────────────────────────
  function initDarkMode() {
    const wrap = document.querySelector('.pyq-wrap');
    const toggle = $('dark-toggle');
    const stored = localStorage.getItem('pyq-dark-mode');
    if (stored === 'true') {
      wrap?.classList.add('dark');
      toggle.textContent = '☀️';
    }
    toggle.addEventListener('click', () => {
      const isDark = wrap?.classList.toggle('dark');
      toggle.textContent = isDark ? '☀️' : '🌙';
      localStorage.setItem('pyq-dark-mode', isDark ? 'true' : 'false');
    });
  }
  initDarkMode();
  loadFlagged();

  // ─── Confetti Animation ────────────────────────────────────────────────────
  function launchConfetti() {
    const canvas = document.getElementById('confetti-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.style.display = 'block';

    const pieces: any[] = [];
    const colors = ['#C1121F', '#1a73e8', '#34a853', '#fbbc04', '#ff6d00', '#aa00ff', '#00bcd4'];
    const total = 150;

    for (let i = 0; i < total; i++) {
      pieces.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        w: Math.random() * 10 + 5,
        h: Math.random() * 6 + 3,
        color: colors[Math.floor(Math.random() * colors.length)],
        vx: (Math.random() - 0.5) * 4,
        vy: Math.random() * 3 + 2,
        rot: Math.random() * 360,
        rotV: (Math.random() - 0.5) * 10,
        opacity: 1,
      });
    }

    let frame = 0;
    const maxFrames = 180;

    function animate() {
      if (frame > maxFrames) {
        canvas.style.display = 'none';
        return;
      }
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of pieces) {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.05;
        p.rot += p.rotV;
        if (frame > maxFrames - 60) {
          p.opacity = Math.max(0, p.opacity - 0.02);
        }
        ctx!.save();
        ctx!.translate(p.x, p.y);
        ctx!.rotate((p.rot * Math.PI) / 180);
        ctx!.globalAlpha = p.opacity;
        ctx!.fillStyle = p.color;
        ctx!.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
        ctx!.restore();
      }
      frame++;
      requestAnimationFrame(animate);
    }
    animate();
  }

  // ─── Topic-wise Breakdown ──────────────────────────────────────────────────
  function buildTopicBreakdown(totalCorrect: number, totalWrong: number, totalSkipped: number, totalDisputed: number) {
    const container = $('topic-breakdown');
    if (!container) return;

    const topicData: Record<string, { correct: number; wrong: number; skipped: number; disputed: number; total: number }> = {};

    for (const q of qs) {
      if (!topicData[q.topic]) {
        topicData[q.topic] = { correct: 0, wrong: 0, skipped: 0, disputed: 0, total: 0 };
      }
      topicData[q.topic].total++;
      if (q.answer === -1) { topicData[q.topic].disputed++; continue; }
      if (!answered[q.id]) { topicData[q.topic].skipped++; continue; }
      if (selected[q.id] === q.answer) topicData[q.topic].correct++;
      else topicData[q.topic].wrong++;
    }

    let html = '<h3 class="tb-title">📊 Topic-wise Performance</h3>';
    const sortedTopics = Object.entries(topicData).sort((a, b) => b[1].total - a[1].total);

    for (const [topic, data] of sortedTopics) {
      const pct = data.total > 0 ? Math.round((data.correct / (data.total - data.disputed)) * 100) || 0 : 0;
      const correctW = data.total > 0 ? (data.correct / data.total) * 100 : 0;
      const wrongW = data.total > 0 ? (data.wrong / data.total) * 100 : 0;
      const skippedW = data.total > 0 ? (data.skipped / data.total) * 100 : 0;
      const disputedW = data.total > 0 ? (data.disputed / data.total) * 100 : 0;

      // SVG stacked bar chart
      const svgBarChart = `
        <svg class="tb-svg-bar" width="100%" height="12" viewBox="0 0 100 12" preserveAspectRatio="none" style="display: block; border-radius: 6px; overflow: hidden; margin-top: 8px;">
          <rect x="0" y="0" width="100" height="12" fill="var(--border)" />
          <rect x="0" y="0" width="${correctW}" height="12" fill="#34a853" />
          <rect x="${correctW}" y="0" width="${wrongW}" height="12" fill="#ea4335" />
          <rect x="${correctW + wrongW}" y="0" width="${skippedW}" height="12" fill="#9aa0a6" />
          <rect x="${correctW + wrongW + skippedW}" y="0" width="${disputedW}" height="12" fill="#fbbc04" />
        </svg>
      `;

      html += `
        <div class="tb-row">
          <div class="tb-info">
            <span class="tb-topic">${topic}</span>
            <span class="tb-score">${data.correct}/${data.total - data.disputed} (${pct}%)</span>
          </div>
          <div class="tb-bar">
            <div class="tb-seg tb-correct" style="width:${correctW}%"></div>
            <div class="tb-seg tb-wrong" style="width:${wrongW}%"></div>
            <div class="tb-seg tb-skipped" style="width:${skippedW}%"></div>
            <div class="tb-seg tb-disputed" style="width:${disputedW}%"></div>
          </div>
        </div>
      `;
    }

    html += `
      <div class="tb-legend">
        <span class="tb-leg-item"><span class="tb-dot" style="background:#34a853"></span>Correct</span>
        <span class="tb-leg-item"><span class="tb-dot" style="background:#ea4335"></span>Wrong</span>
        <span class="tb-leg-item"><span class="tb-dot" style="background:#9aa0a6"></span>Skipped</span>
        <span class="tb-leg-item"><span class="tb-dot" style="background:#fbbc04"></span>No Key</span>
      </div>
    `;

    container.innerHTML = html;
  }
</script>

