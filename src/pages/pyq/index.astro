---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="TNPSC Previous Year Questions | TNPSC Fuhrer" description="Practice TNPSC Group 2A and Group 4 previous year questions with real exam papers." active="PYQ Quiz">
  <main class="pyq-page">
    <!-- ─── Hero Section ─────────────────────────────────────── -->
    <section class="pyq-hero">
      <div class="hero-bg-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
      </div>
      <div class="hero-content">
        <span class="hero-badge">🎯 Previous Year Questions</span>
        <h1 class="hero-title">PYQ Practice Zone</h1>
        <p class="hero-subtitle">Master TNPSC exams by practicing real questions from previous years. Analyze patterns, sharpen your skills, and build exam-day confidence.</p>
      </div>
    </section>

    <!-- ─── Quick Stats Row ──────────────────────────────────── -->
    <section class="stats-row">
      <div class="stats-inner">
        <div class="stat-chip">
          <span class="stat-icon">📝</span>
          <div class="stat-info">
            <span class="stat-number">400+</span>
            <span class="stat-label">Total Questions</span>
          </div>
        </div>
        <div class="stat-chip">
          <span class="stat-icon">📚</span>
          <div class="stat-info">
            <span class="stat-number">2</span>
            <span class="stat-label">Exam Papers</span>
          </div>
        </div>
        <div class="stat-chip">
          <span class="stat-icon">🏷️</span>
          <div class="stat-info">
            <span class="stat-number">15+</span>
            <span class="stat-label">Topics Covered</span>
          </div>
        </div>
        <div class="stat-chip">
          <span class="stat-icon">⏱️</span>
          <div class="stat-info">
            <span class="stat-number">6+ hrs</span>
            <span class="stat-label">Practice Time</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Exam Cards Grid ──────────────────────────────────── -->
    <section class="cards-section">
      <div class="cards-inner">
        <h2 class="section-heading">Choose Your Exam</h2>
        <div class="cards-grid">

          <!-- Group 2A Card -->
          <a href="/pyq/tnpsc-2026-GRP2A" class="exam-card" id="card-grp2a">
            <div class="card-border-glow"></div>
            <div class="card-body">
              <div class="card-top-row">
                <div class="card-icon-wrap amber-glow">
                  <span class="card-emoji">📋</span>
                </div>
                <span class="year-badge amber-badge">2026</span>
              </div>
              <h3 class="card-title">TNPSC Group 2A</h3>
              <p class="card-subtitle">Paper II — General Studies</p>
              <div class="card-meta-row">
                <div class="meta-item">
                  <span class="meta-icon">❓</span>
                  <span>200 Questions</span>
                </div>
                <div class="meta-item">
                  <span class="meta-icon">🏷️</span>
                  <span>8 Topics</span>
                </div>
                <div class="meta-item">
                  <span class="meta-icon">⏱️</span>
                  <span>~3 hrs</span>
                </div>
              </div>
              <div class="card-cta">
                <span class="cta-btn amber-cta">
                  Start Practice
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>

          <!-- Group 4 Card -->
          <a href="/pyq/tnpsc-2025-GRP4" class="exam-card" id="card-grp4">
            <div class="card-border-glow blue-border"></div>
            <span class="new-badge">NEW</span>
            <div class="card-body">
              <div class="card-top-row">
                <div class="card-icon-wrap blue-glow">
                  <span class="card-emoji">📝</span>
                </div>
                <span class="year-badge blue-badge">2025</span>
              </div>
              <h3 class="card-title">TNPSC Group 4</h3>
              <p class="card-subtitle">Comprehensive Exam — Tamil & General Studies</p>
              <div class="card-meta-row">
                <div class="meta-item">
                  <span class="meta-icon">❓</span>
                  <span>200 Questions</span>
                </div>
                <div class="meta-item">
                  <span class="meta-icon">🏷️</span>
                  <span>10 Topics</span>
                </div>
                <div class="meta-item">
                  <span class="meta-icon">⏱️</span>
                  <span>~3 hrs</span>
                </div>
              </div>
              <div class="card-cta">
                <span class="cta-btn blue-cta">
                  Start Practice
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>

        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ─── Page Reset ──────────────────────────────────────────── */
  .pyq-page {
    min-height: calc(100vh - 64px);
    background: var(--bg, #F8F7F4);
    overflow-x: hidden;
  }

  /* ─── Keyframes ───────────────────────────────────────────── */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(30px, -20px) scale(1.05); }
    66%      { transform: translate(-20px, 15px) scale(0.95); }
  }

  @keyframes shimmer {
    0%   { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 8px rgba(26, 115, 232, 0.4); }
    50%      { box-shadow: 0 0 20px rgba(26, 115, 232, 0.7); }
  }

  @keyframes border-spin {
    from { --angle: 0deg; }
    to   { --angle: 360deg; }
  }

  /* ─── Hero Section ────────────────────────────────────────── */
  .pyq-hero {
    position: relative;
    background: linear-gradient(135deg, var(--navy, #14213D) 0%, #1a3a6b 50%, #243b6a 100%);
    padding: 5rem 1.5rem 4rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-bg-orbs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.25;
    animation: float 18s ease-in-out infinite;
  }

  .orb-1 {
    width: 400px; height: 400px;
    background: var(--blue, #1a73e8);
    top: -100px; left: -80px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 300px; height: 300px;
    background: var(--accent, #C1121F);
    bottom: -60px; right: -40px;
    animation-delay: -6s;
  }

  .orb-3 {
    width: 200px; height: 200px;
    background: #6366f1;
    top: 30%; right: 20%;
    animation-delay: -12s;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 1.2rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
    font-family: 'Inter', sans-serif;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    text-shadow: 0 0 60px rgba(26, 115, 232, 0.5), 0 0 120px rgba(26, 115, 232, 0.2);
    line-height: 1.15;
  }

  .hero-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    max-width: 540px;
    margin: 0 auto;
  }

  /* ─── Stats Row ───────────────────────────────────────────── */
  .stats-row {
    position: relative;
    z-index: 2;
    margin-top: -2rem;
    padding: 0 1.5rem;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  .stats-inner {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 1.5rem 2rem;
    box-shadow: 0 8px 32px rgba(20, 33, 61, 0.1), 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  .stat-chip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stat-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: 'Inter', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--navy, #14213D);
    line-height: 1.2;
  }

  .stat-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted, #6B6860);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ─── Cards Section ───────────────────────────────────────── */
  .cards-section {
    padding: 3.5rem 1.5rem 5rem;
  }

  .cards-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--navy, #14213D);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  /* ─── Exam Card ───────────────────────────────────────────── */
  .exam-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 24px;
    padding: 3px; /* space for the gradient border */
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
    animation: fadeInUp 0.7s ease-out both;
  }

  .exam-card:nth-child(1) { animation-delay: 0.3s; }
  .exam-card:nth-child(2) { animation-delay: 0.45s; }

  /* Gradient border overlay */
  .card-border-glow {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: linear-gradient(135deg, rgba(227, 116, 0, 0.15), rgba(227, 116, 0, 0.05), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .card-border-glow.blue-border {
    background: linear-gradient(135deg, rgba(26, 115, 232, 0.2), rgba(99, 102, 241, 0.1), transparent);
  }

  .exam-card:hover .card-border-glow {
    opacity: 1;
  }

  .card-body {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 22px;
    padding: 2rem 1.75rem;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.03);
  }

  .exam-card:hover .card-body {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 1);
    box-shadow: 0 20px 60px rgba(20, 33, 61, 0.12), 0 4px 12px rgba(0, 0, 0, 0.04);
  }

  .exam-card:hover {
    transform: translateY(-8px);
  }

  /* NEW Badge */
  .new-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    background: linear-gradient(135deg, var(--blue, #1a73e8), #6366f1);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    text-transform: uppercase;
    animation: pulse-glow 2.5s ease-in-out infinite;
  }

  /* Card Top Row */
  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .card-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card-icon-wrap.amber-glow {
    background: linear-gradient(135deg, #fff3e0, #ffe0b2);
    box-shadow: 0 4px 16px rgba(227, 116, 0, 0.15);
  }

  .card-icon-wrap.blue-glow {
    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    box-shadow: 0 4px 16px rgba(26, 115, 232, 0.15);
  }

  .exam-card:hover .card-icon-wrap {
    transform: scale(1.08) rotate(-3deg);
  }

  .card-emoji {
    font-size: 1.6rem;
  }

  .year-badge {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .amber-badge {
    background: rgba(227, 116, 0, 0.1);
    color: var(--amber, #e37400);
  }

  .blue-badge {
    background: rgba(26, 115, 232, 0.1);
    color: var(--blue, #1a73e8);
  }

  /* Card Content */
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--navy, #14213D);
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .card-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: var(--muted, #6B6860);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  /* Meta Row */
  .card-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(20, 33, 61, 0.04);
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--navy, #14213D);
  }

  .meta-icon {
    font-size: 0.85rem;
  }

  /* CTA Button */
  .card-cta {
    margin-top: auto;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.7rem 1.5rem;
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    letter-spacing: 0.01em;
  }

  .cta-btn svg {
    transition: transform 0.3s ease;
  }

  .exam-card:hover .cta-btn svg {
    transform: translateX(4px);
  }

  .amber-cta {
    background: linear-gradient(135deg, var(--amber, #e37400), #f59e0b);
    color: #fff;
    box-shadow: 0 4px 16px rgba(227, 116, 0, 0.25);
  }

  .exam-card:hover .amber-cta {
    box-shadow: 0 8px 24px rgba(227, 116, 0, 0.35);
    transform: translateY(-1px);
  }

  .blue-cta {
    background: linear-gradient(135deg, var(--blue, #1a73e8), #6366f1);
    color: #fff;
    box-shadow: 0 4px 16px rgba(26, 115, 232, 0.25);
  }

  .exam-card:hover .blue-cta {
    box-shadow: 0 8px 24px rgba(26, 115, 232, 0.35);
    transform: translateY(-1px);
  }

  /* ─── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .pyq-hero {
      padding: 3.5rem 1.25rem 3rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 1.25rem 1.25rem;
      gap: 1rem;
    }

    .cards-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .cards-section {
      padding: 2.5rem 1rem 3.5rem;
    }

    .section-heading {
      font-size: 1.35rem;
      margin-bottom: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .pyq-hero {
      padding: 3rem 1rem 2.5rem;
    }

    .stats-inner {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding: 1rem;
    }

    .stat-chip {
      gap: 0.5rem;
    }

    .stat-number {
      font-size: 1rem;
    }

    .card-body {
      padding: 1.5rem 1.25rem;
    }

    .card-meta-row {
      gap: 0.4rem;
    }

    .meta-item {
      font-size: 0.72rem;
      padding: 0.3rem 0.55rem;
    }
  }
</style>
