---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="TNPSC Previous Year Questions" description="Practice TNPSC Group 2A and Group 4 previous year questions with real exam papers." active="PYQ Quiz">
  
  <div class="page-header animate-in">
    <span class="badge badge-accent mb-3">Previous Year Questions</span>
    <h1>PYQ Practice Zone</h1>
    <p>Master TNPSC exams by practicing real questions from previous years. Analyze patterns, sharpen your skills, and build exam-day confidence.</p>
  </div>

  <div class="grid grid-4 mb-8 stagger">
    <div class="stat-card">
      <div class="stat-label">Total Questions</div>
      <div class="stat-value text-mono">400+</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Exam Papers</div>
      <div class="stat-value text-mono">2</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Topics Covered</div>
      <div class="stat-value text-mono">15+</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Practice Time</div>
      <div class="stat-value text-mono">6+ hrs</div>
    </div>
  </div>

  <div class="mb-10 animate-in" style="animation-delay: 200ms;">
    <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">Choose Your Exam</h2>
    <div class="grid grid-2">
      <!-- Group 2A Card -->
      <a href="/pyq/tnpsc-2026-GRP2A" class="card card-interactive" style="text-decoration: none;">
        <div class="flex items-center justify-between mb-4">
          <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--accent) 10%, transparent); font-size: 1.2rem;">📋</div>
          <span class="badge badge-accent">2026</span>
        </div>
        <h3 style="font-size: 1.15rem; margin-bottom: var(--space-1); color: var(--text);">TNPSC Group 2A</h3>
        <p class="text-secondary" style="font-size: 0.85rem; margin-bottom: var(--space-4);">Paper II — General Studies</p>
        
        <div class="flex gap-4 text-muted mb-6" style="font-size: 0.8rem;">
          <span class="flex items-center gap-1">❓ 200 Questions</span>
          <span class="flex items-center gap-1">🏷️ 8 Topics</span>
          <span class="flex items-center gap-1">⏱️ ~3 hrs</span>
        </div>
        
        <div class="btn btn-outline w-full flex justify-between items-center">
          Start Practice
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </a>

      <!-- Group 4 Card -->
      <a href="/pyq/tnpsc-2025-GRP4" class="card card-interactive" style="text-decoration: none; position: relative;">
        <div style="position: absolute; top: var(--space-4); left: 50%; transform: translateX(-50%); z-index: 1;">
          <span class="badge badge-green" style="box-shadow: 0 0 0 4px var(--surface);">NEW</span>
        </div>
        <div class="flex items-center justify-between mb-4">
          <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--green) 10%, transparent); font-size: 1.2rem;">📝</div>
          <span class="badge badge-neutral">2025</span>
        </div>
        <h3 style="font-size: 1.15rem; margin-bottom: var(--space-1); color: var(--text);">TNPSC Group 4</h3>
        <p class="text-secondary" style="font-size: 0.85rem; margin-bottom: var(--space-4);">Comprehensive Exam — Tamil & General Studies</p>
        
        <div class="flex gap-4 text-muted mb-6" style="font-size: 0.8rem;">
          <span class="flex items-center gap-1">❓ 200 Questions</span>
          <span class="flex items-center gap-1">🏷️ 10 Topics</span>
          <span class="flex items-center gap-1">⏱️ ~3 hrs</span>
        </div>
        
        <div class="btn btn-outline w-full flex justify-between items-center" style="color: var(--green); border-color: color-mix(in srgb, var(--green) 30%, transparent);">
          Start Practice
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </a>
    </div>
  </div>

</Layout>
