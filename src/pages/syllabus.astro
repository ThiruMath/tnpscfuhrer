      { num: "II", title: "சொல்லகராதி / Vocabulary", questions: 15, tags: ["tamil vocabulary"], topics: ["எதிர்ச்சொல்","ஓரெழுத்து ஒருமொழி","பொருத்தமான சொல் தேர்வு","பேச்சு vs எழுத்து வழக்கு"] },
      { num: "III", title: "எழுதும் திறன் / Writing", questions: 15, tags: ["tamil writing"], topics: ["சொற்களை ஒழுங்குபடுத்துதல்","மரபுத்தமிழ் – திணை, பால், காலம்","நிறுத்தல் குறியீடுகள்"] },
      { num: "IV", title: "கலைச்சொற்கள் / Technical", questions: 10, tags: ["tamil technical terms"], topics: ["அறிவியல், கல்வி, மருத்துவக் கலைச்சொற்கள்","Gene – மரபணு, Allergy – ஒவ்வாமை"] },
      { num: "V", title: "வாசிப்புத் திறன் / Comprehension", questions: 15, tags: ["tamil comprehension"], topics: ["பத்தியிலிருந்து கேள்விகளுக்கு விடை","அரசு சார்ந்த செய்திகள்","உவமை, மரபுத்தொடர்"] },
      { num: "VI", title: "மொழி பெயர்ப்பு / Translation", questions: 5, tags: ["translation"], topics: ["ஆங்கிலம் → தமிழ் சொற்கள்","ஆவணத் தலைப்புகள், கோப்புகள்"] },
      { num: "VII", title: "இலக்கியம் & அறிஞர்கள் / Literature", questions: 15, tags: ["thirukkural","sangam literature"], topics: ["திருக்குறள் – 20 அதிகாரங்கள்","நாலடியார், பழமொழி நானூறு","உ.வே.சா, தே.போ.மீ, சி.இலக்குவனார்","பாவேந்தர், கண்ணதாசன், தாராபாரதி"] }
    ],
    englishUnits: [
      { num: "I", title: "Grammar", questions: 25, tags: ["english grammar","tense","voice"], topics: ["Parts of Speech, Tense, Concord","Active / Passive Voice","Transformations, Question Tags","Direct / Indirect Speech, Synthesis"] },
      { num: "II", title: "Vocabulary", questions: 15, tags: ["synonyms","antonyms","idioms"], topics: ["Synonyms, Antonyms, Homonyms","Idioms & Phrases, Phrasal Verbs","One-word substitution","Figures of speech"] },
      { num: "III", title: "Writing Skills", questions: 10, tags: ["letter writing"], topics: ["Formal / Informal letters","Jumbled sentences","Inferences, Substitutions"] },
      { num: "IV", title: "Technical Terms", questions: 10, tags: ["administrative terms"], topics: ["Administrative Terms","Official Correspondence"] },
      { num: "V", title: "Reading Comprehension", questions: 20, tags: ["comprehension","reading"], topics: ["Unseen passages","Government news","Sentence Completion, Fact ascertainment"] },
      { num: "VI", title: "Translation", questions: 5, tags: ["translation"], topics: ["Word & Sentence Translation","Tense / Voice tasks"] },
      { num: "VII", title: "Literary Works", questions: 15, tags: ["poetry","prose","literature"], topics: ["Poetry: Sea Fever, A Poison Tree, Stopping by Woods...","Prose: His First Flight, The Last Lesson","Biography of Srinivasa Ramanujan","A Birthday Letter by Nehru"] }
    ]
  }
];

// Build related notes
for (const part of parts) {
  if (part.units) {
    for (const unit of part.units as any[]) {
      unit.relatedNotes = findRelatedNotes(unit.tags);
    }
  }
  if (part.tamilUnits) {
    for (const unit of part.tamilUnits as any[]) { unit.relatedNotes = findRelatedNotes(unit.tags); }
  }
  if (part.englishUnits) {
    for (const unit of part.englishUnits as any[]) { unit.relatedNotes = findRelatedNotes(unit.tags); }
  }
}

const totalTopics = parts.reduce((acc, p) => {
  let c = 0;
  if (p.units) c += p.units.reduce((a: number, u: any) => a + u.topics.length, 0);
  if (p.tamilUnits) c += p.tamilUnits.reduce((a: number, u: any) => a + u.topics.length, 0);
  return acc + c;
}, 0);
---

<Layout title="Syllabus — TNPSC Group II/IIA" description="Complete TNPSC Group II & IIA syllabus with progress tracking, unit-wise breakdown, and linked study notes." active="Syllabus">

  <!-- Page Header -->
  <div class="page-header animate-in">
    <div class="flex items-center gap-3 mb-3">
      <span class="badge badge-accent">Code 495</span>
      <span class="badge badge-neutral">Updated Dec 2024</span>
    </div>
    <h1>TNPSC Group II & IIA Syllabus</h1>
    <p>Combined Civil Services Preliminary Examination — track your progress, check linked notes, and stay focused.</p>
  </div>

  <!-- Overview Stats -->
  <div class="grid grid-3 mb-6 stagger">
    {parts.map(p => (
      <div class="stat-card" style={`border-left: 3px solid ${p.color};`}>
        <div class="stat-label">Part {p.id}</div>
        <div class="stat-value" style={`font-size: 1.5rem; color: ${p.color};`}>{p.total}</div>
        <div class="stat-footer">{p.name} · {p.standard}</div>
      </div>
    ))}
  </div>

  <!-- Global progress -->
  <div class="card mb-6 animate-in" style="animation-delay: 200ms;">
    <div class="card-header">
      <span class="card-title">Overall Syllabus Progress</span>
      <span class="text-mono text-muted" style="font-size: 0.85rem;" id="global-progress-text">0 / {totalTopics} topics</span>
    </div>
    <div style="height: 8px; background: var(--surface-sunken); border-radius: var(--radius-full); overflow: hidden;">
      <div id="global-progress-bar" style="height: 100%; width: 0%; background: var(--accent); border-radius: var(--radius-full); transition: width 0.6s var(--ease-out);"></div>
    </div>
  </div>

  <!-- Part filter tabs -->
  <div class="flex gap-2 mb-6 flex-wrap animate-in" style="animation-delay: 250ms;">
    <button class="syl-tab active" data-target="all">All Parts</button>
    <button class="syl-tab" data-target="partA">General Studies</button>
    <button class="syl-tab" data-target="partB">Aptitude</button>
    <button class="syl-tab" data-target="partC">Language</button>
  </div>

  <!-- Parts -->
  {parts.map((part, pIdx) => (
    <section class={`syl-part animate-in`} id={`part${part.id}`} data-part-id={part.id} style={`animation-delay: ${300 + pIdx * 100}ms;`}>
      <!-- Part header -->
      <div class="syl-part-header" style={`border-left: 4px solid ${part.color};`}>
        <div>
          <h2 style="font-size: 1.15rem; margin-bottom: 2px;">Part {part.id} — {part.name}</h2>
          <span class="text-muted" style="font-size: 0.8rem;">{part.standard} · {part.total} Questions</span>
        </div>
        <span class="text-mono" style={`font-size: 0.85rem; font-weight: 700; color: ${part.color};`} id={`part-${part.id}-progress`}>0%</span>
      </div>

      {/* Language toggle for Part C */}
      {part.id === "C" && (
        <div class="flex gap-2 mb-4" style="padding-left: 1.5rem;">
          <button class="lang-tab active" data-lang="tamil">பொதுத் தமிழ்</button>
          <button class="lang-tab" data-lang="english">General English</button>
        </div>
      )}

      {/* Regular units (Parts A & B) */}
      {part.units && (
        <div class="syl-units">
          {part.units.map((unit: any) => (
            <div class="syl-unit">
              <div class="syl-unit-top">
                <div class="flex items-center gap-3">
                  <span class="syl-unit-num" style={`background: ${part.colorSoft}; color: ${part.color};`}>Unit {unit.num}</span>
                  <div>
                    <div style="font-weight: 600; font-size: 0.95rem;">{unit.title}</div>
                    <div class="text-muted" style="font-size: 0.75rem;">{unit.questions} Questions · {unit.topics.length} topics</div>
                  </div>
                </div>
                <span class="text-mono text-muted" style="font-size: 0.78rem;" id={`u-${part.id}-${unit.num}`}>0/{unit.topics.length}</span>
              </div>
              <div class="syl-progress-track">
                <div class="syl-progress-fill" id={`bar-${part.id}-${unit.num}`} style={`background: ${part.color};`}></div>
              </div>
              <ul class="syl-topics">
                {unit.topics.map((t: any, tIdx: number) => {
                  const uid = `syllabus-checked-${part.id}-${unit.num}-${tIdx}`;
                  const isObj = typeof t === 'object';
                  const topicName = isObj ? t.name : t;
                  const topicPdf = isObj ? t.pdf : null;
                  
                  return (
                    <li class="syl-topic">
                      <label class="syl-check-label">
                        <input type="checkbox" class="syl-checkbox" data-id={uid} data-part={part.id} data-unit={unit.num} />
                        <span class="syl-check-box" style={`--check-color: ${part.color};`}></span>
                        <span class="syl-topic-text">{topicName}</span>
                      </label>
                      <div class="syl-topic-actions">
                        {topicPdf ? (
                          <a href={topicPdf} target="_blank" class="syl-action-btn pdf-btn" style={`color: ${part.color}; border-color: ${part.color};`}>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            PDF
                          </a>
                        ) : (
                          <a href="https://t.me/tnpscfuhrer_group" target="_blank" class="syl-action-btn req-btn" title="Request this material">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"></path><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            Request
                          </a>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
              {unit.relatedNotes?.length > 0 && (
                <div class="syl-notes">
                  <span class="text-muted" style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Related Notes</span>
                  <div class="flex gap-2 flex-wrap" style="margin-top: var(--space-2);">
                    {unit.relatedNotes.map((n: any) => (
                      <a href={`/notes/${n.slug}`} class="syl-note-chip">{n.title.length > 30 ? n.title.slice(0, 30) + '…' : n.title}</a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {/* Tamil units */}
      {part.tamilUnits && (
        <div class="syl-units lang-panel" data-lang-panel="tamil">
          {part.tamilUnits.map((unit: any) => (
            <div class="syl-unit">
              <div class="syl-unit-top">
                <div class="flex items-center gap-3">
                  <span class="syl-unit-num" style={`background: ${part.colorSoft}; color: ${part.color};`}>அலகு {unit.num}</span>
                  <div>
                    <div style="font-weight: 600; font-size: 0.95rem;" class="text-tamil">{unit.title}</div>
                    <div class="text-muted" style="font-size: 0.75rem;">{unit.questions} Qs · {unit.topics.length} topics</div>
                  </div>
                </div>
                <span class="text-mono text-muted" style="font-size: 0.78rem;" id={`u-C-tamil-${unit.num}`}>0/{unit.topics.length}</span>
              </div>
              <div class="syl-progress-track"><div class="syl-progress-fill" id={`bar-C-tamil-${unit.num}`} style={`background: ${part.color};`}></div></div>
              <ul class="syl-topics">
                {unit.topics.map((t: any, tIdx: number) => {
                  const uid = `syllabus-checked-C-tamil-${unit.num}-${tIdx}`;
                  const isObj = typeof t === 'object';
                  const topicName = isObj ? t.name : t;
                  const topicPdf = isObj ? t.pdf : null;
                  
                  return (
                    <li class="syl-topic">
                      <label class="syl-check-label">
                        <input type="checkbox" class="syl-checkbox" data-id={uid} data-part="C-tamil" data-unit={unit.num} />
                        <span class="syl-check-box" style={`--check-color: ${part.color};`}></span>
                        <span class="syl-topic-text text-tamil">{topicName}</span>
                      </label>
                      <div class="syl-topic-actions">
                        {topicPdf ? (
                          <a href={topicPdf} target="_blank" class="syl-action-btn pdf-btn" style={`color: ${part.color}; border-color: ${part.color};`}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> PDF</a>
                        ) : (
                          <a href="https://t.me/tnpscfuhrer_group" target="_blank" class="syl-action-btn req-btn" title="Request this material"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"></path><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Request</a>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
              {unit.relatedNotes?.length > 0 && (
                <div class="syl-notes"><span class="text-muted" style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">Related Notes</span><div class="flex gap-2 flex-wrap" style="margin-top: var(--space-2);">{unit.relatedNotes.map((n: any) => (<a href={`/notes/${n.slug}`} class="syl-note-chip">{n.title.length > 30 ? n.title.slice(0, 30) + '…' : n.title}</a>))}</div></div>
              )}
            </div>
          ))}
        </div>
      )}

      {/* English units */}
      {part.englishUnits && (
        <div class="syl-units lang-panel" data-lang-panel="english" style="display:none;">
          {part.englishUnits.map((unit: any) => (
            <div class="syl-unit">
              <div class="syl-unit-top">
                <div class="flex items-center gap-3">
                  <span class="syl-unit-num" style={`background: ${part.colorSoft}; color: ${part.color};`}>Unit {unit.num}</span>
                  <div>
                    <div style="font-weight: 600; font-size: 0.95rem;">{unit.title}</div>
                    <div class="text-muted" style="font-size: 0.75rem;">{unit.questions} Qs · {unit.topics.length} topics</div>
                  </div>
                </div>
                <span class="text-mono text-muted" style="font-size: 0.78rem;" id={`u-C-english-${unit.num}`}>0/{unit.topics.length}</span>
              </div>
              <div class="syl-progress-track"><div class="syl-progress-fill" id={`bar-C-english-${unit.num}`} style={`background: ${part.color};`}></div></div>
              <ul class="syl-topics">
                {unit.topics.map((t: any, tIdx: number) => {
                  const uid = `syllabus-checked-C-english-${unit.num}-${tIdx}`;
                  const isObj = typeof t === 'object';
                  const topicName = isObj ? t.name : t;
                  const topicPdf = isObj ? t.pdf : null;
                  
                  return (
                    <li class="syl-topic">
                      <label class="syl-check-label">
                        <input type="checkbox" class="syl-checkbox" data-id={uid} data-part="C-english" data-unit={unit.num} />
                        <span class="syl-check-box" style={`--check-color: ${part.color};`}></span>
                        <span class="syl-topic-text">{topicName}</span>
                      </label>
                      <div class="syl-topic-actions">
                        {topicPdf ? (
                          <a href={topicPdf} target="_blank" class="syl-action-btn pdf-btn" style={`color: ${part.color}; border-color: ${part.color};`}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> PDF</a>
                        ) : (
                          <a href="https://t.me/tnpscfuhrer_group" target="_blank" class="syl-action-btn req-btn" title="Request this material"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"></path><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Request</a>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
              {unit.relatedNotes?.length > 0 && (
                <div class="syl-notes"><span class="text-muted" style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase;">Related Notes</span><div class="flex gap-2 flex-wrap" style="margin-top: var(--space-2);">{unit.relatedNotes.map((n: any) => (<a href={`/notes/${n.slug}`} class="syl-note-chip">{n.title.length > 30 ? n.title.slice(0, 30) + '…' : n.title}</a>))}</div></div>
              )}
            </div>
          ))}
        </div>
      )}
    </section>
  ))}

</Layout>

<style>
  /* Part header */
  .syl-part { margin-bottom: var(--space-8); }
  .syl-part-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-4);
  }
  /* Tabs */
  .syl-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .syl-tab:hover { border-color: var(--border-hover); color: var(--text); }
  .syl-tab.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }

  .lang-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .lang-tab.active { background: var(--purple); color: white; border-color: var(--purple); }

  /* Unit cards */
  .syl-units { display: flex; flex-direction: column; gap: var(--space-4); }
  .syl-unit {
    background: var(--surface-sunken);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--duration-normal) var(--ease-out);
  }
  .syl-unit:hover { background: var(--surface); box-shadow: var(--shadow-sm); border-color: var(--border-subtle); }
  .syl-unit-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .syl-unit-num {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-xs);
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Progress */
  .syl-progress-track {
    height: 4px; background: var(--surface-sunken); border-radius: 2px;
    margin-bottom: var(--space-4); overflow: hidden;
  }
  .syl-progress-fill {
    height: 100%; width: 0%; border-radius: 2px;
    transition: width 0.5s var(--ease-out);
  }

  /* Topics */
  .syl-topics { list-style: none; display: flex; flex-direction: column; }
  .syl-topic { 
    font-size: 0.875rem; 
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .syl-topic:last-child { border-bottom: none; }
  .syl-check-label {
    display: flex; align-items: flex-start; gap: var(--space-3); cursor: pointer;
    flex: 1; margin: 0;
  }
  .syl-checkbox { display: none; }
  .syl-check-box {
    width: 18px; height: 18px; flex-shrink: 0;
    border: 2px solid var(--border-hover);
    border-radius: var(--radius-xs);
    display: flex; align-items: center; justify-content: center;
    transition: all var(--duration-fast);
    margin-top: 1px;
    position: relative;
  }
  .syl-checkbox:checked + .syl-check-box {
    background: var(--check-color);
    border-color: var(--check-color);
  }
  .syl-checkbox:checked + .syl-check-box::after {
    content: '';
    width: 5px; height: 9px;
    border: solid white; border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px;
  }
  .syl-checkbox:checked ~ .syl-topic-text {
    text-decoration: line-through;
    color: var(--text-faint);
  }
  .syl-topic-text { line-height: 1.5; color: var(--text-secondary); }

  /* Topic Action Buttons */
  .syl-topic-actions { flex-shrink: 0; display: flex; align-items: center; }
  .syl-action-btn {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px; border-radius: var(--radius-sm);
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em;
    text-decoration: none; border: 1px solid var(--border);
    background: var(--surface); color: var(--text-muted);
    transition: all var(--duration-fast); white-space: nowrap;
  }
  .syl-action-btn.pdf-btn { background: transparent; }
  .syl-action-btn.pdf-btn:hover { background: currentColor; color: var(--surface) !important; }
  .syl-action-btn.req-btn:hover { border-color: var(--text); color: var(--text); }

  /* Related notes */
  .syl-notes {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }
  .syl-note-chip {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.75rem; font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--duration-fast);
  }
  .syl-note-chip:hover { border-color: var(--accent); color: var(--accent); }

  @media (max-width: 768px) {
    .syl-units { padding-left: 0; }
    .syl-unit-top { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }
</style>

<script>
  // === Tab filtering ===
  document.querySelectorAll('.syl-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.syl-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = (btn as HTMLElement).dataset.target;
      document.querySelectorAll('.syl-part').forEach(s => {
        const el = s as HTMLElement;
        if (target === 'all') { el.style.display = ''; }
        else { el.style.display = el.id === target ? '' : 'none'; }
      });
    });
  });

  // === Language toggle (Part C) ===
  document.querySelectorAll('.lang-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.lang-panel').forEach(p => {
        const el = p as HTMLElement;
        el.style.display = el.dataset.langPanel === lang ? '' : 'none';
      });
    });
  });

  // === Checkbox persistence & progress ===
  const allBoxes = document.querySelectorAll('.syl-checkbox') as NodeListOf<HTMLInputElement>;

  // Restore state
  allBoxes.forEach(cb => {
    const id = cb.dataset.id!;
    if (localStorage.getItem(id) === 'true') cb.checked = true;
  });

  // Save & update on change
  allBoxes.forEach(cb => {
    cb.addEventListener('change', () => {
      localStorage.setItem(cb.dataset.id!, cb.checked.toString());
      updateProgress();
    });
  });

  function updateProgress() {
    // Per-unit progress
    const unitMap: Record<string, { done: number; total: number }> = {};
    allBoxes.forEach(cb => {
      const key = `${cb.dataset.part}-${cb.dataset.unit}`;
      if (!unitMap[key]) unitMap[key] = { done: 0, total: 0 };
      unitMap[key].total++;
      if (cb.checked) unitMap[key].done++;
    });

    for (const [key, { done, total }] of Object.entries(unitMap)) {
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      const bar = document.getElementById(`bar-${key}`);
      const text = document.getElementById(`u-${key}`);
      if (bar) bar.style.width = `${pct}%`;
      if (text) text.textContent = `${done}/${total}`;
    }

    // Per-part progress
    const partMap: Record<string, { done: number; total: number }> = {};
    allBoxes.forEach(cb => {
      const partId = cb.dataset.part!.split('-')[0]; // A, B, C
      if (!partMap[partId]) partMap[partId] = { done: 0, total: 0 };
      partMap[partId].total++;
      if (cb.checked) partMap[partId].done++;
    });

    for (const [partId, { done, total }] of Object.entries(partMap)) {
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      const el = document.getElementById(`part-${partId}-progress`);
      if (el) el.textContent = `${pct}%`;
    }

    // Global progress
    let totalDone = 0;
    let totalAll = 0;
    allBoxes.forEach(cb => { totalAll++; if (cb.checked) totalDone++; });
    const globalPct = totalAll > 0 ? Math.round((totalDone / totalAll) * 100) : 0;
    const gBar = document.getElementById('global-progress-bar');
    const gText = document.getElementById('global-progress-text');
    if (gBar) gBar.style.width = `${globalPct}%`;
    if (gText) gText.textContent = `${totalDone} / ${totalAll} topics (${globalPct}%)`;
  }

  updateProgress();
</script>
