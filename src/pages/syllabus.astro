---
import Layout from '../layouts/Layout.astro';
import { prelims, mainsGroup2, mainsGroup2A } from '../data/examScheme';
import { meta as prelimsMeta, partA as prelimsPartA, partB as prelimsPartB, partC as prelimsPartC } from '../data/prelims';
import { meta as tamilMeta, examPattern as tamilPattern, syllabusTopics as tamilTopics } from '../data/tamilEligibility';
import { meta as group2Meta, units as group2Units } from '../data/group2';
import { meta as group2aMeta, partA as group2aPartA, partB as group2aPartB } from '../data/group2a';
---

<Layout title="Syllabus" description="Complete syllabus and exam scheme for TNPSC Group II and IIA" active="Syllabus">
  <div class="content-wrapper">
    <!-- 1. Exam Name -->
    <header class="page-header">
      <h1>Combined Civil Services Examination II (Group II & IIA Services)</h1>
      <p class="subtitle">Complete Exam Scheme & Syllabus Reference</p>
    </header>

    <!-- Notes regarding Official Scheme and Current Affairs -->
    <div class="important-notes">
      <div class="note-box warning">
        <strong>⚠️ Official Syllabus Disclaimer:</strong> This page is compiled for quick reference. TNPSC periodically revises syllabi. Always cross-check against the official live notification at <a href="https://www.tnpsc.gov.in" target="_blank" rel="noopener">tnpsc.gov.in</a>.
      </div>
      <div class="note-box info">
        <strong>💡 Note on Current Affairs:</strong> Current Affairs is not just a standalone topic. It is embedded dynamically across all units. Expect current events to heavily influence questions in Science, Polity, Economy, and Geography.
      </div>
    </div>

    <!-- 2 & 3. Exam Scheme & Mark Distribution -->
    <section class="section">
      <h2 class="section-title">Exam Scheme & Mark Distribution</h2>
      
      <div class="scheme-grid">
        <div class="scheme-card">
          <h3>Preliminary Exam (Common)</h3>
          <ul class="scheme-list">
            <li><strong>Type:</strong> Objective (OMR)</li>
            <li><strong>Marks:</strong> {prelims.totalMarks}</li>
            <li><strong>Duration:</strong> {prelims.duration || "3 Hours"}</li>
            <li><strong>Role:</strong> Qualifying only</li>
          </ul>
        </div>
        
        <div class="scheme-card">
          <h3>Group II (Interview Post)</h3>
          <ul class="scheme-list">
            <li><strong>Mains Paper I:</strong> Tamil Eligibility (100 Marks)</li>
            <li><strong>Mains Paper II:</strong> Descriptive GS (300 Marks)</li>
            <li><strong>Interview:</strong> Oral Test (40 Marks)</li>
            <li><strong>Total for Ranking:</strong> 340 Marks</li>
          </ul>
        </div>

        <div class="scheme-card">
          <h3>Group IIA (Non-Interview)</h3>
          <ul class="scheme-list">
            <li><strong>Mains Paper I:</strong> Tamil Eligibility (100 Marks)</li>
            <li><strong>Mains Paper II:</strong> Objective GS & Reasoning (300 Marks)</li>
            <li><strong>Interview:</strong> None</li>
            <li><strong>Total for Ranking:</strong> 300 Marks</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 4. Syllabus for Prelims -->
    <section class="section">
      <h2 class="section-title">Syllabus for Prelims</h2>
      <p class="meta-desc">General Studies (75 Qs) + Aptitude (25 Qs) + Language (100 Qs) = 200 Questions</p>
      
      <div class="syllabus-block">
        <h3>{prelimsPartA.label} <span class="marks-badge">{prelimsPartA.questions} Questions</span></h3>
        <div class="unit-grid">
          {prelimsPartA.units.map(unit => (
            <div class="unit-card">
              <h4>Unit {unit.no}: {unit.title}</h4>
              <p>{unit.content}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="syllabus-block">
        <h3>{prelimsPartB.label} <span class="marks-badge">{prelimsPartB.questions} Questions</span></h3>
        <div class="unit-grid">
          {prelimsPartB.units.map(unit => (
            <div class="unit-card">
              <h4>Unit {unit.no}: {unit.title}</h4>
              <p>{unit.content}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="syllabus-block">
        <h3>Language Paper <span class="marks-badge">100 Questions</span></h3>
        <p class="note">Candidates can choose either General Tamil or General English.</p>
      </div>
    </section>

    <!-- 5. Syllabus for Tamil Eligibility (Mains Paper I) -->
    <section class="section">
      <h2 class="section-title">Tamil Eligibility Test (Mains Paper I)</h2>
      <p class="meta-desc">Descriptive Type • {tamilMeta.marks} Marks • Qualifying Nature (Minimum 40 Marks)</p>
      
      <div class="syllabus-block">
        <ul class="topic-list">
          {tamilTopics.map((topic, i) => (
            <li><strong>{i + 1}.</strong> {topic}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Syllabus for Mains -->
    <section class="section">
      <h2 class="section-title">Syllabus for Mains (Paper II)</h2>
      
      <div class="mains-split">
        <!-- Group 2 Mains -->
        <div class="mains-col">
          <div class="mains-header">
            <h3>Group II Mains</h3>
            <p>Descriptive • {mainsGroup2.marks || 300} Marks</p>
          </div>
          <div class="unit-list">
            {group2Units.map(unit => (
              <div class="unit-card compact">
                <h4>Unit {unit.no}: {unit.title}</h4>
                <p>{unit.content}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Group 2A Mains -->
        <div class="mains-col">
          <div class="mains-header">
            <h3>Group IIA Mains</h3>
            <p>Objective • {mainsGroup2A.marks || 300} Marks</p>
          </div>
          <div class="syllabus-block">
            <h4>{group2aPartA.label} (150 Qs)</h4>
            <div class="unit-list">
              {group2aPartA.units.map(unit => (
                <div class="unit-card compact">
                  <h5>Unit {unit.no}: {unit.title}</h5>
                  <p>{unit.content}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="syllabus-block" style="margin-top: 1.5rem;">
            <h4>{group2aPartB.label} (50 Qs)</h4>
            <div class="unit-list">
              {group2aPartB.topics.map((topic, i) => (
                <div class="unit-card compact">
                  <p><strong>{i + 1}.</strong> {topic}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .page-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .important-notes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .note-box {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .note-box.warning {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #b91c1c;
  }

  .note-box.info {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: #1d4ed8;
  }

  .section {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    position: relative;
    padding-left: 1rem;
  }

  .section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--primary);
    border-radius: 4px;
  }

  .meta-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .scheme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .scheme-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .scheme-card h3 {
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .scheme-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scheme-list li {
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--border);
    color: var(--text-secondary);
  }

  .scheme-list li:last-child {
    border-bottom: none;
  }

  .scheme-list strong {
    color: var(--text-primary);
  }

  .syllabus-block {
    margin-bottom: 2.5rem;
  }

  .syllabus-block h3 {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .marks-badge {
    font-size: 0.85rem;
    background: var(--primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    font-weight: 600;
  }

  .unit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .unit-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .unit-card h4, .unit-card h5 {
    color: var(--primary);
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
  }

  .unit-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .unit-card.compact {
    padding: 1rem;
  }
  
  .unit-card.compact h4, .unit-card.compact h5 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .unit-card.compact p {
    font-size: 0.85rem;
  }

  .topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .topic-list li {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: 8px;
    color: var(--text-secondary);
  }

  .topic-list strong {
    color: var(--text-primary);
    margin-right: 0.5rem;
  }

  .mains-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .mains-col {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .mains-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
  }

  .mains-header h3 {
    font-size: 1.3rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .mains-header p {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .unit-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .note {
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .mains-split {
      grid-template-columns: 1fr;
    }
  }
</style>
