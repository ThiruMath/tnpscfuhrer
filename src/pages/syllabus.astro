---
import Layout from '../layouts/Layout.astro';
import { parts, tamilUnits } from '../data/syllabus.ts';
---
<Layout title="TNPSC Group II & IIA Syllabus - Compact Guide">
  <div class="mb-12 text-center animate-in pt-4">
    <h1 class="text-3xl md:text-5xl font-extrabold text-[#1a365d] mb-3 uppercase tracking-wide">TNPSC Group II & IIA</h1>
    <h2 class="text-lg md:text-xl font-bold text-[#4a5568] uppercase tracking-widest">Section-Wise Breakdown</h2>
  </div>

  <!-- EXAM PATTERN CIRCLES (Interlocking) -->
  <div class="flex justify-center items-center mb-16 overflow-hidden py-4 animate-in" style="--stagger: 1">
    <div class="exam-circle" style="border-color: #38b2ac;">
      <span class="text-3xl font-black text-gray-800">180</span>
      <span class="text-xs font-bold text-gray-800 uppercase">Minutes</span>
    </div>
    <div class="exam-circle overlap-left" style="border-color: #2b6cb0;">
      <span class="text-4xl font-black text-gray-800">200</span>
      <span class="text-xs font-bold text-gray-800 uppercase">Questions</span>
    </div>
    <div class="exam-circle overlap-left" style="border-color: #e53e3e;">
      <span class="text-2xl font-black text-gray-800">OMR</span>
      <span class="text-[10px] font-bold text-gray-800 uppercase text-center leading-tight mt-1">Offline<br>Test</span>
    </div>
    <div class="exam-circle overlap-left" style="border-color: #ecc94b;">
      <span class="text-3xl font-black text-gray-800">300</span>
      <span class="text-[10px] font-bold text-gray-800 uppercase text-center leading-tight mt-1">Marks<br>Total</span>
    </div>
  </div>

  <!-- HORIZONTAL SECTION BREAKDOWN -->
  <div class="mb-16 border-b-[5px] border-[#1a202c] pb-8 animate-in max-w-5xl mx-auto" style="--stagger: 2">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
      
      <div class="flex flex-col items-center text-center px-6">
        <div class="text-[#2b6cb0] text-6xl mb-4">📘</div>
        <div class="font-black uppercase text-lg mb-4 border-b-2 border-black w-full pb-2">General Studies</div>
        <ul class="text-sm font-bold text-left w-full mt-2 space-y-2 uppercase tracking-tight text-gray-700">
          <li>• History & Culture</li>
          <li>• Indian Polity</li>
          <li>• Economy & Dev</li>
          <li>• General Science</li>
        </ul>
      </div>

      <div class="flex flex-col items-center text-center px-6 md:border-l-2 md:border-[#1a202c]">
        <div class="text-[#38a169] text-6xl mb-4">🧮</div>
        <div class="font-black uppercase text-lg mb-4 border-b-2 border-black w-full pb-2">Aptitude & Mental</div>
        <ul class="text-sm font-bold text-left w-full mt-2 space-y-2 uppercase tracking-tight text-gray-700">
          <li>• Simplification</li>
          <li>• Percentage & Ratio</li>
          <li>• Area & Volume</li>
          <li>• Logical Reasoning</li>
        </ul>
      </div>

      <div class="flex flex-col items-center text-center px-6 md:border-l-2 md:border-[#1a202c]">
        <div class="text-[#d69e2e] text-6xl mb-4">🌍</div>
        <div class="font-black uppercase text-lg mb-4 border-b-2 border-black w-full pb-2">Language Section</div>
        <ul class="text-sm font-bold text-left w-full mt-2 space-y-2 uppercase tracking-tight text-gray-700">
          <li>• Grammar (இலக்கணம்)</li>
          <li>• Literature (இலக்கியம்)</li>
          <li>• Tamil Scholars</li>
          <li>• Translations</li>
        </ul>
      </div>

    </div>
  </div>

  <!-- COMPACT SYLLABUS GRID -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 animate-in max-w-6xl mx-auto" style="--stagger: 3">
    {parts.map(part => (
      <div class="flex flex-col gap-4">
        {part.units.map(unit => {
          const pct = Math.round((unit.questions / 200) * 100);
          return (
            <div class="compact-unit-card">
              <div class="compact-header">
                <span class="text-sm font-medium text-gray-700 mb-0.5">Unit {unit.num}</span>
                <span class="font-bold text-lg text-black leading-tight">{unit.title}</span>
              </div>
              <div class="compact-body">
                <div class="text-sm font-medium text-gray-800 mb-1 flex gap-4">
                  <span>Weight</span>
                  <span>{pct}%</span>
                </div>
                <div class="text-[13px] font-medium text-gray-600 mb-3 font-mono tracking-tight flex flex-wrap gap-x-2">
                  {unit.tags.map(tag => `#${tag}`)}
                </div>
                <ul class="compact-list">
                  {unit.topics.map(topic => (
                    <li>
                      <span class="text-[10px] mt-1 text-black">■</span> 
                      <span>{topic}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        })}
      </div>
    ))}

    <div class="flex flex-col gap-4">
      {tamilUnits.map(unit => {
        const pct = Math.round((unit.questions / 200) * 100);
        return (
          <div class="compact-unit-card">
            <div class="compact-header">
              <span class="text-sm font-medium text-gray-700 mb-0.5">அலகு {unit.num}</span>
              <span class="font-bold text-lg text-black leading-tight">{unit.title}</span>
            </div>
            <div class="compact-body">
              <div class="text-sm font-medium text-gray-800 mb-3 flex gap-4">
                <span>Weight</span>
                <span>{pct}%</span>
              </div>
              <ul class="compact-list">
                {unit.topics.map(topic => (
                  <li>
                    <span class="text-[10px] mt-1 text-black">■</span> 
                    <span>{topic}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )
      })}
    </div>
  </div>
</Layout>

<style>
  /* Interlocking Circles */
  .exam-circle {
    width: 140px; height: 140px;
    border-radius: 50%;
    border-width: 14px;
    border-style: solid;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: white;
    position: relative;
    z-index: 10;
  }
  .exam-circle.overlap-left {
    margin-left: -24px;
  }
  @media (max-width: 640px) {
    .exam-circle { width: 100px; height: 100px; border-width: 10px; }
    .exam-circle.overlap-left { margin-left: -16px; }
    .exam-circle .text-4xl { font-size: 1.5rem; }
    .exam-circle .text-3xl { font-size: 1.25rem; }
    .exam-circle .text-2xl { font-size: 1rem; }
    .exam-circle .text-xs { font-size: 0.6rem; }
  }

  /* Compact Cards */
  .compact-unit-card {
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #fafafa;
    overflow: hidden;
  }
  .compact-header {
    background-color: #f1f5f9;
    border-bottom: 1px solid #cbd5e1;
    padding: 10px 16px;
    display: flex;
    flex-direction: column;
    color: #0f172a;
  }
  .compact-body {
    padding: 14px 16px;
  }
  .compact-list {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 10px;
  }
  .compact-list li {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #334155;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
</style>
