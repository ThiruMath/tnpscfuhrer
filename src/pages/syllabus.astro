---
import Layout from '../layouts/Layout.astro';
import { parts, tamilUnits } from '../data/syllabus.ts';
---
<Layout title="TNPSC Group II & IIA Syllabus">
  <!-- HERO SECTION WITH ABSTRACT IMAGE -->
  <div class="syllabus-hero animate-in mb-8">
    <div class="hero-content">
      <div class="flex items-center gap-3 mb-3">
        <span class="badge badge-accent">Code 495</span>
        <span class="badge badge-neutral bg-white/20 text-white border-none">Updated Dec 2024</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">TNPSC Group II & IIA Syllabus</h1>
      <p class="text-white/80">Combined Civil Services Preliminary Examination Reference Guide.</p>
    </div>
  </div>

  <!-- EXAM SCHEME & WEIGHTAGE GRAPHS -->
  <div class="grid md:grid-cols-2 gap-6 mb-10 animate-in" style="--stagger: 1">
    
    <!-- EXAM SCHEME TABLE -->
    <div class="card bg-surface p-6 border border-border-subtle rounded-xl shadow-sm">
      <h3 class="text-lg font-bold mb-4">Exam Pattern (200 Qs / 300 Marks)</h3>
      <table class="w-full text-sm text-left">
        <thead class="text-xs uppercase bg-surface-sunken border-b border-border">
          <tr>
            <th class="px-4 py-3">Subject</th>
            <th class="px-4 py-3 text-center">Standard</th>
            <th class="px-4 py-3 text-center">Questions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <tr>
            <td class="px-4 py-3 font-medium">A. General Studies</td>
            <td class="px-4 py-3 text-center text-text-muted">Degree</td>
            <td class="px-4 py-3 text-center">75</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium">B. Aptitude</td>
            <td class="px-4 py-3 text-center text-text-muted">SSLC</td>
            <td class="px-4 py-3 text-center">25</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium">C. Language</td>
            <td class="px-4 py-3 text-center text-text-muted">SSLC</td>
            <td class="px-4 py-3 text-center">100</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- WEIGHTAGE GRAPHS -->
    <div class="card bg-surface p-6 border border-border-subtle rounded-xl shadow-sm">
      <h3 class="text-lg font-bold mb-4">Question Weightage</h3>
      <div class="flex flex-col gap-4">
        <!-- GS -->
        <div>
          <div class="flex justify-between text-sm font-medium mb-1">
            <span>General Studies (75 Qs)</span>
            <span class="text-accent">37.5%</span>
          </div>
          <div class="h-3 w-full bg-surface-sunken rounded-full overflow-hidden">
            <div class="h-full bg-accent rounded-full" style="width: 37.5%"></div>
          </div>
        </div>
        <!-- Aptitude -->
        <div>
          <div class="flex justify-between text-sm font-medium mb-1">
            <span>Aptitude (25 Qs)</span>
            <span class="text-purple">12.5%</span>
          </div>
          <div class="h-3 w-full bg-surface-sunken rounded-full overflow-hidden">
            <div class="h-full bg-purple rounded-full" style="width: 12.5%"></div>
          </div>
        </div>
        <!-- Language -->
        <div>
          <div class="flex justify-between text-sm font-medium mb-1">
            <span>Language (100 Qs)</span>
            <span class="text-green">50.0%</span>
          </div>
          <div class="h-3 w-full bg-surface-sunken rounded-full overflow-hidden">
            <div class="h-full bg-green rounded-full" style="width: 50%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex gap-2 mb-6 overflow-x-auto pb-2 animate-in" style="--stagger: 2">
    <button class="syl-tab active" data-target="all">All Parts</button>
    {parts.map(p => (
      <button class="syl-tab" data-target={p.id}>{p.title}</button>
    ))}
    <button class="syl-tab" data-target="lang">Part C: Language</button>
  </div>

  {parts.map((part, index) => (
    <section id={part.id} class="syl-part animate-in" style={`--stagger: ${3 + index}`}>
      <div class="syl-part-header">
        <div>
          <h2 class="text-xl font-bold mb-1">{part.title}</h2>
          <div class="text-sm text-text-muted">{part.standard} • {part.total} Questions</div>
        </div>
      </div>

      <div class="syl-units">
        {part.units.map(unit => (
          <div class="syl-unit">
            <div class="syl-unit-top">
              <div class="flex items-center gap-3">
                <span class="syl-unit-num bg-surface-raised border border-border">Unit {unit.num}</span>
                <h3 class="text-base font-bold m-0">{unit.title}</h3>
              </div>
              <div class="badge badge-neutral text-xs">
                {unit.questions} Questions
              </div>
            </div>
            
            <ul class="syl-topics">
              {unit.topics.map(topic => (
                <li class="syl-topic">
                  <span class="syl-topic-bullet">•</span>
                  <span class="syl-topic-text">{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section id="lang" class="syl-part animate-in" style="--stagger: 6">
    <div class="syl-part-header">
      <div>
        <h2 class="text-xl font-bold mb-1">Part C: Language</h2>
        <div class="text-sm text-text-muted">SSLC Standard • 100 Questions</div>
      </div>
    </div>

    <div class="flex gap-2 mb-4">
      <button class="lang-tab active" data-lang="tamil">General Tamil</button>
      <button class="lang-tab" data-lang="english" disabled title="Coming soon">General English (Soon)</button>
    </div>

    <div class="lang-panel" data-lang-panel="tamil">
      <div class="syl-units">
        {tamilUnits.map(unit => (
          <div class="syl-unit">
            <div class="syl-unit-top">
              <div class="flex items-center gap-3">
                <span class="syl-unit-num bg-surface-raised border border-border">அலகு {unit.num}</span>
                <h3 class="text-base font-bold m-0">{unit.title}</h3>
              </div>
              <div class="badge badge-neutral text-xs">
                {unit.questions} Questions
              </div>
            </div>
            <ul class="syl-topics">
              {unit.topics.map(topic => (
                <li class="syl-topic">
                  <span class="syl-topic-bullet">•</span>
                  <span class="syl-topic-text">{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Image styling */
  .syllabus-hero {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-image: url('/images/syllabus-bg.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: var(--space-12) var(--space-8);
    box-shadow: var(--shadow-md);
  }
  .syllabus-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.8), rgba(0,0,0,0.3));
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }

  /* Colors for graphs */
  .bg-purple { background-color: var(--purple, #9333ea); }
  .bg-green { background-color: var(--green, #16a34a); }
  .text-purple { color: var(--purple, #9333ea); }
  .text-green { color: var(--green, #16a34a); }

  /* Part header */
  .syl-part { margin-bottom: var(--space-8); }
  .syl-part-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-4);
  }

  /* Tabs */
  .syl-tab, .lang-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .syl-tab:hover, .lang-tab:hover { border-color: var(--border-hover); color: var(--text); }
  .syl-tab.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }
  .lang-tab.active { background: var(--purple, #9333ea); color: white; border-color: var(--purple, #9333ea); }

  /* Unit cards */
  .syl-units { display: flex; flex-direction: column; gap: var(--space-4); }
  .syl-unit {
    background: var(--surface-sunken);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--duration-normal) var(--ease-out);
  }
  .syl-unit:hover { background: var(--surface); box-shadow: var(--shadow-sm); border-color: var(--border-subtle); }
  .syl-unit-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }
  .syl-unit-num {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-xs);
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Topics without checkboxes */
  .syl-topics { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  .syl-topic { 
    font-size: 0.875rem; 
    display: flex; 
    align-items: flex-start; 
    gap: var(--space-3); 
  }
  .syl-topic-bullet {
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .syl-topic-text { 
    line-height: 1.6; 
    color: var(--text-secondary); 
  }

  @media (max-width: 768px) {
    .syl-units { padding-left: 0; }
  }
</style>

<script>
  // === Tab filtering ===
  document.querySelectorAll('.syl-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.syl-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = (btn as HTMLElement).dataset.target;
      document.querySelectorAll('.syl-part').forEach(s => {
        const el = s as HTMLElement;
        if (target === 'all') { el.style.display = ''; }
        else { el.style.display = el.id === target ? '' : 'none'; }
      });
    });
  });

  // === Language toggle (Part C) ===
  document.querySelectorAll('.lang-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.lang-panel').forEach(p => {
        const el = p as HTMLElement;
        el.style.display = el.dataset.langPanel === lang ? '' : 'none';
      });
    });
  });
</script>
