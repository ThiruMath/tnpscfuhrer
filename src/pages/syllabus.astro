---
import Layout from '../layouts/Layout.astro';
import { parts, tamilUnits } from '../data/syllabus.ts';
---
<Layout title="TNPSC Group II & IIA Syllabus">
  <div class="page-header animate-in">
    <div class="flex items-center gap-3 mb-3">
      <span class="badge badge-accent">Code 495</span>
      <span class="badge badge-neutral">Updated Dec 2024</span>
    </div>
    <h1>TNPSC Group II & IIA Syllabus</h1>
    <p>Combined Civil Services Preliminary Examination — track your progress, check linked notes, and stay focused.</p>
  </div>

  <!-- EXAM SCHEME -->
  <div class="card bg-surface-sunken p-6 mb-8 border border-border-subtle rounded-xl animate-in" style="--stagger: 1">
    <h3 class="text-lg font-bold mb-4">Exam Pattern (Revised 2024)</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left mb-6">
        <thead class="text-xs uppercase bg-surface border-b border-border">
          <tr>
            <th class="px-4 py-3">Prelims (Group II & IIA)</th>
            <th class="px-4 py-3">Standard</th>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3 text-center">Questions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <tr>
            <td class="px-4 py-3 font-medium">A. General Studies</td>
            <td class="px-4 py-3 text-text-muted">Degree</td>
            <td class="px-4 py-3 text-text-muted">Objective</td>
            <td class="px-4 py-3 text-center">75</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium">B. Aptitude & Mental Ability</td>
            <td class="px-4 py-3 text-text-muted">SSLC</td>
            <td class="px-4 py-3 text-text-muted">Objective</td>
            <td class="px-4 py-3 text-center">25</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium">C. Language (Tamil or English)</td>
            <td class="px-4 py-3 text-text-muted">SSLC</td>
            <td class="px-4 py-3 text-text-muted">Objective</td>
            <td class="px-4 py-3 text-center">100</td>
          </tr>
          <tr class="bg-surface font-bold">
            <td colspan="3" class="px-4 py-3 text-right">Total (300 Marks)</td>
            <td class="px-4 py-3 text-center text-accent">200</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ANALYTICS DASHBOARD -->
  <div class="card p-6 mb-8 border border-border-subtle rounded-xl animate-in" style="--stagger: 2">
    <h3 class="text-lg font-bold mb-4 flex items-center justify-between">
      <span>Deep Analytics</span>
      <span id="global-progress-text" class="text-sm font-medium text-accent">0% Complete</span>
    </h3>
    
    <div class="grid grid-3 gap-6 mb-2">
      <div class="analytics-card">
        <div class="analytics-title">General Studies (75 Qs)</div>
        <div class="analytics-value" id="gs-mastery">0%</div>
        <div class="syl-progress-track mt-2"><div class="syl-progress-fill bg-accent" id="gs-bar"></div></div>
      </div>
      <div class="analytics-card">
        <div class="analytics-title">Aptitude (25 Qs)</div>
        <div class="analytics-value" id="aptitude-mastery">0%</div>
        <div class="syl-progress-track mt-2"><div class="syl-progress-fill bg-purple" id="aptitude-bar"></div></div>
      </div>
      <div class="analytics-card">
        <div class="analytics-title">Language (100 Qs)</div>
        <div class="analytics-value" id="language-mastery">0%</div>
        <div class="syl-progress-track mt-2"><div class="syl-progress-fill bg-green" id="language-bar"></div></div>
      </div>
    </div>
  </div>

  <div class="flex gap-2 mb-6 overflow-x-auto pb-2 animate-in" style="--stagger: 3">
    <button class="syl-tab active" data-target="all">All Parts</button>
    {parts.map(p => (
      <button class="syl-tab" data-target={p.id}>{p.title}</button>
    ))}
    <button class="syl-tab" data-target="lang">Part C: Language</button>
  </div>

  {parts.map(part => (
    <section id={part.id} class="syl-part animate-in" style="--stagger: 4">
      <div class="syl-part-header">
        <div>
          <h2 class="text-xl font-bold mb-1">{part.title}</h2>
          <div class="text-sm text-text-muted">{part.standard} • {part.total} Questions</div>
        </div>
        <div class="text-right">
          <div class="text-sm font-medium mb-1 text-accent" id={`part-${part.id}-progress`}>0%</div>
        </div>
      </div>

      <div class="syl-units">
        {part.units.map(unit => (
          <div class="syl-unit">
            <div class="syl-unit-top">
              <div class="flex items-center gap-3">
                <span class="syl-unit-num bg-surface-raised border border-border">Unit {unit.num}</span>
                <h3 class="text-base font-bold m-0">{unit.title}</h3>
              </div>
              <div class="text-sm font-medium text-text-muted">
                <span id={`u-${part.id}-${unit.num}`}>0/{unit.topics.length}</span>
              </div>
            </div>
            
            <div class="syl-progress-track">
              <div class="syl-progress-fill bg-accent" id={`bar-${part.id}-${unit.num}`}></div>
            </div>

            <ul class="syl-topics">
              {unit.topics.map((topic, i) => (
                <li class="syl-topic">
                  <label class="syl-check-label">
                    <input type="checkbox" class="syl-checkbox" data-id={`cb-${part.id}-${unit.num}-${i}`} data-part={part.id} data-unit={unit.num} />
                    <div class="syl-check-box"></div>
                    <span class="syl-topic-text">{topic}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section id="lang" class="syl-part animate-in" style="--stagger: 5">
    <div class="syl-part-header">
      <div>
        <h2 class="text-xl font-bold mb-1">Part C: Language</h2>
        <div class="text-sm text-text-muted">SSLC Standard • 100 Questions</div>
      </div>
      <div class="text-right">
        <div class="text-sm font-medium mb-1 text-accent" id="part-language-progress">0%</div>
      </div>
    </div>

    <div class="flex gap-2 mb-4">
      <button class="lang-tab active" data-lang="tamil">General Tamil</button>
      <button class="lang-tab" data-lang="english" disabled title="Coming soon">General English (Soon)</button>
    </div>

    <div class="lang-panel" data-lang-panel="tamil">
      <div class="syl-units">
        {tamilUnits.map(unit => (
          <div class="syl-unit">
            <div class="syl-unit-top">
              <div class="flex items-center gap-3">
                <span class="syl-unit-num bg-surface-raised border border-border">அலகு {unit.num}</span>
                <h3 class="text-base font-bold m-0">{unit.title}</h3>
              </div>
              <div class="text-sm font-medium text-text-muted">
                <span id={`u-language-${unit.num}`}>0/{unit.topics.length}</span>
              </div>
            </div>
            <div class="syl-progress-track">
              <div class="syl-progress-fill bg-green" id={`bar-language-${unit.num}`}></div>
            </div>
            <ul class="syl-topics">
              {unit.topics.map((topic, i) => (
                <li class="syl-topic">
                  <label class="syl-check-label">
                    <input type="checkbox" class="syl-checkbox" data-id={`cb-language-${unit.num}-${i}`} data-part="language" data-unit={unit.num} />
                    <div class="syl-check-box"></div>
                    <span class="syl-topic-text">{topic}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Analytics styles */
  .analytics-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: center;
  }
  .analytics-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: var(--space-2); }
  .analytics-value { font-size: 2rem; font-weight: 800; color: var(--text); }
  .bg-purple { background-color: var(--purple, #9333ea); }
  .bg-green { background-color: var(--green, #16a34a); }

  /* Part header */
  .syl-part { margin-bottom: var(--space-8); }
  .syl-part-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: var(--space-4);
  }
  /* Tabs */
  .syl-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .syl-tab:hover { border-color: var(--border-hover); color: var(--text); }
  .syl-tab.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }

  .lang-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .lang-tab.active { background: var(--purple, #9333ea); color: white; border-color: var(--purple, #9333ea); }

  /* Unit cards */
  .syl-units { display: flex; flex-direction: column; gap: var(--space-4); }
  .syl-unit {
    background: var(--surface-sunken);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--duration-normal) var(--ease-out);
  }
  .syl-unit:hover { background: var(--surface); box-shadow: var(--shadow-sm); border-color: var(--border-subtle); }
  .syl-unit-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .syl-unit-num {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-xs);
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Progress */
  .syl-progress-track {
    height: 4px; background: var(--surface); border-radius: 2px;
    margin-bottom: var(--space-4); overflow: hidden;
  }
  .syl-progress-fill {
    height: 100%; width: 0%; border-radius: 2px;
    transition: width 0.5s var(--ease-out);
  }

  /* Topics */
  .syl-topics { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  .syl-topic { font-size: 0.875rem; }
  .syl-check-label {
    display: flex; align-items: flex-start; gap: var(--space-3); cursor: pointer;
    padding: var(--space-2) 0;
  }
  .syl-checkbox { display: none; }
  .syl-check-box {
    width: 18px; height: 18px; flex-shrink: 0;
    border: 2px solid var(--border-hover);
    border-radius: var(--radius-xs);
    display: flex; align-items: center; justify-content: center;
    transition: all var(--duration-fast);
    margin-top: 1px;
    position: relative;
  }
  .syl-checkbox:checked + .syl-check-box {
    background: var(--check-color, #2563eb);
    border-color: var(--check-color, #2563eb);
  }
  .syl-checkbox:checked + .syl-check-box::after {
    content: '';
    width: 5px; height: 9px;
    border: solid white; border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px;
  }
  .syl-checkbox:checked ~ .syl-topic-text {
    text-decoration: line-through;
    color: var(--text-faint);
  }
  .syl-topic-text { line-height: 1.5; color: var(--text-secondary); }

  @media (max-width: 768px) {
    .syl-units { padding-left: 0; }
    .syl-unit-top { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
    .grid-3 { grid-template-columns: 1fr; }
  }
</style>

<script>
  // === Tab filtering ===
  document.querySelectorAll('.syl-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.syl-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = (btn as HTMLElement).dataset.target;
      document.querySelectorAll('.syl-part').forEach(s => {
        const el = s as HTMLElement;
        if (target === 'all') { el.style.display = ''; }
        else { el.style.display = el.id === target ? '' : 'none'; }
      });
    });
  });

  // === Language toggle (Part C) ===
  document.querySelectorAll('.lang-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.lang-panel').forEach(p => {
        const el = p as HTMLElement;
        el.style.display = el.dataset.langPanel === lang ? '' : 'none';
      });
    });
  });

  // === Checkbox persistence & progress ===
  const allBoxes = document.querySelectorAll('.syl-checkbox') as NodeListOf<HTMLInputElement>;

  // Restore state
  allBoxes.forEach(cb => {
    const id = cb.dataset.id!;
    if (localStorage.getItem(id) === 'true') cb.checked = true;
  });

  // Save & update on change
  allBoxes.forEach(cb => {
    cb.addEventListener('change', () => {
      localStorage.setItem(cb.dataset.id!, cb.checked.toString());
      updateProgress();
    });
  });

  function updateProgress() {
    // Per-unit progress
    const unitMap: Record<string, { done: number; total: number }> = {};
    allBoxes.forEach(cb => {
      const key = `${cb.dataset.part}-${cb.dataset.unit}`;
      if (!unitMap[key]) unitMap[key] = { done: 0, total: 0 };
      unitMap[key].total++;
      if (cb.checked) unitMap[key].done++;
    });

    for (const [key, { done, total }] of Object.entries(unitMap)) {
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      const bar = document.getElementById(`bar-${key}`);
      const text = document.getElementById(`u-${key}`);
      if (bar) bar.style.width = `${pct}%`;
      if (text) text.textContent = `${done}/${total}`;
    }

    // Per-part progress (gs, aptitude, language)
    const partMap: Record<string, { done: number; total: number }> = {};
    allBoxes.forEach(cb => {
      const partId = cb.dataset.part!;
      if (!partMap[partId]) partMap[partId] = { done: 0, total: 0 };
      partMap[partId].total++;
      if (cb.checked) partMap[partId].done++;
    });

    for (const [partId, { done, total }] of Object.entries(partMap)) {
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      const el = document.getElementById(`part-${partId}-progress`);
      if (el) el.textContent = `${pct}% Complete`;
      
      // Update Analytics Dashboard
      const mastery = document.getElementById(`${partId}-mastery`);
      const bar = document.getElementById(`${partId}-bar`);
      if (mastery) mastery.textContent = `${pct}%`;
      if (bar) bar.style.width = `${pct}%`;
    }

    // Global progress
    let totalDone = 0;
    let totalAll = 0;
    allBoxes.forEach(cb => { totalAll++; if (cb.checked) totalDone++; });
    const globalPct = totalAll > 0 ? Math.round((totalDone / totalAll) * 100) : 0;
    const gText = document.getElementById('global-progress-text');
    if (gText) {
      if (globalPct === 100) gText.textContent = `🎯 100% Mastered!`;
      else gText.textContent = `${globalPct}% Overall Complete`;
    }
  }

  // Initialize progress on load
  document.addEventListener("DOMContentLoaded", () => {
    updateProgress();
  });
  // Execute immediately just in case
  updateProgress();
</script>
