import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');

function findRelatedNotes(keywords: string[]) {
  return allNotes
    .filter(note => {
      const titleLower = note.slug.toLowerCase().replace(/-/g, ' ');
      const bodyLower = (note.body || '').toLowerCase().slice(0, 500);
      return keywords.some(kw => titleLower.includes(kw) || bodyLower.includes(kw));
    })
    .slice(0, 4)
    .map(n => ({ title: n.data.title || n.slug.replace(/-/g, ' '), slug: n.slug }));
}

// Syllabus Data — same data, reused from original
const parts = [
  {
    id: "A", name: "General Studies", standard: "Degree Standard", total: 75,
    color: "var(--accent)", colorSoft: "var(--accent-soft)",
    units: [
      { num: "I", title: "General Science", questions: 5, tags: ["science","physics","chemistry","biology"], topics: ["Scientific knowledge and scientific temper", "Power of reasoning - Rote learning vs conceptual learning", "Science as a tool to understand past, present, future", "Nature of universe - General scientific laws", "Mechanics - Properties of matter, force, motion, energy", "Everyday application of mechanics, electricity, magnetism, light, sound, heat, nuclear physics, laser, electronics, communications", "Elements and compounds, acids, bases, salts", "Petroleum products, fertilizers, pesticides", "Main concepts of life science, classification of living organisms", "Evolution, genetics, physiology, nutrition, health, hygiene, human diseases", "Environment and ecology", "Latest inventions in science and technology", "Current affairs"] },
      { num: "II", title: "Geography of India", questions: 5, tags: ["geography","monsoon","climate","rivers"], topics: ["Location - Physical features", "Monsoon, rainfall, weather and climate", "Water resources - Rivers in India", "Soil, Minerals and Natural Resources", "Forest and Wildlife - Agricultural pattern", "Transport - Communication", "Social Geography - Population density and distribution", "Racial, linguistic groups and major tribes", "Natural calamity - Disaster management", "Environmental pollution - Reasons and preventive measures", "Climate change - Green energy", "Geographical landmarks", "Current affairs"] },
      { num: "III", title: "History, Culture of India & Indian National Movement", questions: 10, tags: ["history","culture","national movement","leaders"], topics: ["Indus Valley Civilization", "Guptas, Delhi Sultans, Mughals, and Marathas", "Age of Vijayanagaram and Bahmani Kingdoms", "South Indian History", "National Renaissance - Early uprising against British rule", "Indian National Congress - Emergence of leaders", "Different modes of agitation: Satyagraha and Militant Movements", "Communalism and Partition", "Change and continuity in socio-cultural history of India", "Characteristics of Indian Culture, Unity in Diversity", "India as a secular state, Social harmony", "Prominent personalities in Arts, Science, Literature, Philosophy"] },
      { num: "IV", title: "Indian Polity", questions: 15, tags: ["polity","constitution","rights","government"], topics: ["Constitution of India - Preamble", "Salient features of the Constitution", "Union, State and Union Territory", "Citizenship, Fundamental Rights & Duties", "Directive Principles of State Policy", "Union Executive, Union Legislature", "State Executive, State Legislature", "Local Governments, Panchayat Raj", "Spirit of federalism: Centre - State relationships", "Election - Judiciary in India - Rule of Law", "Corruption in public life - Anti-corruption measures", "Lokpal and Lok Ayukta - Right to Information", "Empowerment of Women", "Consumer Protection Forums, Human Rights Charter", "Political parties and political system in India", "Current affairs"] },
      { num: "V", title: "Indian Economy and Development Administration in TN", questions: 20, tags: ["economy","development","tamil nadu","welfare","planning"], topics: [
        "Nature of Indian Economy - Five-year plan models", 
