---
import Layout from '../layouts/Layout.astro';
import { parts, tamilUnits } from '../data/syllabus.ts';
---
<Layout title="TNPSC Group II & IIA Syllabus - Dashboard">
  <!-- DASHBOARD HEADER -->
  <div class="mb-8 border-b border-border-subtle pb-6 pt-4 animate-in">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="badge badge-accent">Code 495</span>
          <span class="text-sm font-medium text-text-muted">Updated Dec 2024</span>
        </div>
        <h1 class="text-3xl font-bold">Syllabus Dashboard</h1>
        <p class="text-text-muted">Combined Civil Services Preliminary Examination</p>
      </div>
    </div>
  </div>

  <!-- KPI CARDS (Dashboard style) -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 animate-in" style="--stagger: 1">
    <div class="dash-kpi">
      <div class="kpi-label">Total Questions</div>
      <div class="kpi-value text-text">200</div>
      <div class="kpi-sub">300 Marks Total</div>
    </div>
    <div class="dash-kpi">
      <div class="kpi-label">General Studies</div>
      <div class="kpi-value text-accent">75</div>
      <div class="kpi-sub">Degree Standard</div>
    </div>
    <div class="dash-kpi">
      <div class="kpi-label">Aptitude</div>
      <div class="kpi-value text-purple">25</div>
      <div class="kpi-sub">SSLC Standard</div>
    </div>
    <div class="dash-kpi">
      <div class="kpi-label">Language</div>
      <div class="kpi-value text-green">100</div>
      <div class="kpi-sub">SSLC Standard</div>
    </div>
  </div>

  <!-- EXAM SCHEME TABLE -->
  <div class="card bg-surface border border-border-subtle rounded-xl p-0 overflow-hidden mb-10 animate-in shadow-sm" style="--stagger: 2">
    <div class="px-6 py-4 border-b border-border-subtle bg-surface-sunken">
      <h3 class="font-bold text-sm uppercase tracking-wider text-text-muted">Exam Pattern Breakdown</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="text-xs uppercase bg-surface border-b border-border">
          <tr>
            <th class="px-6 py-3 min-w-[200px]">Subject</th>
            <th class="px-6 py-3 text-center">Standard</th>
            <th class="px-6 py-3 text-center">Questions</th>
            <th class="px-6 py-3 min-w-[150px]">Weightage</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <tr>
            <td class="px-6 py-4 font-medium">A. General Studies</td>
            <td class="px-6 py-4 text-center text-text-muted">Degree</td>
            <td class="px-6 py-4 text-center font-bold">75</td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="h-2 flex-1 bg-surface-sunken rounded-full"><div class="h-full bg-accent rounded-full" style="width: 37.5%"></div></div>
                <span class="text-xs font-bold text-right w-8">37.5%</span>
              </div>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 font-medium">B. Aptitude & Mental Ability</td>
            <td class="px-6 py-4 text-center text-text-muted">SSLC</td>
            <td class="px-6 py-4 text-center font-bold">25</td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="h-2 flex-1 bg-surface-sunken rounded-full"><div class="h-full bg-purple rounded-full" style="width: 12.5%"></div></div>
                <span class="text-xs font-bold text-right w-8">12.5%</span>
              </div>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4 font-medium">C. Language (Tamil or English)</td>
            <td class="px-6 py-4 text-center text-text-muted">SSLC</td>
            <td class="px-6 py-4 text-center font-bold">100</td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="h-2 flex-1 bg-surface-sunken rounded-full"><div class="h-full bg-green rounded-full" style="width: 50%"></div></div>
                <span class="text-xs font-bold text-right w-8">50%</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex gap-2 mb-6 overflow-x-auto pb-2 animate-in" style="--stagger: 3">
    <button class="syl-tab active" data-target="all">All Parts</button>
    {parts.map(p => (
      <button class="syl-tab" data-target={p.id}>{p.title}</button>
    ))}
    <button class="syl-tab" data-target="lang">Part C: Language</button>
  </div>

  <!-- DASHBOARD SYLLABUS LIST -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 animate-in" style="--stagger: 4">
    {parts.map(part => (
      <section id={part.id} class="syl-part flex flex-col gap-6">
        <div class="flex items-center justify-between border-b border-border pb-2">
          <h2 class="text-xl font-bold">{part.title}</h2>
          <span class="badge badge-neutral">{part.total} Qs</span>
        </div>
        
        {part.units.map(unit => {
          const colorClass = part.id === 'gs' ? 'bg-accent' : 'bg-purple';
          const pct = (unit.questions / part.total) * 100;
          return (
            <div class="dash-unit-card">
              <div class="dash-unit-header">
                <div>
                  <div class="text-xs font-bold text-text-muted uppercase tracking-wider mb-1">Unit {unit.num}</div>
                  <h3 class="text-base font-bold m-0 leading-tight pr-4">{unit.title}</h3>
                </div>
                <div class="text-right flex-shrink-0">
                  <div class="text-2xl font-black leading-none mb-1 text-text">{unit.questions}</div>
                  <div class="text-[10px] uppercase text-text-muted font-bold tracking-widest">Questions</div>
                </div>
              </div>
              <div class="px-5 pb-5 pt-3">
                <div class="flex items-center gap-3 mb-5 bg-surface-sunken p-2 rounded-lg border border-border-subtle">
                  <span class="text-xs text-text-muted font-bold w-16 uppercase tracking-wider text-center">Weight</span>
                  <div class="h-1.5 flex-1 bg-surface rounded-full overflow-hidden">
                    <div class={`h-full ${colorClass} rounded-full`} style={`width: ${pct}%`}></div>
                  </div>
                  <span class="text-xs font-bold w-10 text-right">{Math.round(pct)}%</span>
                </div>
                
                <div class="flex flex-wrap gap-2 mb-5">
                  {unit.tags.map(tag => (
                    <span class="text-[10px] font-bold px-2 py-1 bg-surface-raised border border-border-subtle rounded text-text-muted uppercase">#{tag}</span>
                  ))}
                </div>
                
                <ul class="flex flex-col gap-3">
                  {unit.topics.map(topic => (
                    <li class="flex gap-3 text-sm text-text-secondary leading-relaxed">
                      <span class="text-text-muted mt-0.5 text-xs">■</span>
                      <span>{topic}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        })}
      </section>
    ))}

    <section id="lang" class="syl-part flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-border pb-2">
        <h2 class="text-xl font-bold">Part C: Language</h2>
        <span class="badge badge-neutral">100 Qs</span>
      </div>

      <div class="flex gap-2 mb-2">
        <button class="lang-tab active" data-lang="tamil">General Tamil</button>
        <button class="lang-tab" data-lang="english" disabled title="Coming soon">General English (Soon)</button>
      </div>

      <div class="lang-panel flex flex-col gap-6" data-lang-panel="tamil">
        {tamilUnits.map(unit => {
          const pct = (unit.questions / 100) * 100;
          return (
            <div class="dash-unit-card">
              <div class="dash-unit-header">
                <div>
                  <div class="text-xs font-bold text-text-muted uppercase tracking-wider mb-1">அலகு {unit.num}</div>
                  <h3 class="text-base font-bold m-0 leading-tight pr-4">{unit.title}</h3>
                </div>
                <div class="text-right flex-shrink-0">
                  <div class="text-2xl font-black leading-none mb-1 text-text">{unit.questions}</div>
                  <div class="text-[10px] uppercase text-text-muted font-bold tracking-widest">Questions</div>
                </div>
              </div>
              <div class="px-5 pb-5 pt-3">
                <div class="flex items-center gap-3 mb-5 bg-surface-sunken p-2 rounded-lg border border-border-subtle">
                  <span class="text-xs text-text-muted font-bold w-16 uppercase tracking-wider text-center">Weight</span>
                  <div class="h-1.5 flex-1 bg-surface rounded-full overflow-hidden">
                    <div class="h-full bg-green rounded-full" style={`width: ${pct}%`}></div>
                  </div>
                  <span class="text-xs font-bold w-10 text-right">{Math.round(pct)}%</span>
                </div>
                <ul class="flex flex-col gap-3">
                  {unit.topics.map(topic => (
                    <li class="flex gap-3 text-sm text-text-secondary leading-relaxed">
                      <span class="text-text-muted mt-0.5 text-xs">■</span>
                      <span>{topic}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        })}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* KPI Cards */
  .dash-kpi {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }
  .kpi-label { font-size: 0.75rem; text-transform: uppercase; font-weight: 800; color: var(--text-muted); margin-bottom: var(--space-2); letter-spacing: 0.05em; }
  .kpi-value { font-size: 2.25rem; font-weight: 900; line-height: 1; margin-bottom: var(--space-2); }
  .kpi-sub { font-size: 0.75rem; font-weight: 600; color: var(--text-faint); }

  /* Colors */
  .bg-purple { background-color: var(--purple, #9333ea); }
  .bg-green { background-color: var(--green, #16a34a); }
  .text-purple { color: var(--purple, #9333ea); }
  .text-green { color: var(--green, #16a34a); }

  /* Unit Cards */
  .dash-unit-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-normal);
  }
  .dash-unit-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--border-hover);
  }
  .dash-unit-header {
    background: var(--surface-sunken);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  /* Tabs */
  .syl-tab, .lang-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 600;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .syl-tab:hover, .lang-tab:hover { border-color: var(--border-hover); color: var(--text); }
  .syl-tab.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }
  .lang-tab.active { background: var(--green, #16a34a); color: white; border-color: var(--green, #16a34a); }
</style>

<script>
  // === Tab filtering ===
  document.querySelectorAll('.syl-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.syl-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = (btn as HTMLElement).dataset.target;
      document.querySelectorAll('.syl-part').forEach(s => {
        const el = s as HTMLElement;
        if (target === 'all') { el.style.display = ''; }
        else { el.style.display = el.id === target ? '' : 'none'; }
      });
    });
  });

  // === Language toggle ===
  document.querySelectorAll('.lang-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.lang-panel').forEach(p => {
        const el = p as HTMLElement;
        el.style.display = el.dataset.langPanel === lang ? '' : 'none';
      });
    });
  });
</script>
