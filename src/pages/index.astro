---
import Layout from '../layouts/Layout.astro';

const upcomingExams = [
  { name: 'CTS (Non-Interview)', date: '2026-08-22', status: 'Open', posts: 'Asst Geologist, AE, Drug Inspector', vacancies: '461' },
  { name: 'Group IV (CSSE-IV)', date: '2026-09-21', status: 'Tentative', posts: 'VAO, Junior Assistant, Typist', vacancies: '9,351' },
  { name: 'Group I Prelims', date: '2026-11-15', status: 'Tentative', posts: 'Deputy Collector, DSP', vacancies: '92' },
];

function daysUntil(d: string): number {
  return Math.max(0, Math.ceil((new Date(d).getTime() - Date.now()) / 86400000));
}

const nextExam = upcomingExams[0];
const nextDays = daysUntil(nextExam.date);
---

<Layout title="Dashboard" active="Dashboard">

  <!-- Greeting -->
  <div class="mb-8 animate-in">
    <h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.25rem;">
      Today's Mission
    </h1>
    <p class="text-secondary" style="font-size: 0.95rem;">
      <span class="text-mono" style="color: var(--accent); font-weight: 600;">{nextDays} days</span> until {nextExam.name}. Here's your study plan.
    </p>
  </div>

  <!-- Stat Cards -->
  <div class="grid grid-4 mb-6 stagger">
    <div class="stat-card" style="border-top: 3px solid var(--accent);">
      <div class="stat-label">
        <svg style="width:14px;height:14px;stroke:var(--accent);" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Next Exam
      </div>
      <div class="stat-value" style="color: var(--accent);" id="cd-days">{nextDays}</div>
      <div class="stat-footer">days remaining</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">
        <svg style="width:14px;height:14px;stroke:var(--blue);" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Study Notes
      </div>
      <div class="stat-value">900+</div>
      <div class="stat-footer">across all subjects</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">
        <svg style="width:14px;height:14px;stroke:var(--green);" viewBox="0 0 24 24"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>
        PYQ Solved
      </div>
      <div class="stat-value">120+</div>
      <div class="stat-footer"><span class="stat-trend trend-up">↑ 12</span> this week</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">
        <svg style="width:14px;height:14px;stroke:var(--purple);" viewBox="0 0 24 24"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
        Syllabus
      </div>
      <div class="stat-value" id="coverage-pct">0%</div>
      <div class="stat-footer">topics covered</div>
    </div>
  </div>

  <!-- Main grid -->
  <div class="grid grid-2-1 mb-6">
    <!-- Left column -->
    <div class="stack">

      <!-- Countdown card (solid accent) -->
      <div class="card card-solid animate-in" style="animation-delay: 100ms;">
        <div class="card-header">
          <span class="card-title">Exam Countdown</span>
          <a href="/calendar" class="card-action">Calendar →</a>
        </div>
        <p style="font-size: 0.85rem; opacity: 0.85; margin-bottom: var(--space-2);">
          {nextExam.name}
        </p>
        <div class="cd-timer" style="display: flex; gap: var(--space-6); margin: var(--space-4) 0;">
          <div class="cd-unit">
            <span class="cd-val text-mono" id="cd-days-lg">{nextDays}</span>
            <span class="cd-label">Days</span>
          </div>
          <div class="cd-unit">
            <span class="cd-val text-mono" id="cd-hours">00</span>
            <span class="cd-label">Hrs</span>
          </div>
          <div class="cd-unit">
            <span class="cd-val text-mono" id="cd-mins">00</span>
            <span class="cd-label">Min</span>
          </div>
          <div class="cd-unit">
            <span class="cd-val text-mono" id="cd-secs">00</span>
            <span class="cd-label">Sec</span>
          </div>
        </div>
        <a href="/syllabus" style="display: inline-flex; align-items: center; gap: var(--space-2); background: rgba(255,255,255,0.18); color: white; padding: var(--space-3) var(--space-5); border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 500; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15);">
          Start studying →
        </a>
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-2 animate-in" style="animation-delay: 200ms;">
        <a href="/notes" class="card card-interactive" style="text-decoration: none;">
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
            <div style="width: 40px; height: 40px; background: var(--blue-soft); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <svg style="width:20px;height:20px;stroke:var(--blue);fill:none;stroke-width:1.75;" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div>
              <div style="font-weight: 600; font-size: 0.95rem;">Continue Study</div>
              <div class="text-muted" style="font-size: 0.8rem;">Pick up where you left off</div>
            </div>
          </div>
        </a>
        <a href="/revision" class="card card-interactive" style="text-decoration: none;">
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
            <div style="width: 40px; height: 40px; background: var(--amber-soft); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <svg style="width:20px;height:20px;stroke:var(--amber);fill:none;stroke-width:1.75;" viewBox="0 0 24 24"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            </div>
            <div>
              <div style="font-weight: 600; font-size: 0.95rem;">Daily Revision</div>
              <div class="text-muted" style="font-size: 0.8rem;">15 AI-generated questions</div>
            </div>
          </div>
        </a>
      </div>

      <!-- Upcoming Exams Table -->
      <div class="card animate-in" style="animation-delay: 300ms;">
        <div class="card-header">
          <span class="card-title">Upcoming Exams</span>
          <a href="/calendar" class="card-action">View all →</a>
        </div>
        <table class="table">
          <thead>
            <tr>
              <th>Exam</th>
              <th>Date</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {upcomingExams.map(exam => (
              <tr>
                <td>
                  <div style="font-weight: 600;">{exam.name}</div>
                  <div class="text-muted" style="font-size: 0.78rem;">{exam.posts}</div>
                </td>
                <td>
                  <div style="font-weight: 500; font-family: var(--font-mono); font-size: 0.85rem;">
                    {new Date(exam.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </div>
                  <div class="text-accent" style="font-size: 0.75rem; font-weight: 600;">{daysUntil(exam.date)}d left</div>
                </td>
                <td>
                  <span class={`badge ${exam.status === 'Open' ? 'badge-green' : exam.status === 'Confirmed' ? 'badge-blue' : 'badge-amber'}`}>
                    {exam.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right column -->
    <div class="stack">
      <!-- Progress Ring -->
      <div class="card animate-in" style="animation-delay: 150ms;">
        <div class="card-header">
          <span class="card-title">Syllabus Progress</span>
          <a href="/syllabus" class="card-action">Details →</a>
        </div>
        <div style="display: flex; justify-content: center; margin-bottom: var(--space-4);">
          <div style="position: relative; width: 130px; height: 130px;">
            <svg viewBox="0 0 120 120" style="width: 100%; height: 100%;">
              <circle cx="60" cy="60" r="48" fill="none" stroke="var(--border)" stroke-width="10"/>
              <circle id="progress-arc" cx="60" cy="60" r="48" fill="none" stroke="var(--accent)" stroke-width="10"
                stroke-dasharray="301.6" stroke-dashoffset="301.6" stroke-linecap="round"
                transform="rotate(-90 60 60)"
                style="transition: stroke-dashoffset 1s var(--ease-out);"/>
            </svg>
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
              <span class="text-mono" style="font-size: 1.5rem; font-weight: 700;" id="coverage-ring-pct">0%</span>
            </div>
          </div>
        </div>
        <div style="display: flex; justify-content: space-around; padding-top: var(--space-4); border-top: 1px solid var(--border);">
          <div style="text-align: center;">
            <div class="text-mono" style="font-weight: 700; font-size: 1.1rem;" id="coverage-done">0</div>
            <div class="text-muted" style="font-size: 0.75rem;">Completed</div>
          </div>
          <div style="text-align: center;">
            <div class="text-mono" style="font-weight: 700; font-size: 1.1rem;">134</div>
            <div class="text-muted" style="font-size: 0.75rem;">Total Topics</div>
          </div>
        </div>
      </div>

      <!-- Quick Navigate -->
      <div class="card animate-in" style="animation-delay: 250ms;">
        <div class="card-header">
          <span class="card-title">Quick Access</span>
        </div>
        <div class="grid grid-2" style="gap: var(--space-3);">
          {[
            { href: '/pyq', label: 'PYQ Quiz', color: 'var(--accent-soft)', stroke: 'var(--accent)', icon: '<line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/>' },
            { href: '/notes', label: 'Notes', color: 'var(--blue-soft)', stroke: 'var(--blue)', icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
            { href: '/revision', label: 'Revision', color: 'var(--amber-soft)', stroke: 'var(--amber)', icon: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>' },
            { href: '/vle', label: 'VLE Portal', color: 'var(--green-soft)', stroke: 'var(--green)', icon: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>' },
          ].map(item => (
            <a href={item.href} style={`display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); padding: var(--space-4); background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius-sm); text-decoration: none; transition: all var(--duration-fast) var(--ease-out);`}>
              <svg style={`width: 22px; height: 22px; stroke: ${item.stroke}; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round;`} viewBox="0 0 24 24" set:html={item.icon} />
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--text);">{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

</Layout>

<style>
  .cd-unit { display: flex; flex-direction: column; }
  .cd-val {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cd-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
    margin-top: 0.15rem;
  }
</style>

<script>
  // Live countdown
  const target = new Date('2026-08-22T10:00:00+05:30');
  function tick() {
    const diff = target.getTime() - Date.now();
    if (diff <= 0) return;
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('cd-days-lg', d.toString());
    set('cd-hours', h.toString().padStart(2,'0'));
    set('cd-mins', m.toString().padStart(2,'0'));
    set('cd-secs', s.toString().padStart(2,'0'));
  }
  tick(); setInterval(tick, 1000);

  // Syllabus progress
  function updateProgress() {
    const total = 134;
    let done = 0;
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k?.startsWith('syllabus-checked-') && localStorage.getItem(k) === 'true') done++;
    }
    const pct = Math.min(100, Math.round((done / total) * 100));
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('coverage-pct', `${pct}%`);
    set('coverage-ring-pct', `${pct}%`);
    set('coverage-done', done.toString());
    const arc = document.getElementById('progress-arc');
    if (arc) arc.style.strokeDashoffset = (301.6 - (pct / 100) * 301.6).toString();
  }
  updateProgress();
  window.addEventListener('storage', updateProgress);
</script>
