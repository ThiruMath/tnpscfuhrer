---
import Layout from '../layouts/Layout.astro';

// TNPSC Exam Calendar Data
const upcomingExams = [
  {
    name: 'Group II / IIA (CSSE-II)',
    date: '2026-07-12',
    status: 'Confirmed',
    posts: 'Combined Civil Services Examination - II',
    vacancies: '6,318',
    color: '#C92C2E'
  },
  {
    name: 'Group IV (CSSE-IV)',
    date: '2026-09-21',
    status: 'Tentative',
    posts: 'VAO, Junior Assistant, Typist',
    vacancies: '9,351',
    color: '#3B82F6'
  },
  {
    name: 'Group I Prelims',
    date: '2026-11-15',
    status: 'Tentative',
    posts: 'Deputy Collector, DSP, Assistant Commissioner',
    vacancies: '92',
    color: '#FF9D73'
  },
];

function daysUntil(dateStr: string): number {
  const target = new Date(dateStr);
  const today = new Date();
  const diff = target.getTime() - today.getTime();
  return Math.max(0, Math.ceil(diff / (1000 * 60 * 60 * 24)));
}

const nextExam = upcomingExams[0];
const nextDays = daysUntil(nextExam.date);
---

<Layout title="Dashboard" active="Dashboard">

  <!-- KPI Stats Row -->
  <div class="dash-grid dash-grid-4 mb-3">
    <!-- Highlight Stat -->
    <div class="kpi-card" style="border-top: 4px solid var(--accent);">
      <div class="kpi-header">Next Exam In</div>
      <div class="kpi-value" id="cd-days-kpi" style="color: var(--accent);">{nextDays} <span style="font-size:1rem; color:var(--text-muted); font-weight:500;">Days</span></div>
      <div class="kpi-footer">{nextExam.name}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-header">Study Notes</div>
      <div class="kpi-value">900+</div>
      <div class="kpi-footer">Across all subjects</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-header">PYQ Questions</div>
      <div class="kpi-value">120+</div>
      <div class="kpi-footer"><span class="kpi-trend trend-up">↑ 12</span> this week</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-header">Syllabus Covered</div>
      <div class="kpi-value" id="coverage-pct-kpi">0%</div>
      <div class="kpi-footer">Of total topics</div>
    </div>
  </div>

  <!-- Main Dashboard Grid -->
  <div class="dash-grid dash-grid-2-1">

    <!-- Left Column -->
    <div class="dash-col">

      <!-- Countdown Card (Red highlight style from mockup) -->
      <div class="d-card card-solid-accent countdown-card mb-3">
        <div class="d-card-header">
          <span class="d-card-title">Exam Countdown</span>
          <a href="/calendar" class="d-card-action" style="color: rgba(255,255,255,0.8);">Calendar ↗</a>
        </div>
        <div class="countdown-body">
          <div class="countdown-msg">The next exam is approaching. Keep preparing!</div>
          <div class="countdown-exam-name">{nextExam.name}</div>
          
          <div class="countdown-timer">
            <div class="cd-unit">
              <span class="cd-val" id="cd-days-lg">{nextDays}</span>
              <span class="cd-label">Days</span>
            </div>
            <div class="cd-unit">
              <span class="cd-val" id="cd-hours">00</span>
              <span class="cd-label">Hrs</span>
            </div>
            <div class="cd-unit">
              <span class="cd-val" id="cd-mins">00</span>
              <span class="cd-label">Min</span>
            </div>
            <div class="cd-unit">
              <span class="cd-val" id="cd-secs">00</span>
              <span class="cd-label">Sec</span>
            </div>
          </div>
          
          <div style="margin-top: 1.5rem;">
            <a href="/syllabus" class="btn-primary" style="background: white; color: var(--accent); padding: 0.6rem 1.25rem;">Start studying ↗</a>
          </div>
        </div>
      </div>

      <!-- Upcoming Exams Table -->
      <div class="d-card mb-3">
        <div class="d-card-header">
          <span class="d-card-title">Upcoming Exams</span>
        </div>
        <table class="d-table">
          <thead>
            <tr>
              <th>Exam</th>
              <th>Date</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {upcomingExams.map(exam => (
              <tr>
                <td>
                  <div style="font-weight: 600; color: var(--text);">{exam.name}</div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">{exam.posts}</div>
                </td>
                <td>
                  <div style="font-weight: 500;">{new Date(exam.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</div>
                  <div style="font-size: 0.75rem; color: var(--accent); font-weight:600;">{daysUntil(exam.date)} days left</div>
                </td>
                <td>
                  <span class={`badge ${exam.status === 'Confirmed' ? 'badge-green' : 'badge-amber'}`}>
                    {exam.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>

    <!-- Right Column -->
    <div class="dash-col">

      <!-- Study Progress Card -->
      <div class="d-card mb-3">
        <div class="d-card-header">
          <span class="d-card-title">Syllabus Progress</span>
          <a href="/syllabus" class="d-card-action">Details ↗</a>
        </div>
        <div class="progress-ring-wrap">
          <svg class="progress-ring" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="50" fill="none" stroke="var(--border)" stroke-width="12"/>
            <circle id="progress-arc" cx="60" cy="60" r="50" fill="none" stroke="var(--accent)" stroke-width="12"
              stroke-dasharray="314" stroke-dashoffset="314" stroke-linecap="round"
              transform="rotate(-90 60 60)"
              style="transition: stroke-dashoffset 1.2s ease-out;"/>
          </svg>
          <div class="progress-ring-text">
            <span class="progress-pct" id="coverage-pct">0%</span>
          </div>
        </div>
        <div class="progress-stats">
          <div class="progress-stat">
            <span class="progress-stat-label">Completed</span>
            <span class="progress-stat-val" id="coverage-completed">0</span>
          </div>
          <div class="progress-stat">
            <span class="progress-stat-label">Total Topics</span>
            <span class="progress-stat-val" id="coverage-total">134</span>
          </div>
        </div>
      </div>

      <!-- Quick Navigation Cards -->
      <div class="d-card mb-3">
        <div class="d-card-header">
          <span class="d-card-title">Quick Access</span>
        </div>
        <div class="nav-widget-grid">
          <a href="/pyq" class="nav-widget">
            <span class="nav-widget-icon">📝</span>
            <span class="nav-widget-label">PYQ Quiz</span>
          </a>
          <a href="/notes" class="nav-widget">
            <span class="nav-widget-icon">📚</span>
            <span class="nav-widget-label">Notes</span>
          </a>
          <a href="/revision" class="nav-widget">
            <span class="nav-widget-icon">🔥</span>
            <span class="nav-widget-label">Revision</span>
          </a>
          <a href="/vle" class="nav-widget">
            <span class="nav-widget-icon">🎓</span>
            <span class="nav-widget-label">VLE Portal</span>
          </a>
        </div>
      </div>

    </div>
  </div>

</Layout>

<script>
  // Live countdown timer
  const targetDate = new Date('2026-07-12T10:00:00+05:30');
  function updateCountdown() {
    const now = new Date();
    const diff = targetDate.getTime() - now.getTime();
    if (diff <= 0) return;
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const secs = Math.floor((diff % (1000 * 60)) / 1000);

    const set = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    set('cd-days-lg', days.toString());
    set('cd-hours', hours.toString().padStart(2, '0'));
    set('cd-mins', mins.toString().padStart(2, '0'));
    set('cd-secs', secs.toString().padStart(2, '0'));
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // Syllabus progress
  function updateSyllabusProgress() {
    const totalTopics = 134;
    let completedCount = 0;

    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('syllabus-checked-') && localStorage.getItem(key) === 'true') {
        completedCount++;
      }
    }

    const pct = Math.min(100, Math.round((completedCount / totalTopics) * 100)) || 0;

    const set = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    set('coverage-pct', `${pct}%`);
    set('coverage-pct-kpi', `${pct}%`);
    set('coverage-completed', completedCount.toString());
    set('coverage-total', totalTopics.toString());

    const arc = document.getElementById('progress-arc');
    if (arc) {
      const circumference = 314;
      const offset = circumference - (pct / 100) * circumference;
      arc.style.strokeDashoffset = offset.toString();
    }
  }

  updateSyllabusProgress();
  window.addEventListener('storage', updateSyllabusProgress);
</script>

<style>
  /* ─── Countdown Card (Mockup Style) ────────────────────────────── */
  .countdown-card {
    position: relative;
    overflow: hidden;
  }
  
  /* Decorative abstract shape behind the content */
  .countdown-card::after {
    content: '';
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 200px;
    height: 200px;
    background: rgba(255,255,255,0.1);
    transform: rotate(45deg);
    z-index: 0;
  }

  .countdown-body { 
    position: relative;
    z-index: 1;
  }

  .countdown-msg {
    font-size: 0.85rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }

  .countdown-exam-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .countdown-timer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .cd-unit { 
    display: flex;
    flex-direction: column;
  }
  
  .cd-val {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  
  .cd-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
    margin-top: 0.2rem;
  }

  /* ─── Progress Ring ──────────────────────────────────────────────── */
  .progress-ring-wrap {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 1.5rem;
  }
  .progress-ring {
    width: 100%;
    height: 100%;
  }
  .progress-ring-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .progress-pct {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .progress-stats {
    display: flex;
    justify-content: space-around;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .progress-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .progress-stat-val {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
  }
  .progress-stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* ─── Quick Navigation Widgets ───────────────────────────────────── */
  .nav-widget-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .nav-widget {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.25rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition);
  }
  .nav-widget:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nav-widget-icon {
    font-size: 1.5rem;
  }
  .nav-widget-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }
  .nav-widget:hover .nav-widget-label {
    color: var(--accent);
  }

  /* ─── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .countdown-timer { gap: 1rem; }
    .cd-val { font-size: 2rem; }
  }
</style>
