---
import Layout from '../layouts/Layout.astro';

// Topic List & Formulas Data
const mathTopics = [
  {
    id: 'simplification',
    title: 'Simplification & Percentages',
    icon: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
    desc: 'BODMAS rules, percentages, decimals, fractions, and ratio conversions.',
    formulas: [
      { name: 'BODMAS Order', rule: 'Bracket ( ), Of, Div (÷), Mul (×), Add (+), Sub (-)' },
      { name: 'Percentage Increase', rule: 'Increase % = (Increase Value / Original Value) × 100' },
      { name: 'Salary Rule', rule: 'If A is R% more than B, B is [R / (100 + R)] × 100 % less than A' }
    ]
  },
  {
    id: 'lcm-hcf',
    title: 'HCF & LCM',
    icon: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="9" y2="21"/>',
    desc: 'Common factors, common multiples, division methods, and relationship properties.',
    formulas: [
      { name: 'Fundamental Relation', rule: 'HCF(a, b) × LCM(a, b) = a × b' },
      { name: 'LCM of Fractions', rule: 'LCM of Numerators / HCF of Denominators' },
      { name: 'HCF of Fractions', rule: 'HCF of Numerators / LCM of Denominators' }
    ]
  },
  {
    id: 'interest',
    title: 'Simple & Compound Interest',
    icon: '<path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
    desc: 'Annual interest rates, principal, accrued amounts, and compound frequency.',
    formulas: [
      { name: 'Simple Interest (SI)', rule: 'SI = (P × T × R) / 100' },
      { name: 'Compound Interest (Amount)', rule: 'A = P × (1 + R/100)^n' },
      { name: 'Difference for 2 Years', rule: 'CI - SI = P × (R / 100)^2' }
    ]
  },
  {
    id: 'time-work',
    title: 'Time & Work',
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    desc: 'Individual rates, group coordination, pipes, cisterns, and work efficiency.',
    formulas: [
      { name: 'Combined Work Rate', rule: 'X & Y together take (X × Y) / (X + Y) days' },
      { name: 'Efficiency Rule', rule: 'Work Done = Efficiency × Time Taken' },
      { name: 'Chain Rule', rule: '(M1 × D1 × H1) / W1 = (M2 × D2 × H2) / W2' }
    ]
  },
  {
    id: 'mensuration',
    title: 'Mensuration',
    icon: '<path d="M3 21h18L12 3z"/><path d="m3 21 9-9"/><path d="M12 12v9"/>',
    desc: '2D shapes, 3D solids, surface area, volumes, and geometric measurements.',
    formulas: [
      { name: 'Circle Area & Circ.', rule: 'Area = πr², Circ = 2πr (π ≈ 22/7)' },
      { name: 'Sphere Volume & SA', rule: 'Volume = (4/3)πr³, Surface Area = 4πr²' },
      { name: 'Cylinder Vol & CSA', rule: 'Volume = πr²h, Curved SA = 2πrh' }
    ]
  }
];

// Interactive Practice Questions
const quizQuestions = [
  {
    id: 1,
    question: "The ratio of two numbers is 3:4 and their HCF is 4. Find their LCM.",
    options: [
      { label: "A", text: "12" },
      { label: "B", text: "16" },
      { label: "C", text: "24" },
      { label: "D", text: "48" }
    ],
    correct: "D",
    explanation: "Let the two numbers be 3x and 4x. Since their HCF is given as 4, the common factor variable x must equal 4. Therefore, the numbers are 3(4) = 12 and 4(4) = 16. The LCM of 12 and 16 is 48. Alternatively, using a shortcut for two ratios with HCF: LCM = Product of Ratios × HCF = 3 × 4 × 4 = 48."
  },
  {
    id: 2,
    question: "Find the compound interest on ₹10,000 for 2 years at 10% per annum, compounded annually.",
    options: [
      { label: "A", text: "₹2,000" },
      { label: "B", text: "₹2,100" },
      { label: "C", text: "₹1,000" },
      { label: "D", text: "₹2,200" }
    ],
    correct: "B",
    explanation: "Amount A = P(1 + R/100)^T. Here, P = 10,000, R = 10, T = 2. A = 10000 × (1 + 10/100)^2 = 10000 × (1.1)^2 = 10000 × 1.21 = ₹12,100. Compound Interest CI = Amount - Principal = 12,100 - 10,000 = ₹2,100."
  },
  {
    id: 3,
    question: "A can do a piece of work in 10 days and B can do it in 15 days. In how many days can they finish it working together?",
    options: [
      { label: "A", text: "5 days" },
      { label: "B", text: "6 days" },
      { label: "C", text: "8 days" },
      { label: "D", text: "7.5 days" }
    ],
    correct: "B",
    explanation: "Combined rate = 1/A + 1/B = 1/10 + 1/15 = (3 + 2)/30 = 5/30 = 1/6. Therefore, the time taken working together is the reciprocal, which is 6 days. Shortcut: (X × Y) / (X + Y) = (10 × 15) / (10 + 15) = 150 / 25 = 6 days."
  },
  {
    id: 4,
    question: "Simplify the expression: 125 × 8 ÷ (25 - 5 × 4) + 12",
    options: [
      { label: "A", text: "212" },
      { label: "B", text: "162" },
      { label: "C", text: "112" },
      { label: "D", text: "200" }
    ],
    correct: "A",
    explanation: "Applying BODMAS: \n1. First resolve Parenthesis (25 - 5 × 4) -> 5 is multiplied by 4 first, giving 20. Then 25 - 20 = 5.\n2. The expression becomes: 125 × 8 ÷ 5 + 12.\n3. Perform division and multiplication from left to right: 125 × 8 = 1000. Then 1000 ÷ 5 = 200.\n4. Perform addition: 200 + 12 = 212."
  }
];
---

<Layout title="Aptitude & Mental Ability" description="Master TNPSC Math with formula sheets, interactive calculators, and practice questions." active="Aptitude">
  
  <!-- Hero Section -->
  <div class="page-header animate-in">
    <span class="badge badge-accent mb-3">Unit 10: Aptitude</span>
    <h1>Master the Math.</h1>
    <p>Aptitude is 12.5% of the total questions in TNPSC Group 4 and Group 2. Solve faster and smarter with our tools.</p>
  </div>

  <div class="grid grid-3 mb-8 stagger">
    <div class="stat-card" style="border-top: 3px solid var(--accent);">
      <div class="stat-label">Questions in Exam</div>
      <div class="stat-value text-mono">25</div>
      <div class="stat-footer">Compulsory</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Marks</div>
      <div class="stat-value text-mono">37.5</div>
      <div class="stat-footer">High Yield</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Syllabus Coverage</div>
      <div class="stat-value text-mono">100%</div>
      <div class="stat-footer">All Topics Covered</div>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <div class="flex gap-2 mb-6 animate-in" style="animation-delay: 200ms;">
    <button class="portal-nav-btn active" data-target="formulas-section">📋 Formulas</button>
    <button class="portal-nav-btn" data-target="solvers-section">⚡ Interactive Solvers</button>
    <button class="portal-nav-btn" data-target="quiz-section">📝 Practice Quiz</button>
  </div>

  <!-- SECTION 1: FORMULAS -->
  <div id="formulas-section" class="portal-pane active animate-in" style="animation-delay: 300ms;">
    <div class="mb-6">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-2);">Essential Exam Formulas</h2>
      <p class="text-secondary" style="font-size: 0.9rem;">Quick-reference cheat sheets for high-yield TNPSC Aptitude modules.</p>
    </div>
    
    <div class="grid grid-2">
      {mathTopics.map(topic => (
        <div class="card card-interactive">
          <div class="flex items-center gap-3 mb-3">
            <div style="width: 36px; height: 36px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--accent) 10%, transparent);">
              <svg style="width: 18px; height: 18px; stroke: var(--accent); fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round;" viewBox="0 0 24 24" set:html={topic.icon} />
            </div>
            <h3 style="font-size: 1.05rem;">{topic.title}</h3>
          </div>
          <p class="text-muted" style="font-size: 0.85rem; margin-bottom: var(--space-4); min-height: 2.5rem;">{topic.desc}</p>
          
          <div class="stack gap-3 mt-auto">
            {topic.formulas.map(f => (
              <div>
                <strong style="display: block; font-size: 0.8rem; color: var(--text-secondary); margin-bottom: var(--space-1);">{f.name}</strong>
                <code style="display: block; background: var(--surface-raised); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); font-size: 0.8rem; color: var(--text); font-family: var(--font-mono); border: 1px solid var(--border-subtle);">{f.rule}</code>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- SECTION 2: INTERACTIVE SOLVERS -->
  <div id="solvers-section" class="portal-pane" style="display: none;">
    <div class="mb-6">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-2);">Step-by-Step Solvers</h2>
      <p class="text-secondary" style="font-size: 0.9rem;">Practice with your own numbers. Enter values and watch the script compute the working steps.</p>
    </div>

    <div class="grid grid-2">
      <!-- SOLVER A: HCF & LCM -->
      <div class="card">
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2);">LCM & HCF Solver</h3>
        <p class="text-muted" style="font-size: 0.85rem; margin-bottom: var(--space-4);">Enter up to three positive integers to compute their Highest Common Factor and Lowest Common Multiple.</p>
        
        <div class="grid grid-3" style="margin-bottom: var(--space-4);">
          <div class="stack gap-1">
            <label class="text-secondary" style="font-size: 0.8rem; font-weight: 500;">Num 1</label>
            <input type="number" id="num1" value="12" class="form-input" />
          </div>
          <div class="stack gap-1">
            <label class="text-secondary" style="font-size: 0.8rem; font-weight: 500;">Num 2</label>
            <input type="number" id="num2" value="18" class="form-input" />
          </div>
          <div class="stack gap-1">
            <label class="text-secondary" style="font-size: 0.8rem; font-weight: 500;">Num 3 (Opt)</label>
            <input type="number" id="num3" placeholder="e.g. 30" class="form-input" />
          </div>
        </div>
        
        <button id="calc-lcm-hcf" class="btn btn-primary w-full">Compute LCM & HCF</button>
        <div id="lcm-hcf-result" class="solver-result hidden"></div>
      </div>

      <!-- SOLVER B: SIMPLE VS COMPOUND INTEREST -->
      <div class="card">
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2);">Interest Comparison Tool</h3>
        <p class="text-muted" style="font-size: 0.85rem; margin-bottom: var(--space-4);">Compare Simple Interest and Compound Interest (compounded annually).</p>

        <div class="grid grid-3" style="margin-bottom: var(--space-4);">
          <div class="stack gap-1" style="grid-column: span 3;">
            <label class="text-secondary" style="font-size: 0.8rem; font-weight: 500;">Principal Amount (P) in ₹</label>
            <input type="number" id="principal" value="10000" class="form-input" />
          </div>
          <div class="stack gap-1">
            <label class="text-secondary" style="font-size: 0.8rem; font-weight: 500;">Rate (R) %</label>
            <input type="number" id="rate" value="10" step="0.1" class="form-input" />
          </div>
          <div class="stack gap-1" style="grid-column: span 2;">
            <label class="text-secondary" style="font-size: 0.8rem; font-weight: 500;">Time Period (T) Years</label>
            <input type="number" id="time" value="2" class="form-input" />
          </div>
        </div>

        <button id="calc-interest" class="btn btn-primary w-full">Compare Interest Options</button>
        <div id="interest-result" class="solver-result hidden"></div>
      </div>
    </div>
  </div>

  <!-- SECTION 3: PRACTICE QUIZ -->
  <div id="quiz-section" class="portal-pane" style="display: none;">
    <div class="mb-6">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-2);">Interactive Revision Quiz</h2>
      <p class="text-secondary" style="font-size: 0.9rem;">Test your conceptual understanding and calculation speed with instant visual feedback.</p>
    </div>

    <div class="stack gap-6 mx-auto" style="max-width: 750px;">
      {quizQuestions.map(q => (
        <div class="card quiz-card" data-qid={q.id} data-correct={q.correct}>
          <div class="flex items-center justify-between mb-4">
            <span class="text-mono text-muted" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Question {q.id} of {quizQuestions.length}</span>
            <span class="badge badge-green q-badge hidden">Correct</span>
          </div>
          
          <p style="font-size: 1.1rem; font-weight: 500; color: var(--text); margin-bottom: var(--space-5); line-height: 1.5;">{q.question}</p>
          
          <div class="grid grid-2" style="gap: var(--space-3); margin-bottom: var(--space-5);">
            {q.options.map(opt => (
              <button class="opt-btn" data-opt={opt.label}>
                <span class="opt-lbl">{opt.label}</span>
                <span class="opt-txt">{opt.text}</span>
              </button>
            ))}
          </div>

          <div class="exp-box hidden">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--green); text-transform: uppercase; margin-bottom: var(--space-2);">🔑 Detailed Steps</div>
            <p style="font-size: 0.9rem; color: color-mix(in srgb, var(--green) 80%, black); line-height: 1.6; white-space: pre-line;">{q.explanation}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</Layout>

<style>
  /* Tabs */
  .portal-nav-btn {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .portal-nav-btn:hover { border-color: var(--border-hover); color: var(--text); }
  .portal-nav-btn.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }

  /* Solver inputs & results */
  .form-input {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    font-family: inherit;
    color: var(--text);
    outline: none;
    transition: all var(--duration-fast);
  }
  .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent); }

  .solver-result {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    animation: fadeUp var(--duration-normal) var(--ease-out);
  }
  .solver-result.hidden { display: none; }

  /* Quiz styles */
  .quiz-card { transition: border-color 0.2s; }
  
  .opt-btn {
    display: flex; align-items: center; gap: var(--space-3);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: var(--space-3);
    cursor: pointer; text-align: left; color: var(--text);
    transition: all 0.15s; font-size: 0.95rem; font-family: inherit;
  }
  .opt-btn:hover { background: var(--surface-raised); border-color: var(--border-hover); }
  .opt-lbl {
    display: flex; align-items: center; justify-content: center;
    background: var(--surface-raised); border: 1px solid var(--border-subtle);
    width: 24px; height: 24px; border-radius: var(--radius-xs);
    font-size: 0.75rem; font-weight: 700; color: var(--text-muted);
    flex-shrink: 0;
  }
  
  .opt-btn.correct { background: color-mix(in srgb, var(--green) 10%, transparent); border-color: var(--green); color: var(--green); }
  .opt-btn.correct .opt-lbl { background: var(--green); color: white; border-color: var(--green); }
  
  .opt-btn.wrong { background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: var(--accent); color: var(--accent); }
  .opt-btn.wrong .opt-lbl { background: var(--accent); color: white; border-color: var(--accent); }
  
  .opt-btn.disabled { pointer-events: none; opacity: 0.8; }

  .exp-box {
    margin-top: var(--space-4); padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--green) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--green) 20%, transparent);
    animation: fadeUp 0.3s ease-out;
  }
  .exp-box.hidden { display: none; }
</style>

<script>
  // Tabs
  const tabButtons = document.querySelectorAll('.portal-nav-btn');
  const panes = document.querySelectorAll('.portal-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => b.classList.remove('active'));
      panes.forEach(p => (p as HTMLElement).style.display = 'none');
      btn.classList.add('active');
      const targetId = btn.getAttribute('data-target');
      document.getElementById(targetId!)!.style.display = 'block';
      document.getElementById(targetId!)!.classList.add('animate-in');
    });
  });

  // Math Solvers
  const getPrimeFactors = (num: number) => {
    let temp = num; const factors: Record<number, number> = {};
    for (let i = 2; i <= temp; i++) {
      while (temp % i === 0) { factors[i] = (factors[i] || 0) + 1; temp /= i; }
    }
    return factors;
  };
  const factorString = (factors: Record<number, number>) => Object.keys(factors).map(prime => `${prime}<sup>${factors[parseInt(prime)]}</sup>`).join(" × ") || "1";
  const gcdTwo = (a: number, b: number): number => b === 0 ? a : gcdTwo(b, a % b);
  const lcmTwo = (a: number, b: number): number => (a * b) / gcdTwo(a, b);

  document.getElementById('calc-lcm-hcf')?.addEventListener('click', () => {
    const n1 = parseInt((document.getElementById('num1') as HTMLInputElement).value);
    const n2 = parseInt((document.getElementById('num2') as HTMLInputElement).value);
    const n3Val = (document.getElementById('num3') as HTMLInputElement).value.trim();
    const n3 = n3Val !== "" ? parseInt(n3Val) : null;

    if (isNaN(n1) || n1 <= 0 || isNaN(n2) || n2 <= 0 || (n3 !== null && (isNaN(n3) || n3 <= 0))) {
      alert("Please enter valid positive integers."); return;
    }

    const f1 = getPrimeFactors(n1); const f2 = getPrimeFactors(n2); const f3 = n3 ? getPrimeFactors(n3) : null;
    let hcf = gcdTwo(n1, n2); let lcm = lcmTwo(n1, n2);
    if (n3) { hcf = gcdTwo(hcf, n3); lcm = lcmTwo(lcm, n3); }

    const resBox = document.getElementById('lcm-hcf-result')!;
    resBox.innerHTML = `
      <div style="font-size: 0.9rem;">
        <strong style="display: block; margin-bottom: 0.5rem;">Prime Factorization:</strong>
        <div style="margin-bottom: 1rem; color: var(--text-secondary);">
          • ${n1} = ${factorString(f1)}<br/>
          • ${n2} = ${factorString(f2)}<br/>
          ${n3 ? `• ${n3} = ${factorString(f3!)}` : ''}
        </div>
        <div class="grid grid-2" style="gap: var(--space-3);">
          <div style="background: var(--surface); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">HCF</div>
            <div class="text-mono" style="font-size: 1.5rem; font-weight: 700; color: var(--text);">${hcf}</div>
          </div>
          <div style="background: var(--surface); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">LCM</div>
            <div class="text-mono" style="font-size: 1.5rem; font-weight: 700; color: var(--text);">${lcm}</div>
          </div>
        </div>
      </div>
    `;
    resBox.classList.remove('hidden');
  });

  document.getElementById('calc-interest')?.addEventListener('click', () => {
    const P = parseFloat((document.getElementById('principal') as HTMLInputElement).value);
    const R = parseFloat((document.getElementById('rate') as HTMLInputElement).value);
    const T = parseInt((document.getElementById('time') as HTMLInputElement).value);

    if (isNaN(P) || P <= 0 || isNaN(R) || R <= 0 || isNaN(T) || T <= 0) {
      alert("Please enter valid positive values."); return;
    }

    const si = (P * T * R) / 100;
    const siTotal = P + si;
    const ciTotal = P * Math.pow((1 + R / 100), T);
    const ci = ciTotal - P;
    const diff = ci - si;

    const resBox = document.getElementById('interest-result')!;
    resBox.innerHTML = `
      <div class="grid grid-2" style="gap: var(--space-3); margin-bottom: var(--space-3);">
        <div style="background: var(--surface); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--border);">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Simple Interest (SI)</div>
          <div class="text-mono" style="font-size: 1.25rem; font-weight: 700; color: var(--text);">₹${si.toFixed(2)}</div>
          <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 2px;">Total: ₹${siTotal.toFixed(2)}</div>
        </div>
        <div style="background: var(--surface); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--border);">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Compound Interest (CI)</div>
          <div class="text-mono" style="font-size: 1.25rem; font-weight: 700; color: var(--text);">₹${ci.toFixed(2)}</div>
          <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 2px;">Total: ₹${ciTotal.toFixed(2)}</div>
        </div>
      </div>
      <div style="background: color-mix(in srgb, var(--accent) 5%, transparent); padding: var(--space-3); border-radius: var(--radius-sm); font-size: 0.85rem; border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);">
        💡 <strong>Difference (CI - SI):</strong> Compound interest earns <strong style="color: var(--accent);">₹${diff.toFixed(2)}</strong> more.
      </div>
    `;
    resBox.classList.remove('hidden');
  });

  // Quiz Logic
  document.querySelectorAll('.quiz-card').forEach(qCard => {
    const correctOpt = qCard.getAttribute('data-correct');
    const optButtons = qCard.querySelectorAll('.opt-btn');
    const explanationBox = qCard.querySelector('.exp-box');
    const badge = qCard.querySelector('.q-badge');

    optButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-opt');
        optButtons.forEach(b => b.classList.add('disabled'));

        if (selected === correctOpt) {
          btn.classList.add('correct');
          badge?.classList.remove('hidden');
          (qCard as HTMLElement).style.borderColor = 'var(--green)';
        } else {
          btn.classList.add('wrong');
          optButtons.forEach(b => { if (b.getAttribute('data-opt') === correctOpt) b.classList.add('correct'); });
          (qCard as HTMLElement).style.borderColor = 'var(--accent)';
        }
        explanationBox?.classList.remove('hidden');
      });
    });
  });
</script>
