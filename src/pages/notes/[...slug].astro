---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const noteEntries = await getCollection('notes');
  return noteEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  title,
  description,
  subject,
  exam,
  topics,
  difficulty,
  last_updated,
  source_references
} = entry.data;

const displayTitle = title || entry.slug;
const displayDate = last_updated ? new Date(last_updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
---

<Layout title={`${displayTitle} | TNPSC Fuhrer Notes`} description={description || `Study notes for ${displayTitle}`} active="Study Notes">
  <div class="note-layout">
    <!-- Main Content -->
    <article class="note-article">
      <header class="note-header animate-in">
        <div class="flex items-center gap-2 mb-4 flex-wrap">
          <a href="/notes" class="text-accent" style="font-size: 0.82rem; font-weight: 600;">← Notes</a>
          {subject && <span class="badge badge-blue">{subject}</span>}
          {exam && exam.map((e: string) => <span class="badge badge-accent">{e}</span>)}
          {difficulty && (
            <span class={`badge ${difficulty === 'easy' ? 'badge-green' : difficulty === 'medium' ? 'badge-amber' : 'badge-accent'}`}>
              {difficulty}
            </span>
          )}
        </div>
        <h1 style="font-size: 1.75rem; letter-spacing: -0.02em; margin-bottom: var(--space-3);">{displayTitle}</h1>
        {description && <p class="text-secondary" style="font-size: 0.95rem; line-height: 1.6; max-width: 64ch; margin-bottom: var(--space-3);">{description}</p>}
        {displayDate && <span class="text-muted" style="font-size: 0.8rem;">Last updated: {displayDate}</span>}
      </header>

      <div class="markdown-body">
        <Content />
      </div>

      {source_references && source_references.length > 0 && (
        <div class="note-sources">
          <h3>Sources & References</h3>
          <ul>
            {source_references.map((src: string) => (
              <li>{src.startsWith('http') ? <a href={src} target="_blank" rel="noopener">{src}</a> : src}</li>
            ))}
          </ul>
        </div>
      )}
    </article>

    <!-- Sidebar -->
    <aside class="note-sidebar">
      <div class="note-sb-block">
        <h3>Topics Covered</h3>
        <div class="flex flex-wrap gap-2">
          {topics && topics.length > 0 ? topics.map((topic: string) => (
            <a href={`/notes?topic=${encodeURIComponent(topic)}`} class="note-tag">{topic}</a>
          )) : <span class="text-muted" style="font-size: 0.85rem; font-style: italic;">No topics tagged.</span>}
        </div>
      </div>

      <div class="note-sb-block" id="toc-container">
        <h3>Table of Contents</h3>
        <nav id="tocList">
          <!-- Dynamically populated -->
        </nav>
      </div>
    </aside>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll('.markdown-body h2, .markdown-body h3');
    const tocList = document.getElementById('tocList');

    if (headings.length > 0 && tocList) {
      const list = document.createElement('ul');
      list.style.cssText = 'list-style: none; padding: 0; margin: 0;';
      headings.forEach(heading => {
        if (!heading.id) {
          heading.id = heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-') || 'section';
        }
        const li = document.createElement('li');
        li.style.marginBottom = '0.5rem';
        if (heading.tagName === 'H3') li.style.paddingLeft = '1rem';
        const a = document.createElement('a');
        a.href = `#${heading.id}`;
        a.textContent = heading.textContent;
        a.style.cssText = `text-decoration: none; font-size: ${heading.tagName === 'H3' ? '0.82rem' : '0.88rem'}; font-weight: ${heading.tagName === 'H3' ? '400' : '500'}; color: ${heading.tagName === 'H3' ? 'var(--text-muted)' : 'var(--text-secondary)'}; transition: color 150ms;`;
        a.addEventListener('mouseenter', () => a.style.color = 'var(--accent)');
        a.addEventListener('mouseleave', () => a.style.color = heading.tagName === 'H3' ? 'var(--text-muted)' : 'var(--text-secondary)');
        li.appendChild(a);
        list.appendChild(li);
      });
      tocList.appendChild(list);
    } else if (tocList) {
      tocList.innerHTML = '<span style="font-size: 0.85rem; color: var(--text-faint); font-style: italic;">No headings found.</span>';
    }
  });
</script>

<style>
  .note-layout {
    display: flex; gap: var(--space-8);
    align-items: flex-start;
  }

  .note-article {
    flex: 1; min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-8);
  }

  .note-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .note-sidebar {
    width: 280px; flex-shrink: 0;
    position: sticky; top: calc(var(--topbar-height) + var(--space-6));
  }

  .note-sb-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    margin-bottom: var(--space-4);
  }
  .note-sb-block h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .note-tag {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.78rem; font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--duration-fast);
  }
  .note-tag:hover { border-color: var(--accent); color: var(--accent); }

  /* Markdown body — editorial typography */
  .markdown-body { font-size: 1rem; line-height: 1.8; color: var(--text); }
  .markdown-body h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: var(--space-8) 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    letter-spacing: -0.02em;
  }
  .markdown-body h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: var(--space-6) 0 var(--space-3);
    letter-spacing: -0.01em;
  }
  .markdown-body p { margin-bottom: var(--space-4); }
  .markdown-body ul, .markdown-body ol { margin-bottom: var(--space-4); padding-left: var(--space-6); }
  .markdown-body li { margin-bottom: var(--space-2); }
  .markdown-body strong { color: var(--text); font-weight: 700; }
  .markdown-body blockquote {
    border-left: 3px solid var(--accent);
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-5);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--text);
  }
  .markdown-body pre {
    background: #1a1b26;
    color: #c0caf5;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .markdown-body code {
    background: var(--surface-sunken);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    font-size: 0.9em;
    font-family: var(--font-mono);
  }
  .markdown-body pre code { background: none; color: inherit; padding: 0; }
  .markdown-body table { width: 100%; border-collapse: collapse; margin-bottom: var(--space-4); }
  .markdown-body th, .markdown-body td {
    border: 1px solid var(--border);
    padding: var(--space-3);
    text-align: left;
    font-size: 0.9rem;
  }
  .markdown-body th { background: var(--surface-raised); font-weight: 600; }

  .note-sources {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .note-sources h3 { font-size: 1rem; margin-bottom: var(--space-4); }
  .note-sources ul { padding-left: var(--space-5); color: var(--text-muted); }
  .note-sources a { color: var(--accent); text-decoration: underline; }

  @media (max-width: 1024px) {
    .note-layout { flex-direction: column; }
    .note-sidebar { width: 100%; position: static; }
  }
  @media (max-width: 768px) {
    .note-article { padding: var(--space-5); }
  }
</style>
