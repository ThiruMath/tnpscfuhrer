---
import Layout from '../layouts/Layout.astro';
import revisionData from "../../public/data/revision.json";

const { date, questions } = revisionData;
const displayDate = new Date(date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

interface Question {
  question: string;
  topic: string;
  source: string;
  reference?: string;
}

const conceptQs = (questions as Question[]).filter(q => q.source === "concept");
const newsQs = (questions as Question[]).filter(q => q.source === "news");
const pyqQs = (questions as Question[]).filter(q => q.source === "pyq");

const sourceColors: Record<string, { bg: string; text: string; badge: string }> = {
  news: { bg: 'var(--amber-soft)', text: 'var(--amber)', badge: 'badge-amber' },
  concept: { bg: 'var(--blue-soft)', text: 'var(--blue)', badge: 'badge-blue' },
  pyq: { bg: 'var(--green-soft)', text: 'var(--green)', badge: 'badge-green' },
};
---

<Layout title="Daily AI Revision" description="Your daily AI-generated revision set from current affairs, study notes, and PYQs." active="Daily Revision">

  <div class="page-header animate-in">
    <div class="flex items-center gap-3 mb-3">
      <span class="badge badge-accent">🔥 Daily Revision</span>
      <span class="badge badge-neutral">{displayDate}</span>
    </div>
    <h1>Daily AI Revision</h1>
    <p>Your personalized study set — generated from today's current affairs, your notes, and official PYQs.</p>
  </div>

  <!-- Stats -->
  <div class="grid grid-4 mb-6 stagger">
    <div class="stat-card" style="border-top: 3px solid var(--accent);">
      <div class="stat-label">Total Questions</div>
      <div class="stat-value">{questions.length}</div>
      <div class="stat-footer">in today's set</div>
    </div>
    <div class="stat-card">
      <div class="stat-label" style="color: var(--amber);">News Based</div>
      <div class="stat-value">{newsQs.length}</div>
      <div class="stat-footer">from current affairs</div>
    </div>
    <div class="stat-card">
      <div class="stat-label" style="color: var(--blue);">Concept Based</div>
      <div class="stat-value">{conceptQs.length}</div>
      <div class="stat-footer">from study notes</div>
    </div>
    <div class="stat-card">
      <div class="stat-label" style="color: var(--green);">PYQ Based</div>
      <div class="stat-value">{pyqQs.length}</div>
      <div class="stat-footer">from past papers</div>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="flex gap-2 mb-6 animate-in" style="animation-delay: 200ms;">
    <button class="rev-tab active" data-filter="all">All</button>
    <button class="rev-tab" data-filter="news">News</button>
    <button class="rev-tab" data-filter="concept">Concept</button>
    <button class="rev-tab" data-filter="pyq">PYQ</button>
  </div>

  <!-- Questions -->
  <div class="stack gap-3 stagger" id="rev-list">
    {(questions as Question[]).map((q: Question, index: number) => (
      <div class="rev-card" data-source={q.source}>
        <div class="rev-card-top">
          <div class="flex items-center gap-2">
            <span class="text-mono" style={`font-size: 0.78rem; font-weight: 700; color: ${sourceColors[q.source]?.text || 'var(--text-muted)'};`}>Q{String(index + 1).padStart(2, '0')}</span>
            <a href={`/topics/${q.topic.toLowerCase().replace(/\s+/g, '-').replace(/[#?/\\%&]/g, '')}`} class="rev-topic-chip">
              {q.topic}
            </a>
          </div>
          <span class={`badge ${sourceColors[q.source]?.badge || 'badge-neutral'}`}>{q.source.toUpperCase()}</span>
        </div>

        <p class="rev-question">{q.question}</p>

        <div class="rev-card-bottom">
          <button class="rev-reveal-btn">
            <svg style="width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2;" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            Show Reference
          </button>
          <div class="rev-answer hidden">
            {q.source === 'news' && q.reference && (
              <p><strong>Reference:</strong> Review the article <a href={q.reference} target="_blank" rel="noopener" class="text-accent">here ↗</a></p>
            )}
            {q.source === 'concept' && (
              <p><strong>Self-Check:</strong> Verify against <a href={`/notes/${q.topic.toLowerCase().replace(/\s+/g, '-')}`} class="text-accent">{q.topic} notes ↗</a></p>
            )}
            {q.source === 'pyq' && (
              <p><strong>Self-Check:</strong> Consider how recent affairs have changed context for this past question.</p>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

</Layout>

<style>
  .rev-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .rev-tab:hover { border-color: var(--border-hover); color: var(--text); }
  .rev-tab.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }

  .rev-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    transition: all var(--duration-normal) var(--ease-out);
  }
  .rev-card:hover { box-shadow: var(--shadow); border-color: var(--border-hover); }

  .rev-card-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .rev-topic-chip {
    padding: 2px var(--space-2);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.72rem; font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--duration-fast);
  }
  .rev-topic-chip:hover { border-color: var(--accent); color: var(--accent); }

  .rev-question {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.65;
    margin-bottom: var(--space-4);
    font-weight: 500;
  }

  .rev-card-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }

  .rev-reveal-btn {
    display: flex; align-items: center; gap: var(--space-2);
    background: none; border: none; cursor: pointer;
    font-size: 0.82rem; font-weight: 500;
    color: var(--text-muted);
    transition: color var(--duration-fast);
  }
  .rev-reveal-btn:hover { color: var(--accent); }
  .rev-reveal-btn svg { transition: transform var(--duration-fast); }
  .rev-reveal-btn.open svg { transform: rotate(90deg); }

  .rev-answer {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-raised);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .rev-answer a { font-weight: 600; }
  .hidden { display: none; }
</style>

<script>
  // Filter tabs
  document.querySelectorAll('.rev-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.rev-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = (btn as HTMLElement).dataset.filter;
      document.querySelectorAll('.rev-card').forEach(card => {
        const el = card as HTMLElement;
        el.style.display = filter === 'all' || el.dataset.source === filter ? '' : 'none';
      });
    });
  });

  // Reveal answers
  document.querySelectorAll('.rev-reveal-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      if (answer) {
        answer.classList.toggle('hidden');
        btn.classList.toggle('open');
        (btn as HTMLElement).querySelector('svg')?.style;
      }
    });
  });
</script>
