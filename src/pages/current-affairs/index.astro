---
import Layout from '../../layouts/Layout.astro';
import news from "../../../public/data/news.json";

// Extract unique topics for filtering
const topics = ["All", ...new Set(news.map(n => n.topic))];
---

<Layout title="Current Affairs" description="Exam-focused news linked directly to TNPSC/UPSC syllabus topics and your official notes." active="Current Affairs">

  <div class="page-header animate-in">
    <span class="badge badge-accent mb-3">Daily Updates</span>
    <h1>Current Affairs Archive</h1>
    <p>Exam-focused news linked directly to TNPSC/UPSC syllabus topics and your official notes.</p>
  </div>

  <!-- Topic Filter -->
  <div class="mb-8 flex items-center gap-4 flex-wrap animate-in" style="animation-delay: 100ms;">
    <span class="text-secondary" style="font-weight: 600; font-size: 0.9rem;">Filter by Syllabus:</span>
    <div class="flex gap-2 flex-wrap" id="topic-buttons">
      {topics.map(topic => (
        <button class="topic-btn" data-topic={topic}>{topic}</button>
      ))}
    </div>
  </div>
  
  <!-- News Grid -->
  <div class="grid grid-3 mb-10 stagger" id="news-grid">
    {news.map((item) => (
      <div class="card card-interactive flex flex-col h-full news-card" data-topic={item.topic}>
        <div class="flex justify-between items-center mb-4">
          <span class="badge badge-neutral text-mono" style="font-size: 0.7rem;">{item.topic}</span>
          <span class="text-muted" style="font-size: 0.8rem;">{item.date ? new Date(item.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : 'Today'}</span>
        </div>
        
        <h2 style="font-size: 1.15rem; margin-bottom: var(--space-3); color: var(--text);">{item.title}</h2>
        <p class="text-secondary mb-6" style="font-size: 0.9rem; line-height: 1.6; flex: 1;">
          {item.summary.length > 150 ? item.summary.slice(0, 150) + "..." : item.summary}
        </p>
        
        <div class="flex justify-between items-center" style="padding-top: var(--space-4); border-top: 1px solid var(--border-subtle);">
          <span class="text-muted text-mono" style="font-size: 0.75rem;">{item.source}</span>
          <a href={`/current-affairs/${item.slug}`} class="text-accent" style="font-size: 0.85rem; font-weight: 600; text-decoration: none;">Read full →</a>
        </div>
      </div>
    ))}

    {news.length === 0 && (
      <div class="card text-center" style="grid-column: 1 / -1; padding: var(--space-8);">
        <p class="text-secondary">📡 No news available right now. The crawler will update soon!</p>
      </div>
    )}
  </div>

</Layout>

<script>
  // Simple Client-Side Filtering
  const buttons = document.querySelectorAll('.topic-btn');
  const cards = document.querySelectorAll('.news-card') as NodeListOf<HTMLElement>;

  // Highlight 'All' by default
  const allBtn = document.querySelector('.topic-btn[data-topic="All"]');
  if(allBtn) allBtn.classList.add('active');

  buttons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      // Manage active states
      buttons.forEach(b => b.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');

      const selectedTopic = target.getAttribute('data-topic');

      // Filter cards
      cards.forEach(card => {
        if (selectedTopic === 'All' || card.getAttribute('data-topic') === selectedTopic) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .topic-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--pill-radius);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast);
  }
  .topic-btn:hover {
    border-color: var(--border-hover);
    color: var(--text);
  }
  .topic-btn.active {
    background: var(--text);
    color: var(--text-inverse);
    border-color: var(--text);
  }
</style>
