---
import Layout from "../../layouts/SyllabusLayout.astro";
import MarksMeter from "../../components/MarksMeter.astro";
import { prelims, mainsGroup2, mainsGroup2A } from "../../data/examScheme";
---
<Layout title="Overview" description="TNPSC Combined Civil Services Examination II — Group II & IIA. Full exam scheme and unit-by-unit syllabus reference.">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Tamil Nadu Public Service Commission &middot; Combined Civil Services Examination &mdash; II</p>
      <h1>Group II &amp; Group IIA<br />Syllabus &amp; Exam Scheme</h1>
      <p class="tamil-hero">ஒருங்கிணைந்த குடிமைப் பணிகள் தேர்வு &ndash; II &middot; தொகுதி II &amp; IIA</p>
      <p class="hero-copy">
        Two services, one preliminary paper, and a Mains that splits on a single decision: Group II ends
        in an oral interview, Group IIA is settled entirely on the written score. Everything below is
        organised the way the commission scores it &mdash; by unit, by part, by mark.
      </p>
    </section>

    <section class="pipeline">
      <h2 class="section-title">The three stages</h2>
      <div class="pipeline-grid">
        <a class="pipe-card card" href="/syllabus/prelims-syllabus/">
          <span class="pipe-step">01</span>
          <h3>Preliminary Exam</h3>
          <p class="pipe-meta">Code 495 &middot; Objective &middot; Qualifying only</p>
          <p class="pipe-desc">One common paper for both services &mdash; General Studies, Aptitude &amp; Mental Ability, and a Language paper.</p>
          <span class="pipe-marks stamp-number">{prelims.totalMarks} marks</span>
        </a>
        <a class="pipe-card card" href="/syllabus/tamil-eligibility/">
          <span class="pipe-step">02</span>
          <h3>Tamil Eligibility Test</h3>
          <p class="pipe-meta">Mains Paper I &middot; Descriptive &middot; Qualifying only</p>
          <p class="pipe-desc">Common to both services. Translation, summary, comprehension, letter and essay writing.</p>
          <span class="pipe-marks stamp-number">100 marks</span>
        </a>
        <a class="pipe-card card" href="/syllabus/exam-scheme/">
          <span class="pipe-step">03</span>
          <h3>Mains Paper II</h3>
          <p class="pipe-meta">Scoring paper &mdash; decides the merit list</p>
          <p class="pipe-desc">Group II: descriptive General Studies. Group IIA: objective General Studies + Reasoning.</p>
          <span class="pipe-marks stamp-number">300 marks</span>
        </a>
      </div>
    </section>

    <section class="split">
      <h2 class="section-title">Where the two services diverge</h2>
      <div class="split-grid">
        <div class="split-card card">
          <p class="eyebrow">{mainsGroup2.subtitle} &middot; Code 469</p>
          <h3>Group II</h3>
          <p class="split-desc">Descriptive answers across 7 units of General Studies, followed by an oral interview.</p>
          <MarksMeter
            total={300}
            rows={[
              { label: "Paper II — General Studies (descriptive)", value: 300, href: "/syllabus/group2-syllabus/" },
            ]}
          />
          <p class="split-foot">→ Oral interview decides the final rank</p>
        </div>
        <div class="split-card card">
          <p class="eyebrow">{mainsGroup2A.subtitle} &middot; Code 583</p>
          <h3>Group IIA</h3>
          <p class="split-desc">Objective paper split between General Studies and General Intelligence &amp; Reasoning. No interview.</p>
          <MarksMeter
            total={300}
            rows={[
              { label: "A. General Studies (objective)", value: 150, href: "/syllabus/group2a-syllabus/" },
              { label: "B. General Intelligence & Reasoning", value: 50, href: "/syllabus/group2a-syllabus/#reasoning" },
            ]}
          />
          <p class="split-foot">→ Written Mains score alone decides the final rank</p>
        </div>
      </div>
    </section>

    <section class="sources">
      <h2 class="section-title">Reference documents</h2>
      <ul class="source-list">
        <li><span class="stamp-number">495</span> Preliminary Examination syllabus &mdash; Group II &amp; IIA, dated 12.12.2024</li>
        <li><span class="stamp-number">583</span> Mains syllabus, Group IIA (Paper II), dated 04.07.2025</li>
        <li><span class="stamp-number">469</span> Mains syllabus, Group II (Paper II)</li>
        <li><span class="stamp-number">—</span> Tamil Eligibility Test (Paper I) syllabus &amp; pattern, dated 12.12.2024</li>
        <li><span class="stamp-number">—</span> Descriptive question paper pattern, Group II Paper II</li>
      </ul>
      <p class="disclaimer">
        Compiled from official TNPSC notification PDFs for quick reference. TNPSC periodically revises
        syllabi and exam patterns &mdash; always cross-check against the live notification at
        <a href="https://www.tnpsc.gov.in" target="_blank" rel="noopener">tnpsc.gov.in</a> before you plan your preparation.
      </p>
    </section>
  </div>
</Layout>

<style>
  .hero { padding: 8px 0 44px; border-bottom: 1px solid var(--line); margin-bottom: 44px; }
  .hero h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); line-height: 1.08; margin-top: 14px; }
  .tamil-hero { font-family: var(--font-tamil); color: var(--accent-dim); font-size: 1.1rem; margin-top: 12px; }
  .hero-copy { margin-top: 18px; max-width: 60ch; color: var(--ink-soft); font-size: 1.02rem; }

  .section-title {
    font-size: 0.98rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: 18px;
  }

  .pipeline { margin-bottom: 48px; }
  .pipeline-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pipe-card { padding: 20px 20px 22px; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 6px; transition: border-color .15s ease, transform .15s ease; }
  .pipe-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pipe-step { font-family: var(--font-mono); color: var(--gold); font-size: 0.78rem; }
  .pipe-card h3 { font-size: 1.1rem; margin-top: 2px; }
  .pipe-meta { font-size: 0.76rem; color: var(--ink-faint); font-family: var(--font-mono); }
  .pipe-desc { font-size: 0.87rem; color: var(--ink-soft); margin-top: 4px; flex: 1; }
  .pipe-marks { margin-top: 10px; font-size: 0.95rem; }

  .split { margin-bottom: 48px; }
  .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .split-card { padding: 22px 22px 24px; }
  .split-card h3 { font-size: 1.3rem; margin-top: 6px; }
  .split-desc { font-size: 0.88rem; color: var(--ink-soft); margin: 8px 0 18px; }
  .split-foot { margin-top: 16px; font-size: 0.82rem; color: var(--accent-dim); font-weight: 500; }

  .source-list { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 8px; font-size: 0.9rem; }
  .source-list li { display: flex; gap: 10px; align-items: baseline; }
  .disclaimer { font-size: 0.82rem; color: var(--ink-faint); max-width: 68ch; line-height: 1.6; }
  .disclaimer a { color: var(--accent-dim); text-decoration: underline; }

  @media (max-width: 720px) {
    .pipeline-grid, .split-grid { grid-template-columns: 1fr; }
  }
</style>



