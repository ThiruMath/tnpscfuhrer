---
import Layout from "../../../layouts/SyllabusLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { prelims, mainsGroup2, mainsGroup2A, paper2Pattern } from "../../../data/examScheme";
---
<Layout title="Exam Scheme" description="Full TNPSC Group II / IIA exam scheme: preliminary, mains, and the descriptive question paper pattern.">
  <div class="wrap">
    <PageHeader
      eyebrow="Exam Scheme"
      title="How the exam is structured, stage by stage"
      tamilTitle="தேர்வுத் திட்டம்"
      description="Two stages of writing plus, for Group II only, an interview. The tables below give the exact standard, question type, and marks for every paper."
    />

    <section class="block">
      <h2>1 &middot; Preliminary Examination <span class="code">Code 495</span></h2>
      <p class="lede">{prelims.note}</p>
      <table>
        <thead>
          <tr><th>Section</th><th>Subject</th><th>Standard</th><th>Type</th><th>Nature</th><th class="num">Questions</th><th class="num">Marks</th></tr>
        </thead>
        <tbody>
          {prelims.sections.map((s) => (
            <tr>
              <td>{s.key}</td>
              <td>{s.name}</td>
              <td>{s.standard}</td>
              <td>{s.type}</td>
              <td>{s.nature}</td>
              <td class="num">{s.questions}</td>
              <td class="num">{s.marks}</td>
            </tr>
          ))}
          <tr class="total-row">
            <td colspan="5">Total</td>
            <td class="num">{prelims.totalQuestions}</td>
            <td class="num">{prelims.totalMarks}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="block">
      <h2>2 &middot; Mains — Group II <span class="code">Code 469</span></h2>
      <table>
        <thead>
          <tr><th>Paper</th><th>Subject</th><th>Standard</th><th>Type</th><th>Nature</th><th class="num">Marks</th></tr>
        </thead>
        <tbody>
          {mainsGroup2.papers.map((p) => (
            <tr>
              <td>{p.code}</td>
              <td>{p.name}</td>
              <td>{p.standard}</td>
              <td>{p.type}</td>
              <td>{p.nature}</td>
              <td class="num">{p.marks}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="foot-note">→ {mainsGroup2.followedBy}</p>
    </section>

    <section class="block">
      <h2>3 &middot; Mains — Group IIA <span class="code">Code 583</span></h2>
      <table>
        <thead>
          <tr><th>Paper</th><th>Subject</th><th>Standard</th><th>Type</th><th>Nature</th><th class="num">Marks</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>{mainsGroup2A.papers[0].code}</td>
            <td>{mainsGroup2A.papers[0].name}</td>
            <td>{mainsGroup2A.papers[0].standard}</td>
            <td>{mainsGroup2A.papers[0].type}</td>
            <td>{mainsGroup2A.papers[0].nature}</td>
            <td class="num">{mainsGroup2A.papers[0].marks}</td>
          </tr>
          <tr>
            <td rowspan="3">{mainsGroup2A.papers[1].code}</td>
            <td colspan="4">{mainsGroup2A.papers[1].name}</td>
            <td class="num">{mainsGroup2A.papers[1].marks}</td>
          </tr>
          {mainsGroup2A.papers[1].subparts?.map((sp) => (
            <tr class="sub-row">
              <td colspan="4">{sp.name} &middot; {sp.standard} &middot; {sp.questions} questions</td>
              <td class="num">{sp.marks}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="foot-note">→ {mainsGroup2A.followedBy}</p>
    </section>

    <section class="block">
      <h2>4 &middot; Descriptive pattern — Group II, Paper II</h2>
      <p class="lede">General Studies (Degree Standard) &middot; {paper2Pattern.totalMarks} marks &middot; {paper2Pattern.duration}</p>
      {paper2Pattern.parts.map((part) => (
        <div class="pattern-card card">
          <div class="pattern-head">
            <h3>Part {part.part} &mdash; {part.label}</h3>
            <span class="pattern-marks stamp-number">{part.marks} marks</span>
          </div>
          <p class="pattern-instruction">{part.instruction}</p>
          <table class="pattern-table">
            <thead>
              <tr><th>Unit</th>{part.rows[0].section && <th>Section</th>}<th class="num">Questions set</th></tr>
            </thead>
            <tbody>
              {part.rows.map((r) => (
                <tr>
                  <td>{r.unit}</td>
                  {r.section && <td>{r.section}</td>}
                  <td class="num">{r.count}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="pattern-foot">Answer {part.answered} of {part.totalQuestions} &middot; {part.words}</p>
        </div>
      ))}
    </section>
  </div>
</Layout>

<style>
  .block { margin-bottom: 44px; }
  .block h2 { font-size: 1.2rem; margin-bottom: 6px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .code { font-family: var(--font-mono); font-size: 0.7rem; color: var(--gold); background: var(--gold-soft); padding: 2px 7px; border-radius: 3px; }
  .lede { color: var(--ink-soft); font-size: 0.9rem; margin-bottom: 14px; max-width: 68ch; }
  table { margin-top: 6px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .total-row td { font-weight: 600; background: var(--accent-soft); border-bottom: none; }
  .sub-row td { color: var(--ink-soft); font-size: 0.85rem; padding-top: 6px; padding-bottom: 6px; }
  .foot-note { margin-top: 10px; font-size: 0.88rem; color: var(--accent-dim); font-weight: 500; }

  .pattern-card { padding: 18px 20px 20px; margin-top: 14px; }
  .pattern-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .pattern-head h3 { font-size: 1.02rem; }
  .pattern-marks { font-size: 0.95rem; }
  .pattern-instruction { font-size: 0.85rem; color: var(--ink-soft); margin: 6px 0 12px; }
  .pattern-table { border: 1px solid var(--line); }
  .pattern-foot { margin-top: 10px; font-size: 0.8rem; color: var(--ink-faint); font-family: var(--font-mono); }
</style>


