---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');

// Category mapping
const categoryMap: Record<string, { color: string; desc: string }> = {
  'History':        { color: 'var(--accent)',  desc: 'Ancient, Medieval, Modern & Tamil History' },
  'Polity':         { color: 'var(--blue)',    desc: 'Constitution, Rights, Parliament & Judiciary' },
  'Economy':        { color: 'var(--green)',   desc: 'Indian Economy, Banking, Planning & GST' },
  'Geography':      { color: '#0369a1',        desc: 'Physical, Human & Tamil Nadu Geography' },
  'Science':        { color: 'var(--purple)',  desc: 'Physics, Chemistry, Biology & Environment' },
  'Tamil':          { color: '#be185d',        desc: 'Tamil Literature, Grammar & Scholars' },
  'Current Affairs':{ color: 'var(--amber)',   desc: 'Monthly Updates & News' },
  'Aptitude':       { color: '#0891b2',        desc: 'Maths, Reasoning & Mental Ability' },
  'Other':          { color: 'var(--text-muted)', desc: 'General Knowledge & Miscellaneous' },
};

// Sort by update date
const sortedNotes = [...allNotes].sort((a, b) => {
  const dateA = a.data.last_updated ? new Date(a.data.last_updated).getTime() : 0;
  const dateB = b.data.last_updated ? new Date(b.data.last_updated).getTime() : 0;
  return dateB - dateA;
});

// Categorize
function getCategory(note: any): string {
  if (note.data.subject) return note.data.subject;
  const slug = note.slug.toLowerCase();
  const body = (note.body || '').toLowerCase().slice(0, 300);
  const combined = slug + ' ' + body;
  if (/history|ancient|medieval|mughal|sangam|chola|pallav|vijayanagar|freedom|national movement|revolt/.test(combined)) return 'History';
  if (/polity|constitution|parliament|fundamental|judiciary|election|governor|president|lokpal/.test(combined)) return 'Polity';
  if (/economy|bank|gdp|planning|fiscal|monetary|rbi|gst|inflation|poverty|budget|revenue|tax/.test(combined)) return 'Economy';
  if (/geography|monsoon|river|soil|climate|rainfall|forest|wildlife|district/.test(combined)) return 'Geography';
  if (/science|physics|chemistry|biology|ecology|genetics|laser|nuclear|nutrition/.test(combined)) return 'Science';
  if (/tamil|இலக்கணம்|குறள்|சங்க|பாரதி|தமிழ்|grammar|literature|kavimani/.test(combined)) return 'Tamil';
  if (/current affairs|ca\.|jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec/.test(combined)) return 'Current Affairs';
  if (/aptitude|simplification|hcf|lcm|percentage|ratio|profit|loss|reasoning|puzzle/.test(combined)) return 'Aptitude';
  return 'Other';
}

const categories: Record<string, any[]> = {};
for (const note of sortedNotes) {
  const cat = getCategory(note);
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push({ ...note, category: cat });
}

const catOrder = ['History','Polity','Economy','Geography','Science','Tamil','Current Affairs','Aptitude','Other'];
const orderedCats = catOrder.filter(c => categories[c]?.length > 0);
const totalNotes = allNotes.length;

// Flatten for search
const allNotesFlat = sortedNotes.map(n => ({
  title: n.data.title || n.slug.replace(/-/g, ' '),
  slug: n.slug,
  category: getCategory(n),
  wordCount: Math.round((n.body || '').length / 5),
}));
---

<Layout title="Study Notes Library" description="900+ searchable study notes for TNPSC Group II/IIA, organized by subject." active="Study Notes">

  <!-- Header -->
  <div class="page-header animate-in">
    <div class="flex items-center gap-3 mb-3">
      <span class="badge badge-blue">{totalNotes}+ Notes</span>
      <span class="badge badge-green">{orderedCats.length} Subjects</span>
    </div>
    <h1>Study Notes Library</h1>
    <p>Structured, exam-ready notes organized by subject. Search, filter, and track your reading.</p>
  </div>

  <!-- Search bar -->
  <div class="notes-search-wrap animate-in mb-6" style="animation-delay: 100ms;">
    <svg class="notes-search-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="m21 21-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <input type="text" id="notes-search" placeholder="Search notes by topic, title, keyword..." autocomplete="off" />
    <span class="notes-search-count text-mono text-muted" id="notes-count">{totalNotes} notes</span>
  </div>

  <!-- Category filter pills -->
  <div class="flex gap-2 mb-6 flex-wrap animate-in" style="animation-delay: 150ms;">
    <button class="cat-pill active" data-cat="all">All</button>
    {orderedCats.map(cat => (
      <button class="cat-pill" data-cat={cat}>
        {cat} <span class="cat-pill-count">{categories[cat]?.length}</span>
      </button>
    ))}
  </div>

  <!-- Notes grid -->
  <div class="notes-grid stagger" id="notes-grid">
    {allNotesFlat.map(note => (
      <a href={`/notes/${note.slug}`} class="note-card card-interactive" data-title={note.title.toLowerCase()} data-category={note.category}>
        <div class="flex items-center justify-between mb-3">
          <span class="badge badge-neutral" style="font-size: 0.65rem;">{note.category}</span>
          {note.wordCount > 50 && (
            <span class="text-muted" style="font-size: 0.7rem;">{Math.round(note.wordCount / 200)} min read</span>
          )}
        </div>
        <h3 class="note-card-title">{note.title}</h3>
        {note.wordCount > 0 && (
          <div class="text-muted" style="font-size: 0.75rem; margin-top: auto; padding-top: var(--space-3);">
            {note.wordCount.toLocaleString()} words
          </div>
        )}
      </a>
    ))}
  </div>

  <!-- Empty state -->
  <div id="notes-empty" style="display: none; text-align: center; padding: var(--space-12) 0; color: var(--text-muted);">
    <div style="font-size: 2rem; margin-bottom: var(--space-4);">🔍</div>
    <p style="font-size: 1rem; font-weight: 500;">No notes found</p>
    <p style="font-size: 0.85rem;">Try a different search term or category</p>
  </div>

</Layout>

<style>
  /* Search */
  .notes-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-5);
    transition: border-color var(--duration-fast);
  }
  .notes-search-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .notes-search-icon { width: 18px; height: 18px; color: var(--text-muted); flex-shrink: 0; margin-right: var(--space-3); }
  #notes-search {
    flex: 1; border: none; outline: none; background: transparent;
    font-size: 0.95rem; color: var(--text);
  }
  #notes-search::placeholder { color: var(--text-faint); }
  .notes-search-count { font-size: 0.78rem; flex-shrink: 0; }

  /* Category pills */
  .cat-pill {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.78rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  .cat-pill:hover { border-color: var(--border-hover); color: var(--text); }
  .cat-pill.active { background: var(--text); color: var(--text-inverse); border-color: var(--text); }
  .cat-pill-count {
    background: rgba(0,0,0,0.1);
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    font-family: var(--font-mono); font-size: 0.7rem;
  }
  .cat-pill.active .cat-pill-count { background: rgba(255,255,255,0.2); }

  /* Notes grid */
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  /* Note card */
  .note-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 120px;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .note-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
    border-color: var(--border-hover);
  }
  .note-card-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .notes-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const searchInput = document.getElementById('notes-search') as HTMLInputElement;
  const notesGrid = document.getElementById('notes-grid')!;
  const notesCount = document.getElementById('notes-count')!;
  const emptyState = document.getElementById('notes-empty')!;
  const catPills = document.querySelectorAll('.cat-pill');
  const allCards = Array.from(notesGrid.querySelectorAll('.note-card')) as HTMLElement[];

  let activeCat = 'all';

  function filterNotes() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    allCards.forEach(card => {
      const title = card.dataset.title || '';
      const category = card.dataset.category || '';
      const matchesSearch = !query || title.includes(query);
      const matchesCat = activeCat === 'all' || category === activeCat;
      const show = matchesSearch && matchesCat;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    notesCount.textContent = `${visible} notes`;
    emptyState.style.display = visible === 0 ? '' : 'none';
    notesGrid.style.display = visible === 0 ? 'none' : '';
  }

  searchInput.addEventListener('input', filterNotes);

  catPills.forEach(pill => {
    pill.addEventListener('click', () => {
      catPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCat = (pill as HTMLElement).dataset.cat || 'all';
      filterNotes();
    });
  });
</script>