---
import Layout from '../layouts/Layout.astro';

const alphabet = [
  { char: 'அ', roman: 'a' }, { char: 'ஆ', roman: 'ā' }, { char: 'இ', roman: 'i' },
  { char: 'ஈ', roman: 'ī' }, { char: 'உ', roman: 'u' }, { char: 'ஊ', roman: 'ū' },
  { char: 'எ', roman: 'e' }, { char: 'ஏ', roman: 'ē' }, { char: 'ஐ', roman: 'ai' },
  { char: 'ஒ', roman: 'o' }, { char: 'ஓ', roman: 'ō' }, { char: 'ஔ', roman: 'au' },
  { char: 'க', roman: 'ka' }, { char: 'ங', roman: 'ṅa' }, { char: 'ச', roman: 'ca' },
  { char: 'ஞ', roman: 'ña' }, { char: 'ட', roman: 'ṭa' }, { char: 'ண', roman: 'ṇa' },
  { char: 'த', roman: 'ta' }, { char: 'ந', roman: 'na' }, { char: 'ப', roman: 'pa' },
  { char: 'ம', roman: 'ma' }, { char: 'ய', roman: 'ya' }, { char: 'ர', roman: 'ra' },
  { char: 'ல', roman: 'la' }, { char: 'வ', roman: 'va' }, { char: 'ழ', roman: 'ḻa' },
  { char: 'ள', roman: 'ḷa' }, { char: 'ற', roman: 'ṟa' }, { char: 'ன', roman: 'ṉa' },
];

const facts = [
  { num: '5th', label: 'century BCE', detail: 'Earliest dated Tamil inscriptions — among the oldest in South Asia.' },
  { num: '80+', label: 'languages', detail: 'The Thirukkural has been translated into more languages than any other Indian text.' },
  { num: '2,500+', label: 'Sangam poems', detail: 'Preserved in the eight anthologies, collected over several centuries.' },
  { num: '1', label: 'living classical language', detail: 'Tamil is the only ancient classical language with an unbroken living tradition.' },
  { num: '18', label: 'minor works', detail: 'The Pathinenkilkanakku — eighteen minor works of the post-Sangam era.' },
  { num: '3', label: 'books of the Kural', detail: 'Aram (virtue), Porul (wealth), and Inbam (love) — all of human life in couplets.' },
];

const words = [
  { word: 'அகம்', roman: 'akam', meaning: 'The interior — love poetry of the private heart' },
  { word: 'புறம்', roman: 'puram', meaning: 'The exterior — public poetry of war and kings' },
  { word: 'திணை', roman: 'tiṇai', meaning: 'Landscape-based genre — the tinai system' },
  { word: 'உரை', roman: 'urai', meaning: 'Classical commentary — the living tradition of interpretation' },
  { word: 'கட்டளை', roman: 'kaṭṭaḷai', meaning: 'The meter — precise rhythmic rules governing Tamil verse' },
  { word: 'மரபு', roman: 'marabu', meaning: 'The tradition — the unbroken thread of Tamil letters' },
  { word: 'சுவை', roman: 'cuvai', meaning: 'Aesthetic flavour — the rasa of Tamil poetic experience' },
  { word: 'கலை', roman: 'kalai', meaning: 'Art — the integration of music, dance, and poetry' },
];
---
<Layout title="Explore Tamil Literature" description="Explore the Tamil script, key facts, literary vocabulary, and resources." active="Explore">

  <!-- HERO -->
  <div class="page-header animate-in">
    <span class="badge badge-accent mb-3">Interactive Journey</span>
    <h1>Explore <span class="text-secondary" style="font-family: 'Noto Sans Tamil', sans-serif;">(ஆராயுங்கள்)</span></h1>
    <p>The Tamil script. Key numbers. Literary vocabulary. Everything you need to begin exploring the world's oldest living classical literary tradition.</p>
  </div>

  <!-- TIMELINE VISUAL -->
  <section class="mb-10 animate-in" style="animation-delay: 100ms;">
    <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">Literary History at a Glance</h2>
    <div class="card">
      <div class="vt-track">
        {[
          { year: '~500 BCE', event: 'Earliest Tamil Brahmi inscriptions', type: 'milestone' },
          { year: '~300 BCE', event: 'Sangam academy (legend)', type: 'era' },
          { year: '~200 BCE', event: 'Tolkappiyam — Tamil grammar', type: 'milestone' },
          { year: '~100 CE', event: 'Peak of Sangam poetry', type: 'era' },
          { year: '~200 CE', event: 'Silappadikaram composed', type: 'milestone' },
          { year: '~300 CE', event: 'Thirukkural composed', type: 'milestone' },
          { year: '~500 CE', event: 'Manimekalai, Civaka Cintamani', type: 'milestone' },
          { year: '~700 CE', event: 'Nayanmars compose Tevaram', type: 'era' },
          { year: '~900 CE', event: 'Nammalvar — Thiruvaymoli', type: 'milestone' },
          { year: '~1180 CE', event: 'Kambar — Kambaramayanam', type: 'milestone' },
          { year: 'Today', event: 'Tamil spoken by 80 million people worldwide', type: 'present' },
        ].map((item) => (
          <div class={`vt-item vt-item--${item.type}`}>
            <div class="vt-dot"></div>
            <div class="vt-body">
              <span class="vt-year">{item.year}</span>
              <span class="vt-event">{item.event}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KEY FACTS -->
  <section class="mb-10 animate-in" style="animation-delay: 200ms;">
    <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">By the Numbers</h2>
    <div class="grid grid-3 stagger">
      {facts.map((f) => (
        <div class="stat-card">
          <div class="stat-label text-accent">{f.label}</div>
          <div class="stat-value text-mono" style="font-size: 2.25rem;">{f.num}</div>
          <div class="stat-footer mt-2" style="white-space: normal; line-height: 1.4;">{f.detail}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- LITERARY VOCABULARY -->
  <section class="mb-10 animate-in" style="animation-delay: 300ms;">
    <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">Key Literary Terms</h2>
    <div class="grid grid-4">
      {words.map((w) => (
        <div class="card text-center" style="padding: var(--space-5) var(--space-3);">
          <div style="font-family: 'Noto Sans Tamil', sans-serif; font-size: 1.75rem; color: var(--accent); margin-bottom: var(--space-1);">{w.word}</div>
          <div style="font-style: italic; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: var(--space-3);">{w.roman}</div>
          <div style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">{w.meaning}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="grid grid-2 mb-10 gap-6">
    <!-- TAMIL SCRIPT FULL ALPHABET -->
    <section class="animate-in" style="animation-delay: 400ms;">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">The Living Alphabet</h2>
      <div class="card">
        <p class="text-secondary mb-4" style="font-size: 0.9rem;">Tamil script is a Brahmic abugida with 12 vowels, 18 consonants, and 216 combined forms.</p>
        <div class="alphabet-grid">
          {alphabet.map((letter) => (
            <div class="alpha-cell">
              <span class="alpha-char">{letter.char}</span>
              <span class="alpha-roman">{letter.roman}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INTERACTIVE KURAL RANDOMIZER -->
    <section class="animate-in" style="animation-delay: 500ms;">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">Daily Wisdom</h2>
      <div class="card flex flex-col justify-between" id="kuralCard" style="height: calc(100% - 2.5rem); position: relative; overflow: hidden;">
        <div class="krc-decor"></div>
        <div>
          <div class="text-mono text-accent mb-4" id="kuralNum" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Kural 1</div>
          <p style="font-family: 'Noto Sans Tamil', sans-serif; font-size: 1.25rem; color: var(--text); line-height: 1.8; margin-bottom: var(--space-4);" id="kuralTamil">அகர முதல எழுத்தெல்லாம் ஆதி<br/>பகவன் முதற்றே உலகு.</p>
          <div style="width: 2rem; height: 2px; background: var(--accent); margin-bottom: var(--space-4); opacity: 0.3;"></div>
          <p style="font-style: italic; font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: var(--space-3);" id="kuralEn">As the letter "A" is the first of all letters, so the Eternal is first in the world.</p>
          <p class="text-muted" style="font-size: 0.8rem;" id="kuralChapter">Chapter: The Praise of God · Book of Virtue</p>
        </div>
        <button class="btn btn-outline w-full mt-6" id="nextKural">Next Kural ↻</button>
      </div>
    </section>
  </div>

  <!-- NAV CARDS TO OTHER SECTIONS -->
  <section class="mb-10 animate-in" style="animation-delay: 600ms;">
    <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">Where to Next</h2>
    <div class="grid grid-4">
      <a href="/sangam" class="card card-interactive flex flex-col h-full" style="text-decoration: none;">
        <span class="text-accent mb-2" style="font-family: 'Noto Sans Tamil', sans-serif; font-size: 0.85rem;">சங்க காலம்</span>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2); color: var(--text);">Sangam Era</h3>
        <p class="text-muted mb-4" style="font-size: 0.85rem; flex: 1;">Ancient love poems and war ballads from 300 BCE</p>
        <div class="text-secondary" style="font-size: 1.2rem; align-self: flex-end;">→</div>
      </a>
      <a href="/epics" class="card card-interactive flex flex-col h-full" style="text-decoration: none;">
        <span class="text-accent mb-2" style="font-family: 'Noto Sans Tamil', sans-serif; font-size: 0.85rem;">காப்பியங்கள்</span>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2); color: var(--text);">The Epics</h3>
        <p class="text-muted mb-4" style="font-size: 0.85rem; flex: 1;">Five great narrative epics — Jain, Buddhist, and Hindu</p>
        <div class="text-secondary" style="font-size: 1.2rem; align-self: flex-end;">→</div>
      </a>
      <a href="/poets" class="card card-interactive flex flex-col h-full" style="text-decoration: none;">
        <span class="text-accent mb-2" style="font-family: 'Noto Sans Tamil', sans-serif; font-size: 0.85rem;">கவிஞர்கள்</span>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2); color: var(--text);">The Poets</h3>
        <p class="text-muted mb-4" style="font-size: 0.85rem; flex: 1;">Thiruvalluvar, Avvaiyar, Kambar, and the great voices</p>
        <div class="text-secondary" style="font-size: 1.2rem; align-self: flex-end;">→</div>
      </a>
      <a href="/kurals" class="card card-interactive flex flex-col h-full" style="text-decoration: none;">
        <span class="text-accent mb-2" style="font-family: 'Noto Sans Tamil', sans-serif; font-size: 0.85rem;">திருக்குறள்</span>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2); color: var(--text);">Thirukkural</h3>
        <p class="text-muted mb-4" style="font-size: 0.85rem; flex: 1;">1,330 couplets on virtue, wealth, and love</p>
        <div class="text-secondary" style="font-size: 1.2rem; align-self: flex-end;">→</div>
      </a>
    </div>
  </section>

</Layout>

<script>
  const kurals = [
    { num: 1, tamil: 'அகர முதல எழுத்தெல்லாம் ஆதி<br/>பகவன் முதற்றே உலகு.', en: 'As the letter "A" is the first of all letters, so the Eternal is first in the world.', chapter: 'The Praise of God · Book of Virtue' },
    { num: 215, tamil: 'நன்றிமறப்பது நன்றன்று நன்றல்லது<br/>அன்றே மறப்பது நன்று.', en: 'To forget a kindness is not good; it is good to forget, at once, an unkindness.', chapter: 'Gratitude · Book of Virtue' },
    { num: 391, tamil: 'அழுக்காறு உடையார்க்கு அதுசாலும்<br/>வழுக்கியும் கேடீன்பது இல்.', en: 'Envy itself is sufficient punishment for the envious; no enemy need add to their ruin.', chapter: 'The Avoidance of Envy · Book of Virtue' },
    { num: 625, tamil: 'ஒற்கத்தில் ஒல்கார் உரவோர் இடர்வரினும்<br/>தற்கொல் தகுதியே கொள்.', en: 'The strong do not bend in adversity; when trouble comes, they accept what is fitting.', chapter: 'Maintaining Dignity in Poverty · Book of Wealth' },
    { num: 1101, tamil: 'கண்டுகேட்டு உண்டுயிர்த்து உற்றறிவும் ஐம்புலனும்<br/>ஒண்டொடி கண்ணே உள.', en: 'The five senses — sight, hearing, taste, smell, and touch — all reside in the one with shining bangles.', chapter: 'The Praise of Her Beauty · Book of Love' },
    { num: 10, tamil: 'பிறவிப் பெருங்கடல் நீந்துவர் நீந்தார்<br/>இறைவன் அடிசேரா தார்.', en: 'They will cross the great sea of births who seek the feet of God; those who do not, cannot.', chapter: 'The Praise of God · Book of Virtue' },
    { num: 423, tamil: 'அரம்பொருத பண்டம் போல் அன்னார்க்கு உற்ற<br/>விரம்பியும் ஊக்கம் தரும்.', en: 'Like a file sharpening iron tools, hardship only makes the strong grow stronger.', chapter: 'The Greatness of Fortitude · Book of Wealth' },
  ];

  let current = 0;
  const card = document.getElementById('kuralCard');
  const numEl = document.getElementById('kuralNum');
  const tamilEl = document.getElementById('kuralTamil');
  const enEl = document.getElementById('kuralEn');
  const chEl = document.getElementById('kuralChapter');
  const btn = document.getElementById('nextKural');

  function showKural(k: any) {
    if (!card || !numEl || !tamilEl || !enEl || !chEl) return;
    card.style.opacity = '0';
    setTimeout(() => {
      numEl.textContent = 'Kural ' + k.num;
      tamilEl.innerHTML = k.tamil;
      enEl.textContent = k.en;
      chEl.textContent = 'Chapter: ' + k.chapter;
      card.style.opacity = '1';
    }, 300);
  }

  btn?.addEventListener('click', () => {
    current = (current + 1) % kurals.length;
    showKural(kurals[current]);
  });
</script>

<style>
  /* TIMELINE */
  .vt-track {
    position: relative;
    padding-left: 2rem;
  }
  .vt-track::before {
    content: ''; position: absolute;
    left: 7px; top: 0; bottom: 0; width: 2px;
    background: var(--surface-sunken);
  }
  .vt-item {
    display: flex; align-items: flex-start; gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .vt-item:last-child { margin-bottom: 0; }
  
  .vt-dot {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--surface); border: 4px solid var(--border-hover);
    flex-shrink: 0; margin-left: -2.4rem; z-index: 1; margin-top: 2px;
  }
  .vt-item--milestone .vt-dot { border-color: var(--accent); }
  .vt-item--present .vt-dot { border-color: var(--green); background: var(--green); }
  
  .vt-body { display: flex; flex-direction: column; gap: 0.2rem; }
  .vt-year {
    font-size: 0.75rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--text-muted); font-weight: 700;
  }
  .vt-item--milestone .vt-year { color: var(--accent); }
  .vt-item--present .vt-year { color: var(--green); }
  .vt-event { font-size: 0.95rem; color: var(--text); }

  /* ALPHABET */
  .alphabet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(50px, 1fr));
    gap: 4px;
  }
  .alpha-cell {
    display: flex; flex-direction: column; align-items: center;
    padding: var(--space-3) var(--space-1);
    background: var(--surface-raised); border-radius: var(--radius-sm);
    transition: all 0.2s;
  }
  .alpha-cell:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); transform: translateY(-2px); }
  .alpha-char { font-family: 'Noto Sans Tamil', sans-serif; font-size: 1.5rem; color: var(--text); line-height: 1.2; margin-bottom: 0.2rem; }
  .alpha-cell:hover .alpha-char { color: var(--accent); }
  .alpha-roman { font-size: 0.7rem; color: var(--text-muted); font-style: italic; }

  /* DECOR */
  .krc-decor {
    position: absolute; top: 0; right: 0; bottom: 0; width: 120px;
    background: linear-gradient(to left, color-mix(in srgb, var(--accent) 5%, transparent), transparent);
    pointer-events: none;
  }
  #kuralCard { transition: opacity 0.3s; }
</style>
