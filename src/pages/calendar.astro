---
import Layout from '../layouts/Layout.astro';

const exams = [
  {
    id: 'grp2',
    name: 'Group II / IIA (CSSE-II)',
    date: '2026-07-12',
    status: 'Confirmed',
    posts: 'Combined Civil Services Examination - II',
    vacancies: '6,318',
    subjects: ['Tamil', 'General Studies', 'Aptitude', 'History', 'Polity', 'Geography', 'Economy', 'Science'],
    syllabus: '/syllabus'
  },
  {
    id: 'cts-2026',
    name: 'Combined Technical Services Exam',
    date: '2026-08-22',
    status: 'Open',
    posts: 'Assistant Geologist, Assistant Engineer, Agriculture Officer',
    vacancies: '461',
    subjects: ['Tamil Eligibility', 'General Studies', 'Aptitude', 'Technical Optional Subjects'],
    syllabus: 'https://tnpsc.gov.in/document/english/CTS%28Non%20Interview%29%20English%20Final_.pdf'
  },
  {
    id: 'grp4',
    name: 'Group IV (CSSE-IV)',
    date: '2026-09-21',
    status: 'Tentative',
    posts: 'VAO, Junior Assistant, Typist',
    vacancies: '9,351',
    subjects: ['Tamil', 'General Knowledge', 'Aptitude & Mental Ability'],
    syllabus: '/syllabus'
  },
  {
    id: 'grp1-prelims',
    name: 'Group I Prelims',
    date: '2026-11-15',
    status: 'Tentative',
    posts: 'Deputy Collector, DSP, Assistant Commissioner',
    vacancies: '92',
    subjects: ['General Studies', 'Aptitude', 'Mental Ability'],
    syllabus: '/syllabus'
  }
];

function daysUntil(dateStr: string): number {
  const target = new Date(dateStr);
  const today = new Date();
  return Math.max(0, Math.ceil((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24)));
}

function weeksUntil(dateStr: string): number {
  return Math.floor(daysUntil(dateStr) / 7);
}
---

<Layout title="Exam Calendar" description="Track all TNPSC exam dates and manage your study plans." active="Calendar">

  <script define:vars={{ exams }}>
    window.__EXAM_DATA__ = exams;
  </script>

  <div class="page-header animate-in">
    <span class="badge badge-accent mb-3">Calendar & Planning</span>
    <h1>TNPSC Exam Calendar</h1>
    <p>Track upcoming exams, create a personalized study plan, and monitor your daily progress.</p>
  </div>

  <div class="grid grid-2 mb-8 stagger">
    {exams.map((exam) => (
      <div class="card card-interactive" data-exam-id={exam.id}>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="text-mono" style="font-size: 2rem; font-weight: 700; color: var(--accent); line-height: 1;">
              {daysUntil(exam.date)}
            </div>
            <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; line-height: 1.2;">
              Days<br/>Left
            </div>
          </div>
          <span class={`badge ${exam.status === 'Confirmed' ? 'badge-green' : exam.status === 'Tentative' ? 'badge-amber' : 'badge-blue'}`}>
            {exam.status}
          </span>
        </div>
        
        <h3 style="font-size: 1.15rem; margin-bottom: var(--space-1);">{exam.name}</h3>
        <p class="text-secondary" style="font-size: 0.85rem; margin-bottom: var(--space-4);">{exam.posts}</p>
        
        <div class="flex gap-4 text-muted mb-4" style="font-size: 0.8rem;">
          <span class="flex items-center gap-1">
            <svg style="width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2;" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            {new Date(exam.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
          </span>
          <span class="flex items-center gap-1">
            <svg style="width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2;" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            {exam.vacancies} posts
          </span>
        </div>

        <div class="flex flex-wrap gap-2 mb-5">
          {exam.subjects.slice(0, 3).map(s => (
            <span class="badge badge-neutral" style="font-size: 0.7rem;">{s}</span>
          ))}
          {exam.subjects.length > 3 && (
            <span class="badge badge-neutral" style="font-size: 0.7rem;">+{exam.subjects.length - 3} more</span>
          )}
        </div>

        <div class="flex items-center gap-3 mt-auto pt-4" style="border-top: 1px solid var(--border-subtle);">
          <button class="btn btn-primary plan-btn" data-exam={exam.id} data-weeks={weeksUntil(exam.date)} data-subjects={JSON.stringify(exam.subjects)} data-name={exam.name}>
            Create Plan
          </button>
          <a href={exam.syllabus} class="btn btn-outline">Syllabus</a>
        </div>
      </div>
    ))}
  </div>

  <div class="planner-layout animate-in" style="animation-delay: 200ms;">
    <!-- Study Planner Section -->
    <div class="planner-main">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">My Study Planner</h2>
      
      <div id="planner-empty" class="card" style="text-align: center; padding: var(--space-8);">
        <div style="font-size: 2.5rem; margin-bottom: var(--space-3);">📅</div>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-2);">No active plans</h3>
        <p class="text-secondary" style="font-size: 0.9rem;">Click "Create Plan" on any exam above to generate a weekly schedule.</p>
      </div>

      <div id="planner-container" style="display: none;">
        <div class="flex gap-2 mb-4 flex-wrap" id="planner-tabs"></div>
        <div class="card" id="planner-content" style="padding: var(--space-5);"></div>
      </div>
    </div>

    <!-- Tracker Sidebar -->
    <aside class="planner-sidebar">
      <h2 style="font-size: 1.25rem; margin-bottom: var(--space-4);">Progress</h2>
      
      <div class="stat-card mb-4" style="text-align: center; padding: var(--space-6);">
        <div style="font-size: 2rem; margin-bottom: var(--space-2);">🔥</div>
        <div class="text-mono" id="streak-num" style="font-size: 2.5rem; font-weight: 700; color: var(--accent); line-height: 1;">0</div>
        <div class="stat-footer mb-4">Day Streak</div>
        <button class="btn btn-accent w-full" id="streak-btn">Mark Today Complete</button>
      </div>

      <div class="card">
        <h3 style="font-size: 0.9rem; margin-bottom: var(--space-3);">Last 30 Days</h3>
        <div id="heatmap" style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: var(--space-3);"></div>
        <div class="flex items-center gap-2 text-muted" style="font-size: 0.7rem;">
          <span>Less</span>
          <div style="width: 10px; height: 10px; border-radius: 2px; background: var(--border);"></div>
          <div style="width: 10px; height: 10px; border-radius: 2px; background: color-mix(in srgb, var(--green) 30%, transparent);"></div>
          <div style="width: 10px; height: 10px; border-radius: 2px; background: color-mix(in srgb, var(--green) 60%, transparent);"></div>
          <div style="width: 10px; height: 10px; border-radius: 2px; background: var(--green);"></div>
          <span>More</span>
        </div>
      </div>
    </aside>
  </div>

</Layout>

<style>
  .planner-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-6);
    align-items: start;
  }
  
  @media (max-width: 900px) {
    .planner-layout { grid-template-columns: 1fr; }
  }

  /* Plan tabs */
  :global(.ptab) {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.8rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer;
    transition: all var(--duration-fast);
  }
  :global(.ptab:hover) { border-color: var(--border-hover); color: var(--text); }
  :global(.ptab.active) { background: var(--text); color: var(--text-inverse); border-color: var(--text); }
  :global(.ptab-delete) { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 30%, transparent); margin-left: auto; }
  :global(.ptab-delete:hover) { background: var(--accent); color: white; border-color: var(--accent); }

  /* Plan progress bar */
  :global(.pp-bar) { height: 6px; background: var(--surface-sunken); border-radius: var(--radius-full); overflow: hidden; margin-bottom: var(--space-2); }
  :global(.pp-fill) { height: 100%; background: var(--accent); border-radius: var(--radius-full); transition: width var(--duration-normal); }
  :global(.pp-text) { font-size: 0.8rem; color: var(--text-secondary); font-weight: 500; }

  /* Weeks Grid */
  :global(.weeks-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); margin-top: var(--space-5); }
  :global(.week-card) {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4);
  }
  :global(.week-card.week-done) { border-color: var(--green); background: color-mix(in srgb, var(--green) 5%, transparent); }
  
  :global(.week-header) { display: flex; justify-content: space-between; margin-bottom: var(--space-3); }
  :global(.week-num) { font-weight: 600; font-size: 0.9rem; color: var(--text); }
  :global(.week-pct) { font-size: 0.8rem; font-weight: 700; color: var(--accent); }
  
  :global(.week-subjects) { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-bottom: var(--space-4); }
  :global(.ws-chip) { font-size: 0.65rem; background: var(--surface-raised); border: 1px solid var(--border); padding: 2px 6px; border-radius: var(--radius-sm); color: var(--text-secondary); }

  :global(.week-tasks) { display: flex; flex-direction: column; gap: var(--space-2); }
  :global(.task-item) {
    display: flex; align-items: flex-start; gap: var(--space-2); font-size: 0.82rem; color: var(--text);
    cursor: pointer; transition: opacity 0.15s;
  }
  :global(.task-item.task-done) { opacity: 0.5; text-decoration: line-through; }
  :global(.task-item input) { display: none; }
  :global(.task-check) {
    width: 16px; height: 16px; border: 1px solid var(--border-hover); border-radius: 4px;
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    margin-top: 2px; transition: all 0.15s;
  }
  :global(.task-item input:checked + .task-check) { background: var(--green); border-color: var(--green); }
  :global(.task-item input:checked + .task-check::after) { content: '✓'; color: #fff; font-size: 0.7rem; font-weight: 700; }

  /* Heatmap */
  :global(.hm-cell) {
    width: 16px; height: 16px; border-radius: 3px; background: var(--border);
    transition: background 0.2s;
  }
  :global(.hm-1) { background: color-mix(in srgb, var(--green) 30%, transparent); }
  :global(.hm-2) { background: color-mix(in srgb, var(--green) 60%, transparent); }
  :global(.hm-3) { background: var(--green); }
</style>

<script>
  interface StudyPlan {
    examId: string;
    examName: string;
    weeks: { weekNum: number; subjects: string[]; tasks: { name: string; done: boolean }[] }[];
    createdAt: string;
  }

  function getPlans(): StudyPlan[] {
    try { return JSON.parse(localStorage.getItem('tnpsc_plans') || '[]'); }
    catch { return []; }
  }

  function savePlans(plans: StudyPlan[]) {
    localStorage.setItem('tnpsc_plans', JSON.stringify(plans));
  }

  function createPlan(examId: string, examName: string, weeksAvail: number, subjects: string[]) {
    const plans = getPlans();
    if (plans.find(p => p.examId === examId)) {
      if (!confirm(`A plan for ${examName} already exists. Replace it?`)) return;
      const idx = plans.findIndex(p => p.examId === examId);
      plans.splice(idx, 1);
    }

    const weeks: StudyPlan['weeks'] = [];
    const totalWeeks = Math.max(weeksAvail, 1);

    for (let w = 0; w < totalWeeks; w++) {
      const weekSubjects: string[] = [];
      const subjectsPerWeek = Math.ceil(subjects.length / Math.min(totalWeeks, 8));
      for (let s = 0; s < subjectsPerWeek; s++) {
        const sIdx = (w * subjectsPerWeek + s) % subjects.length;
        weekSubjects.push(subjects[sIdx]);
      }

      weeks.push({
        weekNum: w + 1,
        subjects: weekSubjects,
        tasks: weekSubjects.map(s => ({ name: `Study ${s}`, done: false }))
          .concat([
            { name: 'Revision of previous topics', done: false },
            { name: 'Practice PYQ', done: false }
          ])
      });
    }

    plans.push({ examId, examName, weeks, createdAt: new Date().toISOString() });
    savePlans(plans);
    renderPlanner();
  }

  function renderPlanner() {
    const plans = getPlans();
    const empty = document.getElementById('planner-empty')!;
    const container = document.getElementById('planner-container')!;
    const tabs = document.getElementById('planner-tabs')!;
    
    if (!plans.length) {
      empty.style.display = 'block';
      container.style.display = 'none';
      return;
    }

    empty.style.display = 'none';
    container.style.display = 'block';

    tabs.innerHTML = plans.map((p, i) =>
      `<button class="ptab ${i === 0 ? 'active' : ''}" data-idx="${i}">${p.examName}</button>`
    ).join('') + `<button class="ptab ptab-delete" data-action="clear">Clear All</button>`;

    renderPlanContent(0);

    tabs.querySelectorAll('.ptab[data-idx]').forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.querySelectorAll('.ptab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        renderPlanContent(parseInt((tab as HTMLElement).dataset.idx!));
      });
    });

    tabs.querySelector('.ptab-delete')?.addEventListener('click', () => {
      if (confirm('Delete all study plans?')) {
        savePlans([]);
        renderPlanner();
      }
    });
  }

  function renderPlanContent(planIdx: number) {
    const plans = getPlans();
    const plan = plans[planIdx];
    if (!plan) return;
    const content = document.getElementById('planner-content')!;

    const totalTasks = plan.weeks.reduce((sum, w) => sum + w.tasks.length, 0);
    const doneTasks = plan.weeks.reduce((sum, w) => sum + w.tasks.filter(t => t.done).length, 0);
    const pct = totalTasks > 0 ? Math.round((doneTasks / totalTasks) * 100) : 0;

    let html = `
      <div class="plan-progress">
        <div class="pp-bar"><div class="pp-fill" style="width:${pct}%"></div></div>
        <span class="pp-text">${pct}% complete (${doneTasks}/${totalTasks} tasks)</span>
      </div>
      <div class="weeks-grid">
    `;

    plan.weeks.forEach((week, wi) => {
      const weekDone = week.tasks.filter(t => t.done).length;
      const weekTotal = week.tasks.length;
      const weekPct = weekTotal > 0 ? Math.round((weekDone / weekTotal) * 100) : 0;

      html += `
        <div class="week-card ${weekPct === 100 ? 'week-done' : ''}">
          <div class="week-header">
            <span class="week-num">Week ${week.weekNum}</span>
            <span class="week-pct">${weekPct}%</span>
          </div>
          <div class="week-subjects">
            ${week.subjects.map(s => `<span class="ws-chip">${s}</span>`).join('')}
          </div>
          <div class="week-tasks">
            ${week.tasks.map((task, ti) => `
              <label class="task-item ${task.done ? 'task-done' : ''}">
                <input type="checkbox" ${task.done ? 'checked' : ''} data-plan="${planIdx}" data-week="${wi}" data-task="${ti}" />
                <span class="task-check"></span>
                <span class="task-name">${task.name}</span>
              </label>
            `).join('')}
          </div>
        </div>
      `;
    });

    html += '</div>';
    content.innerHTML = html;

    content.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const el = e.target as HTMLInputElement;
        const pi = parseInt(el.dataset.plan!);
        const wi = parseInt(el.dataset.week!);
        const ti = parseInt(el.dataset.task!);
        const plans = getPlans();
        plans[pi].weeks[wi].tasks[ti].done = el.checked;
        savePlans(plans);
        renderPlanContent(pi);
      });
    });
  }

  // Streak Tracker
  function getStudyDays(): string[] {
    try { return JSON.parse(localStorage.getItem('tnpsc_study_days') || '[]'); }
    catch { return []; }
  }

  function saveStudyDays(days: string[]) {
    localStorage.setItem('tnpsc_study_days', JSON.stringify(days));
  }

  function todayStr(): string {
    return new Date().toISOString().split('T')[0];
  }

  function calculateStreak(): number {
    const days = getStudyDays().sort().reverse();
    if (!days.length) return 0;

    let streak = 0;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    for (let i = 0; i < 365; i++) {
      const check = new Date(today);
      check.setDate(check.getDate() - i);
      const checkStr = check.toISOString().split('T')[0];
      if (days.includes(checkStr)) {
        streak++;
      } else if (i > 0) {
        break;
      }
    }
    return streak;
  }

  function renderStreak() {
    const streak = calculateStreak();
    const el = document.getElementById('streak-num');
    if (el) el.textContent = streak.toString();

    const btn = document.getElementById('streak-btn') as HTMLButtonElement;
    const days = getStudyDays();
    if (days.includes(todayStr())) {
      btn.textContent = '✅ Completed Today';
      btn.disabled = true;
      btn.style.opacity = '0.7';
      btn.classList.remove('btn-accent');
      btn.classList.add('btn-outline');
    }
  }

  function renderHeatmap() {
    const container = document.getElementById('heatmap');
    if (!container) return;
    const days = getStudyDays();
    const today = new Date();
    let html = '';

    for (let i = 29; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(d.getDate() - i);
      const ds = d.toISOString().split('T')[0];
      const studied = days.includes(ds);
      const level = studied ? 3 : 0;
      const dayLabel = d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
      html += `<div class="hm-cell hm-${level}" title="${dayLabel}"></div>`;
    }
    container.innerHTML = html;
  }

  // Events
  document.querySelectorAll('.plan-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const examId = el.dataset.exam!;
      const examName = el.dataset.name!;
      const weeks = parseInt(el.dataset.weeks!);
      const subjects = JSON.parse(el.dataset.subjects!);
      createPlan(examId, examName, weeks, subjects);
    });
  });

  document.getElementById('streak-btn')?.addEventListener('click', () => {
    const days = getStudyDays();
    const today = todayStr();
    if (!days.includes(today)) {
      days.push(today);
      saveStudyDays(days);
      renderStreak();
      renderHeatmap();
    }
  });

  renderPlanner();
  renderStreak();
  renderHeatmap();
</script>
