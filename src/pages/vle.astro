---
import Layout from '../layouts/Layout.astro';
import downloads from '../../public/data/vle-downloads.json';

const vleFeatures = [
  { title: 'Study Materials & E-Content', description: 'Access official study materials, PDF notes, and structured e-content curated by the Department of Employment and Training.', icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>', color: 'var(--blue)' },
  { title: 'Mock Tests & Practice', description: 'Take online practice tests designed to simulate the real testing environment and assess your preparation.', icon: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>', color: 'var(--green)' },
  { title: 'Previous Year Papers', description: 'Download and review official previous year question papers to understand exam patterns.', icon: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/>', color: 'var(--accent)' },
  { title: 'Video Tutorials', description: 'Watch lessons and tutorials on the official TN Career Services Employment YouTube channel.', icon: '<polygon points="6 3 20 12 6 21 6 3"/>', color: 'var(--purple)' },
];

const importantLinks = [
  { name: 'VLE Portal Home', url: 'https://tamilnaducareerservices.tn.gov.in/', primary: true },
  { name: 'Browse Courses', url: 'https://tamilnaducareerservices.tn.gov.in/courses', primary: false },
  { name: 'Official YouTube', url: 'https://www.youtube.com/channel/UCY7sYV3Q8w44gJ1k4_w05eA', primary: false },
];

// Group downloads by unit
const downloadsByUnit = downloads.reduce((acc: any, dl: any) => {
  const unitName = dl.unit || 'General Materials';
  if (!acc[unitName]) acc[unitName] = [];
  acc[unitName].push(dl);
  return acc;
}, {});
---

<Layout title="TN Career Services VLE" description="Access official Virtual Learning Environment materials for TNPSC preparation." active="VLE Material">

  <div class="page-header animate-in">
    <span class="badge badge-green mb-3">Official Resources</span>
    <h1>TN Career Services VLE</h1>
    <p>The Virtual Learning Environment is an initiative by the Department of Employment and Training, Government of Tamil Nadu, for competitive exam aspirants.</p>
  </div>

  <!-- Features -->
  <div class="grid grid-2 mb-8 stagger">
    {vleFeatures.map(f => (
      <div class="card">
        <div class="flex items-center gap-3 mb-3">
          <div style={`width: 40px; height: 40px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, ${f.color} 10%, transparent);`}>
            <svg style={`width: 20px; height: 20px; stroke: ${f.color}; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round;`} viewBox="0 0 24 24" set:html={f.icon} />
          </div>
          <h3 style="font-size: 1rem;">{f.title}</h3>
        </div>
        <p class="text-secondary" style="font-size: 0.875rem; line-height: 1.6;">{f.description}</p>
      </div>
    ))}
  </div>

  <!-- Direct Downloads Hub -->
  <div class="mb-10 animate-in" style="animation-delay: 200ms;">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
      <h2>Direct Downloads Hub</h2>
      <span class="badge badge-accent">Hosted on Cloudflare R2</span>
    </div>
    <p class="text-muted mb-6" style="max-width: 600px; font-size: 0.95rem;">
      Struggling to download from the official portal? We've mirrored the most important VLE study materials here for fast, direct downloading, organized by syllabus unit.
    </p>

    <div class="stack gap-6">
      {Object.entries(downloadsByUnit).map(([unit, items]: [string, any]) => (
        <div class="unit-section">
          <h3 class="mb-4 pb-2" style="font-size: 1.25rem; color: var(--text); border-bottom: 2px solid var(--surface-sunken);">{unit}</h3>
          
          <div class="card" style="padding: 0; overflow: hidden;">
            <div class="flex flex-col">
              {items.map((dl: any, index: number) => (
                <div class="download-row" style={`background: var(--surface); padding: var(--space-3) var(--space-4); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); border-bottom: ${index === items.length - 1 ? 'none' : '1px solid var(--border-subtle)'}; transition: background-color 0.2s ease;`}>
                  
                  <div style="flex: 1; min-width: 0;">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="badge badge-neutral text-mono" style="font-size: 0.65rem;">{dl.exam}</span>
                      <span class="text-muted text-mono" style="font-size: 0.7rem;">{dl.size} {dl.pages ? `• ${dl.pages} pages` : ''}</span>
                    </div>
                    
                    <h4 style="font-size: 1rem; margin: 0; color: var(--text); line-height: 1.4;">{dl.title}</h4>
                    
                    {dl.description && (
                      <p class="text-secondary" style="font-size: 0.85rem; margin-top: 4px; line-height: 1.5;">
                        {dl.description}
                      </p>
                    )}
                  </div>

                  <a href={dl.url} download target="_blank" rel="noopener noreferrer" class="btn btn-accent" style="padding: 0.6rem; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" title="Download PDF">
                    <svg style="width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                  </a>
                  
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Access Links -->
  <div class="card mb-8 animate-in" style="animation-delay: 300ms; text-align: center; padding: var(--space-8);">
    <h2 style="font-size: 1.2rem; margin-bottom: var(--space-2);">Access the Official Portal</h2>
    <p class="text-muted" style="font-size: 0.875rem; margin-bottom: var(--space-6); max-width: 500px; margin-inline: auto;">
      Register on the official VLE portal to unlock additional study materials, mock tests, and previous year papers.
    </p>
    <div class="flex gap-3 justify-center flex-wrap" style="justify-content: center;">
      {importantLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener noreferrer"
           class={link.primary ? 'btn btn-accent' : 'btn btn-outline'}
           style="display: inline-flex; align-items: center; gap: var(--space-2);">
          {link.name}
          <svg style="width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2;" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        </a>
      ))}
    </div>
  </div>

  <!-- Tips -->
  <div class="card animate-in" style="animation-delay: 400ms;">
    <div class="card-header">
      <span class="card-title">How to Use These Materials</span>
    </div>
    <div class="stack gap-3">
      {[
        { label: 'Register', text: 'Create an account on the official portal to unlock all e-content.' },
        { label: 'Supplement', text: 'Use VLE materials alongside Samacheer Kalvi textbooks for comprehensive coverage.' },
        { label: 'Practice', text: 'Regularly attempt mock tests to improve time management and accuracy.' },
        { label: 'Watch', text: 'The TN Career Services YouTube channel posts syllabus breakdowns and tutorials.' },
      ].map((tip, i) => (
        <div class="flex gap-3" style="align-items: flex-start;">
          <span class="text-mono" style="font-size: 0.75rem; font-weight: 700; color: var(--accent); margin-top: 2px; flex-shrink: 0;">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <div style="font-weight: 600; font-size: 0.9rem;">{tip.label}</div>
            <div class="text-secondary" style="font-size: 0.85rem;">{tip.text}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

</Layout>
